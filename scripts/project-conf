#!/usr/bin/env bash
# One project fact, read from the consumer's own tracked declaration:
#
#     project-conf <key> [default]
#
# The file is <consumer>/.cerebro/project.conf, in the shape cerebro#58 §1 specifies:
#
#     key value          one per line, the value running to the END of the line
#     # a comment        everything from a `#' on is a comment, WHEREVER it starts
#
# Because the comment strip runs wherever the `#' appears, A VALUE CAN NEVER CONTAIN `#'. That is
# deliberate - it is what keeps `default_branch main  # for now' from naming a branch "main # for
# now" - and it is stated here rather than left to be discovered.
#
# TRACKED (cb-epr).
# How a project installs itself and what its gate is called are facts EVERY clone needs, so this
# file is tracked (`.gitignore' names the fleet's runtime directories and nothing else;
# `.cerebro/models.conf' is tracked or ignored as the project chooses). An ignored declaration
# vanishes on a fresh clone, and every new machine then silently skips the step - surfacing much
# later as a confusing failure inside somebody's worktree.
#
# It lived at <consumer>/.claude/cerebro-project.conf until cb-epr. A file still sitting there is
# the ONE case this script fails on (exit 2, naming the `mv'): see THIS NEVER FAILS below.
#
# Two keys are worth naming here because their ABSENCE is meaningful rather than merely a default:
#
#   disk_floor_gb  — GB of free disk below which a bead must not start. ABSENT means no disk
#                    preflight runs at all, and prune-worktrees.sh loses its pressure path.
#   retro_dir      — where the fleet's retrospectives live, read by retro-sightings.
#
# THIS NEVER FAILS on absence. A missing file, a missing key and an unreadable file all exit 0 with
# the default, because callers run under `set -euo pipefail' where a non-zero exit for "no such
# key" takes the caller down instead of letting it fall back. Two things DO exit non-zero, and
# neither is a fact about the consumer: a missing <key> argument, which is a programming error in
# the caller; and a declaration left at the retired .claude/ path, which is a migration error - the
# consumer would otherwise run silently on defaults it never declared (cb-epr).
#
# Whichever branch was taken is printed to STDERR, never stdout, the way `launch' says out loud
# which models.conf line it matched: a caller doing `x="$(project-conf install)"' must get the
# value and nothing else, and a step silently skipped is otherwise a mystery three days later.
set -euo pipefail

key="${1:-}"
default="${2:-}"
if [[ -z "$key" ]]; then
  echo "usage: project-conf <key> [default]" >&2
  exit 2
fi

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# --shared, matching how `launch' reads models.conf and how `agent-state' resolves its state
# directory: the fleet's configuration is one answer for the checkout, not one per worktree.
#
# The hint first (cb-ue0): `launch' resolves the roots once and exports them down its process tree,
# and `agent-cli' forks this script on every call, so the fork saved here is saved six times over on
# one session start. It is validated against this very checkout before it is believed - see
# scripts/root-hints.sh - so an inherited variable can only ever skip work, never answer wrongly.
source "$here/root-hints.sh"
root="$(cerebro_hinted_root "$here/.." shared)" \
  || root="$("$here/consumer-root" --shared 2>/dev/null)" \
  || root=""
conf="${root:+$root/.cerebro/project.conf}"

# The migration refusal (cb-epr), before any lookup. Loud rather than a silent fallback: a consumer
# whose declaration is still at the old path would otherwise read as "no declaration at all".
old_conf="${root:+$root/.claude/cerebro-project.conf}"
if [[ -n "$conf" && ! -f "$conf" && -n "$old_conf" && -f "$old_conf" ]]; then
  echo "project-conf: the declaration has moved - run: mv .claude/cerebro-project.conf .cerebro/project.conf" >&2
  exit 2
fi

# The value for $key, or nothing. Two columns, NOT models.conf's three: `read -r k m e' would split
# `install pnpm install --frozen-lockfile' into a command and its arguments, so the value is read
# as one `rest' running to the end of the line.
lookup() {
  local line k rest
  [[ -n "$conf" && -f "$conf" && -r "$conf" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    # This file is TRACKED, unlike models.conf, so it will be edited on Windows checkouts. Strip
    # the carriage return before anything else: it is not in IFS, so `read' leaves it on the tail
    # of the value, and `npm ci\r' and a branch named `main\r' both fail invisibly.
    line="${line%$'\r'}"
    line="${line%%#*}"
    read -r k rest <<<"$line"
    [[ -n "$k" ]] || continue
    if [[ "$k" == "$key" ]]; then
      printf '%s\n' "$rest"
      return 0
    fi
  done < "$conf"
}

value="$(lookup)"
if [[ -n "$value" ]]; then
  echo "project-conf: project.conf -> $key" >&2
  printf '%s\n' "$value"
  exit 0
fi

# Detect, never guess - and only where detection is safe. `prewarm' is deliberately absent from
# this table and always will be: nothing could infer `pnpm --filter @atlantis/browser-core
# build:wasm', and a wrong guess costs minutes in every worktree.
if [[ "$key" == "install" && -n "$root" ]]; then
  for probe in "pnpm-lock.yaml:pnpm install --frozen-lockfile" \
               "package-lock.json:npm ci" \
               "yarn.lock:yarn install --immutable"; do
    lockfile="${probe%%:*}"
    command="${probe#*:}"
    if [[ -f "$root/$lockfile" ]]; then
      echo "project-conf: install detected from $lockfile" >&2
      printf '%s\n' "$command"
      exit 0
    fi
  done
fi

# The gates (ah-qled.7.1). `gate_fast' and `gate_full' are command lines like `install', and the
# fleet refuses to start an implementer without a fast one - so a project that plainly has a gate
# but has not declared one is worth detecting rather than refusing. It is a CONVENIENCE ONLY, and
# it says so on stderr: an agent about to trust a green result should know the harness chose the
# command instead of the project naming it.
if [[ ( "$key" == "gate_fast" || "$key" == "gate_full" ) && -n "$root" ]]; then
  # The script names each gate is looked for under, most specific first. A fast gate is the
  # project's own cheap pass; a full gate is everything it has.
  if [[ "$key" == "gate_fast" ]]; then
    scripts="check:fast check test"
    targets="check test"
  else
    scripts="check test"
    targets="check test"
  fi

  # Which runner, from the lockfile - the same evidence the `install' detection above trusts.
  runner=""
  [[ -f "$root/pnpm-lock.yaml" ]] && runner="pnpm"
  [[ -z "$runner" && -f "$root/yarn.lock" ]] && runner="yarn"
  [[ -z "$runner" && -f "$root/package.json" ]] && runner="npm"

  if [[ -n "$runner" && -f "$root/package.json" ]]; then
    for script in $scripts; do
      # Deliberately crude, and deliberately not a JSON parser: bash 3.2 with builtins is the whole
      # toolbox here, and a false positive is announced rather than silent.
      if grep -q "\"$script\"[[:space:]]*:" "$root/package.json"; then
        echo "project-conf: $key detected from package.json ($script)" >&2
        printf '%s\n' "$runner run $script"
        exit 0
      fi
    done
  fi

  if [[ -f "$root/Makefile" ]]; then
    for target in $targets; do
      if grep -q "^$target:" "$root/Makefile"; then
        echo "project-conf: $key detected from Makefile ($target)" >&2
        printf '%s\n' "make $target"
        exit 0
      fi
    done
  fi

  if [[ -f "$root/Cargo.toml" ]]; then
    echo "project-conf: $key detected from Cargo.toml" >&2
    printf '%s\n' "cargo test"
    exit 0
  fi
fi

if [[ -n "$default" ]]; then
  echo "project-conf: $key unset -> the default" >&2
  printf '%s\n' "$default"
else
  echo "project-conf: $key unset, and no default" >&2
fi
exit 0
