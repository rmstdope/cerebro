#!/usr/bin/env bash
#
# Give a producer's claimed bead to whoever must decide what the producer may not:
#
#     .cerebro/cerebro/scripts/producer-park <Name> <id> <ux|scope> <reason>
#
# A producer designs an unplanned `ux:agreed` bead itself, so this is never for a
# missing build plan. `ux` sends the bead straight back to the UX stage (cb-2cj4):
# the agreed experience is missing something only a designer may decide. `scope`
# parks it in the navigator's `human` queue: the work itself is in question.

set -euo pipefail

usage() {
  echo "usage: producer-park <Name> <id> <ux|scope> <reason>" >&2
  exit 2
}

[[ $# -eq 4 && -n "$1" && -n "$2" && -n "$4" ]] || usage
name="$1"
id="$2"
decision="$3"
reason="$4"

case "$decision" in
  ux|scope) ;;
  *) usage ;;
esac

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Every label this script reads or writes is spelled there, beside the queues that read them, so a
# park cannot leave a label the next queue refuses (cb-q6yb).
source "$script_dir/candidate-label-policy.sh"
root="$("$script_dir/consumer-root" --shared)"

if ! shown="$(bd -C "$root" show "$id" --json)"; then
  exit 1
fi
if ! fields="$(printf '%s' "$shown" \
    | jq -r '(if type == "array" then .[0] else . end) | "\(.status // "")\t\(.assignee // "")"')"; then
  echo "producer-park: bd show $id did not print JSON this script can read" >&2
  exit 1
fi
IFS=$'\t' read -r status assignee <<<"$fields"
if [[ "$status" != "in_progress" || "$assignee" != "$name" ]]; then
  echo "producer-park: $id is not in progress for $name" >&2
  exit 1
fi
if printf '%s' "$shown" \
  | jq -e --arg bugfix "$bugfix_label" \
      '(if type == "array" then .[0] else . end) | (.labels // [] | index($bugfix)) != null' \
  >/dev/null; then
  # The bugfix route never enters UX (`stage-candidates` excludes it), so neither branch here can
  # take a bug anywhere; a product decision on a bug is a `human` hand-back (cb-0elv.5).
  echo "producer-park: $id is a bugfix bead; a bug is handed back through produce-bead's Handing back block, never parked for UX" >&2
  exit 1
fi
if ! printf '%s' "$shown" \
  | jq -e --arg stage "$stage_label" --arg skip "$skip_label" '(if type == "array" then .[0] else . end)
           | ((.labels // [] | index($stage)) != null) or ((.labels // [] | index($skip)) != null)' \
  >/dev/null; then
  echo "producer-park: $id is not producer work (neither ux:agreed nor ux:none)" >&2
  exit 1
fi

if [[ "$decision" == "ux" ]]; then
  # A UX question is the designer's. Every past-UX label comes off so `stage-candidates ux` offers
  # the bead again and `assignable-beads` stops offering it; the note's heading is what
  # `agree-experience` reads a returned piece of work by; nothing is parked for a person.
  # `ux:none` is one of them: a producer may add the UX stop the navigator skipped at filing, never
  # the other way round (cb-uump).
  route_flags_for send_to_ux
  bd --actor "$name" -C "$root" update "$id" \
    "${route_flags[@]}" \
    --append-notes "## Sent back to the UX stage

$reason" \
    --if-assignee "$name" \
    --if-status in_progress
else
  # A scope question is the navigator's: parked in their one queue, with the pause dated.
  paused_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  note="Producer parking for a scope decision: $reason"
  # `human` alone: `needs-ui-decision` is a designer's question, and on a scope park it would keep
  # the fleet view from unparking the bead when its blockers close and make Cerebro offer it to UX.
  route_flags_for park_for_navigator
  bd --actor "$name" -C "$root" update "$id" \
    "${route_flags[@]}" \
    --append-notes "$note" \
    --set-metadata "paused_at=$paused_at" \
    --if-assignee "$name" \
    --if-status in_progress
fi
bd --actor "$name" -C "$root" unclaim "$id" --if-assignee "$name"
bd -C "$root" dolt push
