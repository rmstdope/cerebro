#!/usr/bin/env bash
# Sync cerebro's symlinks when a checkout moved the .claude/cerebro gitlink.
#
# Git passes: $1 previous HEAD, $2 new HEAD, $3 1 for a branch checkout and
# 0 for a file checkout. A file checkout cannot move a gitlink we care about.
set -euo pipefail

[[ "${3:-0}" == "1" ]] || exit 0

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$HOOK_DIR/sync-if-changed.sh" "${1:-}" "${2:-}"
