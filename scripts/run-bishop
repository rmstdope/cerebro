#!/usr/bin/env bash
#
# Runs one sweep of the architect, in a terminal of its own.
#
#     .claude/cerebro/scripts/run-bishop
#
# One session, called Bishop, and **interactive** for the same reason the other role launchers
# are — it needs to report to the navigator. But unlike Xavier, Cerebro, Moira and Psylocke, it does
# not loop: it decides for itself whether this is a daily or a weekly sweep, reads what that sweep
# covers, files a `Refactoring:` bead for each finding that names a cost being paid today, moves its
# watermark, reports, and **ends its own turn** — deliberately, and `agents/architect.md` says why.
# It holds no claim, no lease and no PR, so nothing waits on it between sweeps; a session that lived
# through a second sweep would carry the first sweep's reading in its context, which is exactly the
# rot one-bead-per-session was invented to stop for implementers.
#
# So there is no loop here and no go flag, but there is also no sleep: the navigator starts this
# again — from the fleet view's `s`, or this script directly — whenever they want another read, and
# Bishop works out from its watermark (kept in bd memory, `bishop-watermark`/`bishop-weekly`) how far
# back to look.
#
# The prompt below is the only injection. Without it the session would start and wait for someone to
# say something, which is a poor use of a terminal that was opened precisely to get a sweep moving.

set -euo pipefail

# Every bd call in this session acts as Bishop, not as the machine's git identity, so the beads it
# files and the watermark it moves belong in the audit trail as an agent's, not the navigator's.
export BEADS_ACTOR="Bishop"

# Fable at xhigh effort, deliberately — matching the agent file, and naming both here too means a
# terminal started from a different session still gets them.
#
# Any extra arguments go to `claude` ahead of the prompt, so `.claude/cerebro/scripts/run-bishop --model ...`
# works for a one-off without editing this file.
# ah-cuc: link whatever a submodule bump brought in, so `claude --agent <role>` finds it.
"$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ensure-symlinks"

exec claude \
  --agent architect \
  --name Bishop \
  --model fable \
  --effort xhigh \
  --permission-mode auto \
  "$@" \
  "You are Bishop, the architect. Follow your agent definition. Start now: pull the beads, read
your watermark, decide whether this is a daily or a weekly sweep and say which and over what range,
read what it covers, file a Refactoring bead for each finding that names a cost being paid today,
note the ones already filed, move the watermark, then report and tell me the session is finished."
