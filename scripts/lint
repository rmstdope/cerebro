#!/usr/bin/env bash
#
# This project's advisory lint: the decisions worth guarding, guarded as advisories rather than as
# tests (cb-194).
#
# Tests here assert the behaviour of the code this repository ships - the elisp in `emacs/' and the
# bash in `scripts/'. Prose and configuration are not code: an agent file, a skill file, a
# declaration file. A suite that greps them fails on the day somebody changes their mind rather
# than on the day something breaks, and a decision that reads as a regression is worse than no
# check at all - it was one line in a roster that turned this project's gate red in three places.
#
# So the greps live here instead. Every one of them is a decision somebody made and wrote down;
# when one fires on a change that was deliberate, the answer is to UPDATE THIS FILE in the same
# pull request. It never blocks a merge: the gate prints its output and ignores its status, and
# CI runs it with continue-on-error.
#
# NOT `scripts/lint.sh' and never under `tests/': the gate's suite loop is `tests/*.sh', which
# would run this file as a suite and make its exit 1 a red gate - undoing the whole point.
#
#     scripts/lint [root]
#
# `root' defaults to the repository this script sits in. Exit 0 when clean, 1 when any advisory
# fired, 2 on a usage error.
#
# `set -e' is deliberately OFF: every check must run even after one fires, the way the gate runs
# every suite even after one fails. A lint that stops at the first advisory hides the rest.

set -uo pipefail

# `lint [root]' runs every check below. `lint --plan <file>' runs one check on a plan a planner is
# about to ship: does it quote a bead id into prose an agent reads? It needs no root - the plan is
# the input - so it is parsed first and the root is forced to this repository.
if [[ "${1:-}" == "--plan" ]]; then
  plan="${2:-}"
  if [[ -z "$plan" || $# -ne 2 ]]; then
    echo "usage: scripts/lint --plan <file>" >&2
    exit 2
  fi
  if [[ ! -r "$plan" ]]; then
    echo "lint: cannot read $plan" >&2
    exit 2
  fi
  # Resolve it here, in the caller's directory, because the checks below `cd' into the root: the
  # documented invocation passes a relative path from wherever the planner is sitting, and a
  # relative path re-opened from the root would read no plan at all and report it clean.
  plan="$(cd "$(dirname "$plan")" && pwd)/$(basename "$plan")"
  set -- ""
fi
root="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
if [[ ! -d "$root" ]]; then
  echo "lint: not a directory: $root" >&2
  echo "usage: scripts/lint [root]" >&2
  exit 2
fi
root="$(cd "$root" && pwd)"
cd "$root" || exit 2

status=0

ok() { echo "ok - $1"; }

# An advisory names what was decided and then shows what it found, so the reader can tell a
# deliberate change from a regression without opening this file.
advisory() {
  local what="$1" hits="${2:-}"
  echo "ADVISORY: $what"
  [[ -n "$hits" ]] && sed 's/^/    /' <<<"$hits"
  status=1
}

# Every file an agent session is given, and only those. `docs/cerebro-jobs.md' and
# `docs/decisions.md' are cerebro-side records of which bead decided what: they exist precisely so
# the provenance has somewhere to live that no session carries. `skills/release-notes' is exempt in
# full - its job is teaching someone to write good notes, and a concrete worked example teaches
# better than an abstract one.
prose_files() {
  { find agents skills -name '*.md' ! -path 'skills/release-notes/*'
    echo docs/agent-workflow.md
  } | sort
}

# A bead id from either board this repository's history is written in: the project cerebro was
# extracted from used `ah-', cerebro's own board uses `cb-'. Written once and used by check 1, by
# the guard on the provenance file, and by `--plan', so the three cannot disagree about what an id
# looks like. The boundaries are spelled as character classes rather than `\b': the same string is
# handed to awk, where GNU awk reads `\b' as a backspace and BSD awk does not know it at all.
bead_id_re='(^|[^A-Za-z0-9_-])(ah|cb)-[a-z0-9]{3,}([.][0-9]+)*([^A-Za-z0-9_-]|$)'

# --- the rule table: every pattern rule, run over the tree or over a plan ---
#
# Ten of the numbered checks below held a part of one shape - a forbidden pattern in files whose
# path matches X - and a plan can specify a violation of any of them. Five retrospectives record an
# implementer rewriting a plan's verbatim text after the gate rejected it. So the pattern and its
# destination are named ONCE here, as a row, and two runners read the same row: `tree_rule' greps
# the files the row selects, `plan_rule' runs it over a plan's fenced blocks and blockquotes using
# the destination heuristic below. Adding a sixteenth pattern rule is one `rule' line and is
# available to both walks by construction.
#
#   rule <name> <icase> <pattern> <path-re> <path-exempt-re> <line-exempt-re> <message>
#
#     name           one word, what the advisory and the plan check call it
#     icase          i for case-insensitive, - for exact case; an i rule's pattern is lower-case
#     pattern        an ERE the line must NOT match. No \b: awk has none (see bead_id_re above)
#     path-re        an ERE the repository-relative path must match to be read
#     path-exempt-re an ERE that takes a path back out, or -
#     line-exempt-re an ERE that takes a matching line back out, or -
#     message        the decision, as the advisory states it
#
# A literal dot is `[.]' in every row, never a backslash escape: the same string is read by grep
# and by awk, and the two disagree about some escapes while agreeing about a bracket.

# `--plan' reads only blocks and quotes: a plan's own Context may, and should, cite the beads it
# stands on. A line is "destined for" the last repository path the plan named outside a block - a
# heading, or a sentence naming the file.
plan_rule() {
  local name="$1" icase="$2" re="$3" path_re="$4" path_x="$5" line_x="$6" msg="$7"
  local hits
  # The four patterns reach awk through ENVIRON, never -v: awk escape-processes a -v value, so a
  # backslash in a pattern would be rewritten before it is ever used as a regex.
  hits="$(RULE_RE="$re" RULE_PATH="$path_re" RULE_PATH_X="$path_x" RULE_LINE_X="$line_x" \
          awk -v icase="$icase" '
    BEGIN { re = ENVIRON["RULE_RE"]; path_re = ENVIRON["RULE_PATH"]
            path_x = ENVIRON["RULE_PATH_X"]; line_x = ENVIRON["RULE_LINE_X"]
            dest = ""; fence = 0 }
    function is_dest(p) {
      sub(/^\.claude\/cerebro\//, "", p)
      if (p == "scripts/lint") return 0
      if (p !~ path_re) return 0
      if (path_x != "-" && p ~ path_x) return 0
      return 1
    }
    function check(l,   s) {
      s = (icase == "i") ? tolower(l) : l
      if (s ~ re && (line_x == "-" || l !~ line_x)) printf "%s:%d: %s\n", FILENAME, NR, l
    }
    {
      line = $0
      # A fence opens and closes on a line beginning with three backticks. Inside one, nothing
      # moves the destination.
      if (line ~ /^[[:space:]]*```/) {
        if (fence) { fence = 0 } else { fence = 1; if (is_dest(dest)) check(line) }
        next
      }
      if (fence) { if (is_dest(dest)) check(line); next }
      # A blockquote line is quoted prose too.
      if (line ~ /^[[:space:]]*>/) { if (is_dest(dest)) check(line); next }
      # Outside blocks: the last path-shaped token on the line becomes the destination.
      n = split(line, w, /[[:space:]`(),;]+/)
      for (i = 1; i <= n; i++) {
        t = w[i]
        sub(/:[0-9-]+$/, "", t)
        if (t ~ /^[A-Za-z0-9_.-]+(\/[A-Za-z0-9_.-]+)+$/) dest = t
      }
    }
  ' "$plan")"
  if [[ -n "$hits" ]]; then
    advisory "the plan quotes into $name's files what rule $name forbids: $msg" "$hits"
  fi
}

# Every file a rule may read: the whole tree minus git's own directory, the harness's runtime
# directory, the board, backups - and this file, which spells every pattern it forbids. Computed
# once, repository-relative, sorted. Excluding backups everywhere is deliberate: a committed `*~'
# is not prose anyone ships, and one check used to read them.
all_files=""
tree_files() {
  [[ -n "$all_files" ]] && return 0
  all_files="$(find . \( -name .git -o -name .cerebro -o -name .beads -o -name node_modules \) -prune \
                    -o -type f ! -name '*~' -print | sed 's#^\./##' | grep -vx 'scripts/lint' | sort)"
}

tree_rule() {
  local name="$1" icase="$2" re="$3" path_re="$4" path_x="$5" line_x="$6" msg="$7"
  local files hits iflag=""
  tree_files
  [[ "$icase" == i ]] && iflag="-i"
  # Every pattern goes through -e: a row's exempt pattern may begin with `--', which grep would
  # otherwise read as an option and then match nothing at all, silently.
  files="$(grep -E -e "$path_re" <<<"$all_files" || true)"
  [[ "$path_x" != - && -n "$files" ]] && files="$(grep -vE -e "$path_x" <<<"$files" || true)"
  if [[ -z "$files" ]]; then
    advisory "rule $name reads no file at all - its path pattern has stopped matching"
    return
  fi
  # -H because a rule whose path pattern selects one file would otherwise print no name; -I skips
  # binaries; -- so a path is never read as a flag.
  hits="$(tr '\n' '\0' <<<"$files" | xargs -0 grep -nHI $iflag -E -e "$re" -- 2>/dev/null || true)"
  [[ "$line_x" != - && -n "$hits" ]] && hits="$(grep -vE -e "$line_x" <<<"$hits" || true)"
  if [[ -n "$hits" ]]; then
    advisory "$msg" "$hits"
  else
    ok "rule $name: clean"
  fi
}

rule() {
  if [[ -n "${plan:-}" ]]; then
    plan_rule "$@"
  else
    tree_rule "$@"
  fi
}

# The path pattern for prose an agent session is given, written once; the release-notes skill is
# exempt in full, since a concrete worked example teaches better than an abstract one. AUD is the
# wider tree the audience rules read. The audience word itself is spelled by concatenation so this
# file never matches its own rule - the exemption in both runners covers scripts/lint, and this
# covers the copy a suite lints in a fixture.
P='^(agents|skills)/.*[.]md$|^docs/agent-workflow[.]md$'
RN='^skills/release-notes/'
AUD='^(agents|docs|scripts|tests|skills)/|^README[.]md$'
noun="play""er"
verb="play""ing"

rule bead-id         - "$bead_id_re"  "$P" "$RN" - \
  "bead ids remain in agent prose - a consumer cannot resolve these"
rule decisions-ref   - 'decisions[.]md' "$P" "$RN" - \
  "the provenance file is referenced by prose an agent reads"
rule docs-in-suites  - 'docs/[A-Za-z]' '^tests/|^emacs/cerebro(-test)?[.]el$' '^tests/ci-needed[.]sh$' \
  'docs/agent-workflow[.]md|docs/ui/x[.]html|docs/x[.]md|docs/retrospectives/ah-aao[.]md' \
  "a suite names a docs/ path that scripts/ci-needed lets CI skip"
rule vocabulary      i '(^|[^a-z])(hexe?s?|wasm|faction|hexmapmodel)([^a-z]|$)|[.]rep([^a-z]|$)' \
  "$P" "$RN" - "one game's vocabulary is still teaching the rules"
rule origin-project  i 'atlantis-hud' "$P|^README[.]md$" "$RN" - \
  "the project cerebro was extracted from is still named in prose"
rule origin-elisp    i 'atlantis-hud|runimplementer' '^emacs/cerebro[.]el$' - - \
  "emacs/cerebro.el names one particular consumer"
rule audience-noun   i "$noun" "$AUD" "$RN" - \
  "neutral prose still names the audience as one project's noun"
rule audience-verb   i "$verb" "$AUD" - - \
  "the verb belonging to one project's audience survives"
rule origin-traps    i 'webkit|vite preview|service worker|packages/shared' '^(skills|agents)/' - - \
  "one project's traps are carried in cerebro's prompts; they belong in that project's .cerebro/traps.md"
rule moira-origin    - 'Atlantis HUD' '^agents/user-feedback[.]md$' - - \
  "one consumer's project name still stands in Moira's prose"
rule retired-worktrees - '[.]claude/worktrees' "$P|^scripts/" "$RN" - \
  "the retired worktree path .claude/worktrees/ is named again"
rule work-beads-status - '^[[:space:]]*([.]claude/cerebro/)?scripts/work-beads' "$P" "$RN" \
  '--status|--print-excluded-types' "a work-beads call names no --status"
rule mount-round-trip - 'claude/cerebro" 2>/dev/null && pwd -P' '^scripts/' '^scripts/consumer-root$' - \
  "the mount round trip is spelled outside consumer-root"

if [[ -n "${plan:-}" ]]; then
  if [[ $status -eq 0 ]]; then
    ok "the plan's quoted blocks pass every rule that can be run on a plan"
    echo "lint: plan clean"
  else
    echo "lint: a plan that ships this asks an implementer to write what the lint forbids; fix the plan, not the lint"
  fi
  exit $status
fi

# --- 1. no bead id survives in prose an agent is given, and the provenance lives elsewhere ---
#
# The two greps that were here are now the rules `bead-id' and `decisions-ref' in the table above,
# where a planner can run them too. What is left is the existence of the provenance file itself,
# which is not a pattern and cannot be run on a plan.
fired=0
if [[ ! -f docs/decisions.md ]]; then
  advisory "docs/decisions.md is missing - the ids moved but the evidence went with them"
  fired=1
elif ! grep -qE "$bead_id_re" docs/decisions.md; then
  advisory "docs/decisions.md records no bead id, so nothing was preserved"
  fired=1
fi
((fired)) || ok "docs/decisions.md exists and records the provenance"

# --- 2. one project's vocabulary is not the rules' vocabulary ---
# Now the rule "vocabulary" in the table above.

# --- 3. the project cerebro grew up in is named nowhere a session reads ---
#
# README.md is the front door and is not prose an agent is given, so it gets its own entry;
# emacs/cerebro.el is what `C-h m' shows every user, and `runImplementer.ts' is a file in neither
# repository - a dangling reference implying a Node consumer.
# Now the rules "origin-project" and "origin-elisp" in the table above.

# --- 4. the audience is neutral everywhere but the release notes ---
#
fired=0
# The two greps are now the rules "audience-noun" and "audience-verb" in the table above; what is
# left is what the release-notes skill must say about where its word comes from.
rn="skills/release-notes/SKILL.md"
if [[ ! -f "$rn" ]]; then
  advisory "$rn does not exist"
  fired=1
else
  grep -q "project-conf audience_noun" "$rn" \
    || { advisory "$rn does not tell its reader to read the audience_noun key"; fired=1; }
  grep -qi -- "$noun" "$rn" \
    || { advisory "$rn no longer uses this project's literal word"; fired=1; }
  grep -q '"user"' "$rn" \
    || { advisory "$rn does not state the default when the key is unset"; fired=1; }
  grep -qi "irregular" "$rn" \
    || { advisory "$rn does not state the +s / +'s rule and its irregular-plural limitation"; fired=1; }
fi
((fired)) || ok "release-notes says where its audience word comes from"

# --- 5. the contract between cerebro and a project that uses it ---
fired=0
template="templates/consumer-CLAUDE.md"
if [[ ! -f "$template" ]]; then
  advisory "$template does not exist; the skills require a section cerebro does not ship"
  fired=1
else
  grep -q '^## Four Eye Principle$' "$template" \
    || { advisory "$template has no '## Four Eye Principle' heading - the exact section the skills require"; fired=1; }
  grep -qi "starting point\|meant to be edited\|expected to be edited" "$template" \
    || { advisory "$template must say about itself that it is a starting point to be edited"; fired=1; }
fi

# Line wrapping is prose's business, so the window is the joined text either side of the phrase
# rather than the line it happens to sit on.
bad=""
for f in $(grep -rl "Four Eye Principle" skills/ agents/ CLAUDE.md 2>/dev/null); do
  while IFS= read -r m; do
    echo "$m" | grep -qi "consumer" && continue
    bad+="$f: $m"$'\n'
  done < <(tr '\n' ' ' < "$f" | grep -oE '.{0,200}Four Eye Principle.{0,80}' 2>/dev/null)
done
if [[ -n "$bad" ]]; then
  advisory "every Four Eye Principle reference must say the CONSUMER's root CLAUDE.md" "$bad"
  fired=1
fi

# One project's traps in the prompts is now the rule "origin-traps" in the table above.
for f in skills/implement-bead/SKILL.md skills/plan-bead/SKILL.md; do
  grep -q "traps.md" "$f" 2>/dev/null \
    || { advisory "$f never tells the reader to read the consumer's .cerebro/traps.md"; fired=1; }
done
for phrase in "preview server" "stale lease" "conflicted head"; do
  grep -qi "$phrase" skills/implement-bead/SKILL.md 2>/dev/null \
    || { advisory "implement-bead lost the universal trap about the $phrase"; fired=1; }
done
grep -q "traps.md" agents/architect.md 2>/dev/null \
  || { advisory "agents/architect.md never mentions the consumer's traps file"; fired=1; }
grep -q "138" agents/architect.md 2>/dev/null \
  || { advisory "agents/architect.md must name the 138-of-138 figure so the bar for a proposal is calibrated"; fired=1; }

# This repository is a consumer too, and its root CLAUDE.md is both documents.
for heading in "## Four Eye Principle" "## Work tracking" "## Development practices" \
               "## Where the project declares its facts" "## Commands" \
               "## The agent fleet these files describe" "### Invariants the agent files encode" \
               "## emacs/cerebro.el" "## Gotchas"; do
  grep -qF "$heading" CLAUDE.md 2>/dev/null \
    || { advisory "CLAUDE.md has no '$heading' - the fleet reads it here the way it does in any consumer"; fired=1; }
done
four_eyes="$(awk '/^## Four Eye Principle$/{f=1;next} /^## /{f=0} f' CLAUDE.md 2>/dev/null)"
if [[ "$(grep -c . <<<"$four_eyes")" -lt 3 ]]; then
  advisory "the Four Eye Principle section is empty or nearly so"
  fired=1
elif ! grep -qi "green" <<<"$four_eyes"; then
  advisory "the Four Eye Principle section never says a red check stops a merge"
  fired=1
fi
facts="$(awk '/^## Where the project declares its facts$/{f=1;next} /^## /{f=0} f' CLAUDE.md 2>/dev/null)"
for f in "project.conf" "roster.conf" "traps.md"; do
  grep -q "$f" <<<"$facts" \
    || { advisory "the facts section never names $f"; fired=1; }
done
((fired)) || ok "the consumer contract holds: template, references, traps and this repository's own CLAUDE.md"

# --- 6. Moira's public disclosure, which is the one place cerebro reaches people outside the fleet ---
fired=0
moira="agents/user-feedback.md"
if [[ ! -f "$moira" ]]; then
  advisory "$moira does not exist"
  fired=1
else
  # The prose is wrapped for reading, so sentence assertions are made against a flattened copy: a
  # rule that only holds while a sentence stays on one line breaks on the next reflow.
  flat="$(tr '\n' ' ' < "$moira" | tr -s ' ')"
  # One consumer's project name in Moira's prose is now the rule "moira-origin" above.
  disclosure_count="$(grep -cF '_Written by **Moira**, an AI agent that triages issues for' "$moira")"
  if [[ "$disclosure_count" -lt 3 ]]; then
    advisory "the disclosure: expected it at all three comment sites, found $disclosure_count"
    fired=1
  fi
  grep -qF 'Replying here reaches a human maintainer.' "$moira" \
    || { advisory "the disclosure: the promise that a reply reaches a person is gone"; fired=1; }
  placeholder='_Written by **Moira**, an AI agent that triages issues for {project name}. Replying here reaches a human maintainer._'
  placeholder_count="$(grep -cF "$placeholder" "$moira")"
  [[ "$placeholder_count" -eq "$disclosure_count" ]] \
    || { advisory "the name: $placeholder_count of $disclosure_count disclosure sites read the placeholder"; fired=1; }
  grep -q 'project-conf project_name\|project_conf project_name' "$moira" \
    || { advisory "the name: nothing tells Moira to read project-conf project_name"; fired=1; }
  grep -qF 'triages issues for this project' <<<"$flat" \
    || { advisory "the fallback: 'this project' must be spelled out as it will read to a reporter"; fired=1; }
  fallback_block="$(grep -o 'If no name is declared.\{0,250\}' <<<"$flat")"
  if grep -qi 'warn\|flag it\|tell the navigator\|log it' <<<"$fallback_block"; then
    advisory "the fallback: a warning was added; the navigator chose the silent fallback deliberately"
    fired=1
  fi
  grep -qi 'hard-wrap' "$moira" \
    || { advisory "the wrap rule: the never-hard-wrap rule is gone"; fired=1; }
  if grep -n '"Atlantis" on one line' "$moira" >/dev/null 2>&1; then
    advisory "the wrap rule: the Atlantis/HUD example re-couples the rule to one project"
    fired=1
  fi
  grep -qF '<!-- moira-ack -->' "$moira" || { advisory "the ack marker is gone"; fired=1; }
  grep -qi 'once, ever' "$moira" || { advisory "the ack marker's once-ever rule is gone"; fired=1; }
  grep -qF '<!-- beads-state:' "$moira" || { advisory "the beads-state markers are gone"; fired=1; }
  grep -q 'Adapt the wording' "$moira" || { advisory "the instruction to adapt the wording is gone"; fired=1; }
  grep -qF 'people actually using {project name}' <<<"$flat" \
    || { advisory "the shared sentence must carry both the neutral verb and the project-name placeholder"; fired=1; }
fi
((fired)) || ok "Moira's disclosure survives, and takes the project's name from the consumer"

# --- 7. the bead board stays Dolt-only ---
fired=0
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  ok "the bead board is Dolt-only (skipped: $root is not a git work tree)"
else
  hits="$(git ls-files -- '.beads/*.jsonl')"
  if [[ -n "$hits" ]]; then
    advisory "a JSONL board snapshot is tracked - the board is Dolt-only by decision (cb-4yo)" "$hits"
    fired=1
  fi
  git check-ignore -q .beads/issues.jsonl \
    || { advisory ".beads/issues.jsonl is not git-ignored, so a stray 'bd export' could be committed"; fired=1; }
  git check-ignore -q .beads/events.jsonl \
    || { advisory ".beads/events.jsonl is not git-ignored, so a stray events export could be committed"; fired=1; }
  grep -qF '.beads/*.jsonl' CLAUDE.md 2>/dev/null \
    || { advisory "CLAUDE.md does not state the .beads/*.jsonl decision - the next person re-opens it"; fired=1; }
  ((fired)) || ok "the bead board is Dolt-only: nothing tracked, nothing committable, and it is written down"
fi

# --- 8. every launch site names the declaration it reads ---
fired=0
for f in agents/verifier.md agents/reviewer.md; do
  grep -q 'launch_targets' "$f" 2>/dev/null \
    || { advisory "$f names no way to find out how to start the application"; fired=1; }
  grep -q 'launch_.*_port\|launch_<name>_port' "$f" 2>/dev/null \
    || { advisory "$f names no way to find the port to check"; fired=1; }
done
grep -qE 'port_base' skills/implement-bead/SKILL.md 2>/dev/null \
  || { advisory "implement-bead names no way to find its port block"; fired=1; }
grep -qE 'port_base|port_block_size' docs/agent-workflow.md 2>/dev/null \
  || { advisory "agent-workflow still describes the port blocks as fixed numbers"; fired=1; }
((fired)) || ok "each launch site names the declaration it reads"

# --- 9. no phase drift between the agent files and the fleet view's reference list ---
#
# `agent-state' no longer refuses an unknown word, so this is a drift check rather than a legality
# one: an agent that starts using a new phase and never says so leaves `cerebro--phases' describing
# a fleet that has moved on, and that list is the only prose saying which words belong to which role.
fired=0
used="$(grep -oh -- '--phase [a-z][a-z0-9-]*' agents/*.md skills/*/SKILL.md 2>/dev/null \
        | awk '{print $2}' | sort -u)"
if [[ -z "$used" ]]; then
  advisory "phase drift: found no --phase words at all - the grep has stopped matching"
  fired=1
else
  missing=""
  while IFS= read -r phase; do
    grep -q "\"$phase\"" emacs/cerebro.el 2>/dev/null || missing+="$phase"$'\n'
  done <<<"$used"
  if [[ -n "$missing" ]]; then
    advisory "emacs/cerebro.el: these phases are used by an agent file but missing from cerebro--phases" "$missing"
    fired=1
  fi
fi
phases_block="$(awk '/^\(defconst cerebro--phases/{f=1} f{print} f&&/^  "/{exit}' emacs/cerebro.el 2>/dev/null)"
if [[ -z "$phases_block" ]]; then
  advisory "emacs/cerebro.el: cerebro--phases is gone"
  fired=1
elif [[ "$(grep -o '"[a-z][a-z0-9-]*"' <<<"$phases_block" | wc -l | tr -d ' ')" -eq 0 ]]; then
  advisory "emacs/cerebro.el: cerebro--phases is empty"
  fired=1
fi
((fired)) || ok "every phase a shipped agent uses is in cerebro--phases, which exists and is non-empty"

# --- 10. the gate does not drift from CI ---
#
# What an implementer runs before it opens a pull request and what the pull request is then judged
# by must be the same three commands, or the fleet merges on a gate nobody else runs.
fired=0
runner="tests/gate"
ci=".github/workflows/ci.yml"
byte_compile="emacs --batch -L emacs -f batch-byte-compile emacs/cerebro.el"
ert="emacs --batch -L emacs -l cerebro-test -f ert-run-tests-batch-and-exit"
if [[ ! -f "$runner" ]]; then
  advisory "$runner does not exist"
  fired=1
elif [[ "$runner" == *.sh ]]; then
  advisory "$runner ends in .sh, so the gate would run itself recursively"
  fired=1
else
  for cmd in "$byte_compile" "$ert"; do
    grep -qF "$cmd" "$ci" 2>/dev/null || { advisory "CI no longer runs: $cmd"; fired=1; }
    grep -qF "$cmd" "$runner" || { advisory "$runner does not run what CI runs: $cmd"; fired=1; }
  done
  # The suite loop is one script both callers name (cb-8cn). Grepping for the glob would have gone
  # on passing on CI's *step name* long after the loop itself was gone, which is the drift this
  # check exists to catch.
  suites="bash scripts/suite-runner tests"
  [[ -f scripts/suite-runner ]] || { advisory "scripts/suite-runner does not exist"; fired=1; }
  grep -qF "$suites" "$ci" 2>/dev/null || { advisory "CI no longer runs: $suites"; fired=1; }
  grep -qF "$suites" "$runner" || { advisory "$runner does not run what CI runs: $suites"; fired=1; }
fi
((fired)) || ok "the gate runs exactly what CI runs: byte-compile, ERT, every tests/*.sh through scripts/suite-runner"

# --- 11. the retired worktree path is named nowhere ---
#
# `.claude/worktrees/` is where agent worktrees lived before ah-v82. cb-k6r retired it from the
# janitor and the disk preflight after three beads each had to decide which of two paths a rule
# meant; a script or a role document that names it again is the migration un-finishing itself.
# Now the rule "retired-worktrees" in the table above.

# --- 12. CI's skip list names nothing a suite opens ---
#
# scripts/ci-needed lets a docs-only pull request skip the suites. That is only safe while no suite
# opens a file under docs/ except docs/agent-workflow.md (tests/launch-targets.sh). A new suite
# that starts reading docs/ must either be listed here as a fixture string or move that file off
# the skip list in scripts/ci-needed - in the same pull request.
# The grep over the suites is now the rule "docs-in-suites" in the table above.
fired=0
grep -q 'docs/agent-workflow.md' scripts/ci-needed 2>/dev/null \
  || { advisory "scripts/ci-needed no longer keeps docs/agent-workflow.md on the gated side"; fired=1; }
# ci-needed answers on stdout in $GITHUB_OUTPUT's own shape, and the step appends it there
# unread: no `set +e', no `case $?'. A step that parses the exit status again is the shape that
# turned the first docs-only pull request red (cb-ypx, cb-e33).
if grep -q 'bash scripts/ci-needed' "$ci" 2>/dev/null; then
  grep -qF 'bash scripts/ci-needed >> "$GITHUB_OUTPUT"' "$ci" \
    || { advisory "$ci does not append scripts/ci-needed's stdout to \$GITHUB_OUTPUT"; fired=1; }
  # A NEGATIVE assertion - the advisory fires when the line MATCHES. Do not "fix" the && to ||.
  grep -qE '^ +set \+e$' "$ci" \
    && { advisory "$ci defuses -e around scripts/ci-needed, which no longer answers by exit status"; fired=1; }
fi
# The skip condition is copied onto every gated job because Actions has no way to state it once
# without renaming the checks branch protection requires; this is the one place that says the
# copies agree.
gated="$(grep -c '^ *needs: changes$' "$ci" 2>/dev/null)"
same="$(grep -cF "if: \${{ !cancelled() && needs.changes.outputs.run != 'false' }}" "$ci" 2>/dev/null)"
[[ "$gated" -gt 0 && "$gated" -eq "$same" ]] \
  || { advisory "$ci: $gated jobs need 'changes' but $same carry the agreed skip condition"; fired=1; }
((fired)) || ok "scripts/ci-needed keeps docs/agent-workflow.md gated, the predicate's stdout is the output, and every gated job carries the one skip condition"

# --- 13. every work-beads call names the status it means ---
#
# `work-beads --status' has no default (cb-45f): two beads in a row added an arm to a closed-beads
# query that could only match an open bead, because the status was on no line anyone read. A
# command line in an agent file that runs the script bare will get exit 2 at run time; this says so
# before then. `--print-excluded-types' asks about the script, not the board, and needs no status.
# Now the rule "work-beads-status" in the table above.

# --- 14. the planning path runs the plan check ---
#
# `--plan' above is only a prevention if the planner runs it. The step is one line in the skill's
# ship-the-plan checklist; if that line goes, the check goes silent and the next plan ships an id
# into agent prose the way three plans in a row already have.
fired=0
grep -q -- 'lint --plan' skills/plan-bead/SKILL.md 2>/dev/null \
  || { advisory "skills/plan-bead/SKILL.md never runs scripts/lint --plan before shipping a plan"; fired=1; }
((fired)) || ok "plan-bead runs the plan check before a plan is shipped"

# --- 15. the mount round trip lives in consumer-root and nowhere else ---
#
# "Does <root>/.claude/cerebro resolve to this checkout" was answered by five sites in four
# scripts, three ways, each added by a bead that shipped the wrong answer first (cb-akc).
# consumer-root's mount_resolves_to is the one answer, and --self-mounted / --mount expose it.
# prune-worktrees.sh is not a copy and is not matched here: it compares GIT DIRS, which asks
# "one repository or two" rather than "does the mount resolve back", and the two part company
# for a vendored plain copy at the standard mount. Its own header says so.
# Now the rule "mount-round-trip" in the table above.

if [[ $status -eq 0 ]]; then
  echo "lint: clean"
else
  echo "lint: advisories above are not failures - a deliberate change updates scripts/lint in the same pull request"
fi
exit $status
