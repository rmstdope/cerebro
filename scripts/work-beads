#!/usr/bin/env bash
#
# The one place the harness asks: "which beads are real work, at a status the caller names?" Prints
# a JSON array on stdout,
# so a caller pipes it into `jq` exactly as it pipes `bd list --json` today.
#
#     .claude/cerebro/scripts/work-beads --status <list> [--closed-after <when>]
#     .claude/cerebro/scripts/work-beads --print-excluded-types
#
# It exists because that question was hand-written independently by every reader of closed beads -
# the fleet view's bead panel, Psylocke's work list, Cerebro's delivery counts - and each copy had
# to learn the same three `bd` quirks on its own. The same defect was fixed three times in two days
# (ah-cg1). If you have never been bitten by any of them, here they are:
#
#   1. `bd list` defaults to OPEN beads. A closed-bead query without `--status closed` silently
#      reads zero and looks like a quiet day, or like a first pass - seen live with 118 closed
#      labelled beads in the database. So `--status` is REQUIRED here and has no default: "every
#      caller wants closed beads" was the assumption, and two beads (ah-tjaz, ah-e0kf) each added
#      an arm for an open bead to a query answered from closed ones - dead code nobody saw, because
#      the status was on no line they read. A caller says what it means.
#   2. An `epic` closing is bookkeeping, not delivery. It closes when its last child does, so
#      counting both reports the same work twice.
#   3. `bd set-state <id> <k>=<v>` writes an **event bead** as its audit record: `issue_type:
#      "event"`, closed, carrying the very labels these queries key on. Left in, each pass finds
#      the previous pass's event beads, acts on them, and writes more - a chain that grows one link
#      per pass, forever (ah-9gm). Never label an event bead.
#   4. `bd` answers about the repository it is run in. Every query here passes `-C` with the root
#      from `consumer-root --shared`, because a caller in an agent worktree is not in the checkout
#      the fleet reasons about - and a wrong-root answer is an empty list that reads as a quiet day
#      rather than an error (ah-il8j).
#
# Epics and events are excluded TWICE, on purpose: `--exclude-type epic,event` on the `bd` call
# does the work, and the `jq` guard keeps the answer right under a `bd` whose `--exclude-type` does
# not know `event`. A belt and a brace, because being wrong here is invisible.
#
# It fails LOUDLY - non-zero, a message on stderr, nothing on stdout - when `bd` fails or prints
# something that is not JSON. A reader of this output is deciding what has shipped or what needs
# verifying, and an empty array that really means "the query broke" is the worst possible answer.
#
# Not in scope: Moira's `bd list --external-ref gh-<n> --all` lookup, which is a different question
# (one bead by external ref, across every status), and the fleet view's own `bd list`, which
# deliberately fetches every status with no exclusions and partitions the one list in elisp.

set -euo pipefail

# The issue types that are never work. `--print-excluded-types` prints these so
# `emacs/cerebro-test.el` can hold the panel's own list to this one and stop the two drifting.
excluded_types=("epic" "event")

usage() {
  echo "usage: work-beads --status <list> [--closed-after <when>] | work-beads --print-excluded-types" >&2
  exit 2
}

status=""
closed_after=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --status)
      status="${2:-}"; [[ -n "$status" ]] || usage; shift 2 ;;
    --closed-after)
      closed_after="${2:-}"; [[ -n "$closed_after" ]] || usage; shift 2 ;;
    --print-excluded-types)
      printf '%s\n' "${excluded_types[@]}"; exit 0 ;;
    *)
      echo "work-beads: unknown argument '$1'" >&2
      usage ;;
  esac
done

# No default. Every call site used to be a bare `work-beads | jq ...` and the status that decides
# whether a query can match anything was on none of them: two beads in a row added an arm for an
# OPEN bead to a query this script answered from CLOSED ones, and nobody saw it until review
# (ah-tjaz, ah-e0kf). Naming the status is what makes the call site readable, so it is required.
if [[ -z "$status" ]]; then
  echo "work-beads: --status is required - say which beads you mean, e.g. --status closed" >&2
  usage
fi

excluded_csv="$(IFS=,; echo "${excluded_types[*]}")"

# The shared checkout every worktree has in common - see scripts/consumer-root's header for the two
# roots and why a fleet-wide question needs the shared one. Resolved AFTER the argument loop, so
# `--print-excluded-types`, which answers a question about this script rather than about a database,
# keeps working with no repository at all. The message goes to stderr and stdout stays empty (see
# the header): a caller pipes this stdout into `jq`, so a JSON error object there would be read as
# a list.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$("$script_dir/consumer-root" --shared 2>/dev/null)" || {
  echo "work-beads: not in a git repository, or this copy of cerebro has no consumer" >&2
  exit 1
}

argv=(bd -C "$repo_root" list --status "$status" --exclude-type "$excluded_csv" --json)
[[ -n "$closed_after" ]] && argv=(bd -C "$repo_root" list --status "$status" --closed-after "$closed_after" --exclude-type "$excluded_csv" --json)

if ! raw="$("${argv[@]}")"; then
  echo "work-beads: bd failed: ${argv[*]}" >&2
  exit 1
fi

# The same list again in jq - see the header for why both.
if ! out="$(printf '%s' "$raw" | jq --arg excluded "$excluded_csv" \
      '($excluded | split(",")) as $types | [.[] | select(.issue_type as $t | ($types | index($t)) == null)]' 2>/dev/null)"; then
  echo "work-beads: bd printed something that is not JSON: ${argv[*]}" >&2
  exit 1
fi

printf '%s\n' "$out"
