#!/usr/bin/env bash
#
# Runs every bash suite under one directory, naming each one on stdout BEFORE it starts, several at
# a time.
#
# This is the project's one bash-suite loop: `tests/gate' calls it and so does the `bash-tests' job
# in .github/workflows/ci.yml, which used to carry a second copy of the same `for t in tests/*.sh'
# - and the copy an implementer actually watches was the mute one. Two retrospectives paid for that
# silence: docs/retrospectives/cb-dul.md (a gate run stalled 19 minutes inside one suite and the
# only way to find out which was `ps'; ~25 minutes lost) and docs/retrospectives/ah-il8j.md (the
# loop hit the harness's ten-minute output ceiling and the implementer could not name the slow
# suite at all - "I have no per-suite timings, only the aggregate"). cb-8cn made the loop one
# script, with a test under it.
#
# cb-x05 made it parallel. The suites are independent - every one builds its fixtures under its
# own $work_dir (tests/lib/consumer.sh) and the two that spawn processes scope them by pid and by a
# --settings path under their own fixture - and the bash half of the gate was 185s of mostly
# fork-bound work run one at a time on a ten-core machine (83s after this change). A suite that
# reaches outside its own $work_dir breaks this, so do not write one.
#
# The contract, on stdout:
#
#     -- <path>                       as each suite starts; at most <jobs> names are ahead of their
#                                     results, so a stalled run still names what is in flight
#     ok   <path> (Ns)                as each suite ends - in COMPLETION order, not glob order
#     FAIL <path> (Ns)
#
#     == output of <path> ==          after the LAST suite has ended, once per failing suite, in
#     <its stdout and stderr, verbatim>   glob order
#
# A passing suite's own output is hidden; a failing suite's is replayed in full, so the failure is
# diagnosable without a re-run. The replay is deferred to the end because several suites are
# reporting at once and a multi-line replay printed mid-run would interleave with them. Every suite
# runs even after one fails: a loop that stopped at the first failure would hide the others and the
# implementer would fix them one round trip at a time. Then one summary line - `all suites passed'
# on stdout, or `FAILED: <path> ...' on stderr and exit 1.
#
# A suite that is KILLED rather than exiting - the harness's output ceiling, a `kill' - leaves no
# result behind, and a missing result is reported as a failure with an empty replay. Never a pass.
#
# Every suite's full output is ALSO kept on disk, passing and failing alike, under
# <log dir>/<YYYYmmdd>-<HHMMSS>-<pid>/<suite>.log - `tests/launchers.sh' becomes `launchers.sh.log'.
# The log dir is --log-dir, or `.cerebro/state/suite-logs' relative to the caller's cwd, which is
# already gitignored here and in every consumer; the path this script REPORTS is made absolute
# first (cb-wxr), so the line means the same thing from every working directory. The last 3 runs
# are kept and older ones are
# deleted at the start of a run, so the root never grows; a red run names its directory on stderr,
# as an absolute path (cb-wxr): the line outlives the working directory it was printed from. A
# green run says nothing. cb-kf8: two implementers hit a red gate on the same day and neither
# could say which assertion failed, because the replay lived only in terminal scrollback and the
# re-run - the first thing you do - is what destroyed it. A passing suite's log matters too: a
# flake that passed on this run is exactly the one whose output you need. If the log dir cannot be
# created the run says so on stderr, keeps the logs in its temp directory for that run only, and
# carries on - logging is a convenience and must never be the reason a green gate is red.
#
# <path> is the glob result as-is, so `suite-runner tests' prints `tests/agent-alive.sh'.
#
# Under GitHub Actions ($GITHUB_ACTIONS set, which GitHub sets on every job) each failing suite's
# replay is wrapped in ::group::/::endgroup:: and followed by ::error. The live --/ok/FAIL lines
# carry no annotation: they interleave, and a group cannot span interleaved output. So a green run
# under CI has no groups at all - the per-suite timing lines are what the log keeps.
#
# Exit 0 every suite passed, 1 any suite failed, 2 a usage error (a bad --jobs, a --log-dir with no
# value, no directory, more
# than one, or a path that is not a directory) - one line on stderr and nothing run.
#
# The caller's working directory is left alone: `tests/gate' cd's to the repository root first, and
# the glob strings printed here are relative to wherever the caller stood.
#
# NOT `scripts/suite-runner.sh'. Nothing under scripts/ is globbed as a suite, but the name follows
# tests/gate and scripts/ci-needed - bare names whose header says what they are. And
# NOT `scripts/run-suites' either: `scripts/run-*' is the retired launcher-shim namespace that
# tests/launchers.sh and tests/consumer-fixture.sh both guard (ah-qled.5.3), and a script that is
# not a launcher has no business in it.
#
#     scripts/suite-runner [--jobs N] [--log-dir DIR] <dir>

# NOT `set -e': a failing suite is an answer, and every suite must still run after one fails.
set -uo pipefail

usage="usage: suite-runner [--jobs N] [--log-dir DIR] <dir>"

jobs=""
log_dir=""
keep_runs=3                          # how many runs of evidence survive under the log root
while [[ $# -gt 0 ]]; do
  case "${1:-}" in
    --jobs)
      jobs="${2:-}"
      [[ "$jobs" =~ ^[1-9][0-9]*$ ]] || { echo "$usage" >&2; exit 2; }
      shift 2 ;;
    --log-dir)
      log_dir="${2:-}"
      [[ -n "$log_dir" ]] || { echo "$usage" >&2; exit 2; }
      shift 2 ;;
    *) break ;;
  esac
done

# Relative on purpose: `tests/gate' and CI both cd to the repository root first, and a consumer
# running `.claude/cerebro/scripts/suite-runner tests' from its own root gets its own log root.
[[ -n "$log_dir" ]] || log_dir=".cerebro/state/suite-logs"

# Absolute from here on (cb-wxr). The default above is relative on purpose - it is what gives each
# consumer its own log root - but the path this script REPORTS has to mean the same thing from
# every working directory, and the one that gets reported is the one a reader is standing somewhere
# else when they read. An implementer runs the gate in .cerebro/worktrees/<Name>; the line survives
# the run and the cwd does not. cb-azi lost a flake's only log to exactly that.
#
# A string join rather than `cd "$log_dir" && pwd': $PWD is always set by bash, the join cannot
# fail, and there is therefore no failure path that could leave $log_dir empty and print a run
# directory with nothing after the last slash. `realpath' and `readlink -f' are not options - the
# gate runs on the bash 3.2 and the coreutils macOS ships. The logical path is deliberate too: it
# is the spelling the reader recognises, and `pwd -P' would rewrite a symlinked checkout into one
# they have never seen.
case "$log_dir" in
  /*) ;;
   *) log_dir="$PWD/$log_dir" ;;
esac

# The protected directory (cb-xhu.1): the fleet's own append-only logs, which no suite may write.
# `scripts/jsonl-log.sh' refuses a write here and records it; this is the only thing that turns the
# guard on, and the block at the end of this file is what makes a recorded attempt a red run.
#
# `${VAR+set}' rather than `${VAR:-}': an explicitly EMPTY value means "guard off" and must not be
# overwritten by the computed one - otherwise the runner's own suite could not test the off case
# without deleting `consumer-root'. Outside a consumer that resolution fails, the variable stays
# empty and the guard is off, which is right: there is nothing there to protect. One fork per run.
if [[ -z "${CEREBRO_PROTECTED_STATE_DIR+set}" ]]; then
  protected_root="$("$(dirname "${BASH_SOURCE[0]}")/consumer-root" --shared 2>/dev/null || true)"
  [[ -z "$protected_root" ]] || CEREBRO_PROTECTED_STATE_DIR="$protected_root/.cerebro/state"
fi
export CEREBRO_PROTECTED_STATE_DIR="${CEREBRO_PROTECTED_STATE_DIR:-}"

[[ $# -eq 1 ]] || { echo "$usage" >&2; exit 2; }
dir="$1"
[[ -d "$dir" ]] || { echo "suite-runner: not a directory: $dir" >&2; exit 2; }

# One per online processor by default. `getconf _NPROCESSORS_ONLN' answers on both macOS and
# Linux; `nproc' is Linux-only and `sysctl -n hw.ncpu' macOS-only, and the gate runs on both.
[[ -n "$jobs" ]] || jobs="$(getconf _NPROCESSORS_ONLN 2>/dev/null || true)"
[[ "$jobs" =~ ^[1-9][0-9]*$ ]] || jobs=1

annotate=0
[[ -n "${GITHUB_ACTIONS:-}" ]] && annotate=1

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# The durable per-run log directory (cb-kf8). Deliberately NOT covered by the trap above: surviving
# the run is the whole point. `set -e' is off here, so mkdir's status is tested rather than
# assumed - a log root that cannot be created falls back to $tmp and never turns a green gate red.
durable=1
run_dir="$log_dir/$(date +%Y%m%d-%H%M%S)-$$"
if ! mkdir -p "$run_dir" 2>/dev/null; then
  echo "suite-runner: cannot write logs to $log_dir; keeping them in $tmp for this run only" >&2
  durable=0
  run_dir="$tmp"
fi

# Prune at the start, over the OTHER runs only, so the root never holds more than $keep_runs
# between runs. The glob is narrow on purpose: anything in there this script did not create is left
# alone. A string rather than an array - "${arr[@]}" on an empty array is an unbound-variable error
# under `set -u' in bash 3.2, and the list is empty on the first run.
# `head -n -3' would have been shorter and is GNU-only: macOS rejects a negative count.
#
# NEVER this run's own directory (cb-1h8). The glob orders by name, and the name is
# <YYYYmmdd>-<HHMMSS>-<pid>: two runs inside one second are ordered by pid as a STRING, where
# 10000 sorts before 9999. A run that sorted ahead of $keep_runs siblings used to delete the
# directory it was about to write every suite's log into, and then fail all of them with
# "No such file or directory" - read once as a timing flake, at a gate cycle and a baseline run
# (docs/retrospectives/cb-4z6.1.md). Keeping $keep_runs-1 OTHERS leaves the same three runs in
# the root as before.
if ((durable)); then
  this_run="${run_dir##*/}"
  keep_others=$((keep_runs - 1))
  names=""
  n_runs=0
  for d in "$log_dir"/[0-9]*-[0-9]*-[0-9]*; do
    [[ -d "$d" ]] || continue
    [[ "${d##*/}" != "$this_run" ]] || continue
    names="$names"$'\n'"${d##*/}"
    n_runs=$((n_runs+1))
  done
  if [[ $n_runs -gt $keep_others ]]; then
    drop=$((n_runs - keep_others))
    while IFS= read -r nm; do
      [[ -n "$nm" ]] || continue
      [[ $drop -gt 0 ]] || break
      rm -rf "$log_dir/$nm"
      drop=$((drop-1))
    done <<<"$names"
  fi
fi

# Where `scripts/jsonl-log.sh' records a refused write, one `<suite>\t<path>' line each. Under
# $tmp, which the EXIT trap removes: it is read at the summary below and is not evidence anything
# later needs, so it deliberately does NOT go under $run_dir.
export CEREBRO_PROTECTED_STATE_REPORT="$tmp/protected-writes"

# A token pipe as the semaphore. bash 3.2 - what macOS ships and what the gate runs on locally -
# has no `wait -n', and running batches of N with a `wait' between them would idle every core but
# one while the slowest suite of a batch finished. Each job takes a token before it starts and puts
# it back when it ends; `read' on the fifo blocks until one is there. `exec 3<>' opens it
# read-write in one step, so neither end blocks on open.
mkfifo "$tmp/tokens"
exec 3<>"$tmp/tokens"
i=0
while [[ $i -lt $jobs ]]; do echo >&3; i=$((i+1)); done

# Runs one suite and reports it, writing its output and result to files the parent reads afterwards.
# The slot is the suite's glob position, so the parent walks the same order without parsing names.
# It runs in a background subshell, so SECONDS and the locals are its own; every line it prints is
# one short write, which is what keeps two jobs ending at the same moment from splitting a line.
run_one() {
  local t="$1" slot="$2" rc
  export CEREBRO_SUITE_NAME="$t"     # what a refused write is recorded against
  echo "-- $t"
  SECONDS=0
  bash "$t" >"$run_dir/${t##*/}.log" 2>&1
  rc=$?
  echo "$rc" >"$tmp/$slot.rc"
  if [[ $rc -eq 0 ]]; then echo "ok   $t (${SECONDS}s)"; else echo "FAIL $t (${SECONDS}s)"; fi
  echo >&3                           # the token back
}

# A string, not an array: "${arr[@]}" on an empty array is an unbound-variable error under `set -u'
# in bash 3.2, which is what macOS ships and what the gate runs on locally.
paths=""
n=0
for t in "$dir"/*.sh; do
  [[ -e "$t" ]] || continue          # no suites at all: the glob stays literal
  paths="$paths"$'\n'"$t"
  read -r -u 3 _                     # blocks until a slot is free
  run_one "$t" "$n" &
  n=$((n+1))
done
wait

failed=""
i=0
while IFS= read -r t; do
  [[ -n "$t" ]] || continue
  # A killed suite left no .rc file; `cat' of a missing file prints nothing, which is not 0.
  if [[ "$(cat "$tmp/$i.rc" 2>/dev/null)" != 0 ]]; then
    failed="$failed $t"
    ((annotate)) && echo "::group::$t"
    echo "== output of $t =="
    cat "$run_dir/${t##*/}.log" 2>/dev/null
    ((annotate)) && { echo "::endgroup::"; echo "::error file=$t::$t failed"; }
  fi
  i=$((i+1))
done <<<"$paths"

# A recorded write into the fleet's live logs is a red run on its own (cb-xhu.1) - the write was
# already refused, and the point of the block is that the suite is named rather than the breakage
# being found weeks later in a log the navigator is sent to. `set -e' is off here, so nothing is
# assumed about the report existing.
violations=""
if [[ -s "$CEREBRO_PROTECTED_STATE_REPORT" ]]; then
  violations="$(sort -u "$CEREBRO_PROTECTED_STATE_REPORT" 2>/dev/null)"
fi
if [[ -n "$violations" ]]; then
  echo "suite-runner: these suites wrote to the fleet's live logs under $CEREBRO_PROTECTED_STATE_DIR:" >&2
  while IFS="$(printf '\t')" read -r vs vp; do
    [[ -n "$vs" ]] || continue
    echo "  $vs -> $vp" >&2
  done <<<"$violations"
  echo "Every suite builds its fixtures under its own \$work_dir (tests/lib/consumer.sh); the write was refused, and the run is red." >&2
fi

if [[ -n "$failed" ]]; then
  echo "FAILED:$failed" >&2
  ((durable)) && echo "logs kept (last $keep_runs runs): $run_dir" >&2
  exit 1
fi
[[ -z "$violations" ]] || exit 1
echo "all suites passed"
