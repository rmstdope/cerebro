#!/usr/bin/env bash
# Classify changed repository-relative paths using the consumer's declared `rust_paths` regex.
# Consumers without a Rust declaration have no Cargo workload; diagnostics go to stderr.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
usage() { echo "usage: build-workload --classify <path>..." >&2; exit 2; }
[ "$#" -ge 2 ] && [ "$1" = --classify ] || usage
shift
pattern="$("$here/project-conf" rust_paths 2>/dev/null)" || pattern=""
[ -n "$pattern" ] || {
  echo "build-workload: no rust_paths in .cerebro/project.conf - classifying as non-rust." >&2
  echo non-rust
  exit 0
}
if grep -Eq "$pattern" <<<""; then
  :
else
  grep_status=$?
  [ "$grep_status" -eq 1 ] || {
    echo "build-workload: invalid rust_paths regex in .cerebro/project.conf." >&2
    exit 3
  }
fi
for path in "$@"; do
  if grep -Eq "$pattern" <<<"$path"; then
    echo "build-workload: $path matches $pattern" >&2
    echo rust
    exit 0
  fi
done
echo "build-workload: no paths match $pattern" >&2
echo non-rust
