#!/usr/bin/env bash
#
# Runs the orchestrator, in a terminal of its own.
#
#     .claude/cerebro/scripts/run-orchestrator
#
# One session, called Cerebro, and interactive — like `run-planner` and unlike `run-implementer`.
# There is no loop and no flag around it: Cerebro is the thing that *writes* the flags, and it takes
# its instructions from the navigator sitting in front of it.
#
# It owns no work. It sweeps the worktrees and the claims, watches that a planner and at least two
# implementers are up, reports what has shipped, and takes an implementer down by touching
# `.claude/agents-state/<name>.stop`. It cannot put one to work: starting an implementer means
# starting a session, and every session is a terminal the navigator opens or a name they press `s`
# on in the fleet view. (There was a `.go` flag for that once. It is retired: a running implementer
# is a working one.)
#
# The prompt below is the only injection, and it asks for the startup sequence in
# `.claude/agents/orchestrator.md` rather than restating it: a second copy here would drift from the
# first the next time either changes.

set -euo pipefail

# Every bd call in this session acts as Cerebro, not as the machine's git identity. Cerebro claims
# nothing, but its writes (labels, closes, reopens) belong in the audit trail as an agent's, not the
# navigator's.
export BEADS_ACTOR="Cerebro"

# Fable at medium effort, deliberately. Cerebro sweeps, counts and reports - it reads tools and
# relays what they say, and none of that needs a larger model or heavier reasoning. The agent file
# says the same; naming both here too means a terminal started from a different session still gets
# them.
#
# `--model`/`--effort` come before "$@", so `.claude/cerebro/scripts/run-orchestrator --model opus` still overrides
# them for a one-off without editing this file.
exec claude \
  --agent orchestrator \
  --name Cerebro \
  --model fable \
  --effort medium \
  --permission-mode auto \
  "$@" \
  "You are Cerebro. Follow your instructions, starting with the startup sequence: sweep the
worktrees, sweep the claims, count the fleet, and read both the queue and today's deliveries. Then
greet me with what you swept, who is up, what is waiting and what has shipped today. Put nobody to
work until I ask."
