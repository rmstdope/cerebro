{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "[ -n \"$CEREBRO_SCRIPTS\" ] && \"$CEREBRO_SCRIPTS/agent-asking\" begin || true", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "[ -n \"$CEREBRO_SCRIPTS\" ] && \"$CEREBRO_SCRIPTS/agent-asking\" end || true", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "[ -n \"$CEREBRO_SCRIPTS\" ] && \"$CEREBRO_SCRIPTS/agent-asking\" end || true", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "[ -n \"$CEREBRO_SCRIPTS\" ] && \"$CEREBRO_SCRIPTS/agent-turn\" ended || true", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "[ -n \"$CEREBRO_SCRIPTS\" ] && \"$CEREBRO_SCRIPTS/agent-turn\" resumed || true", "timeout": 10 }
        ]
      }
    ]
  }
}
