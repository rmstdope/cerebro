# Compiled
*.elc

# Packaging
.cask/
.eask/
.eldev/
.keg/

# Built distribution
dist/

# Backup files
*~

# Undo-tree save-files
*.~undo-tree

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Claude Code's own directory. This repository is a consumer of itself (cb-i3l.1), so the same rule
# every consumer follows applies here: everything under .claude is local machine state EXCEPT what
# the fleet needs every clone to have — the mount, the discovery links the sync writes, the shared
# settings, and this project's own declaration of its facts.
.claude/*
!.claude/cerebro
!.claude/skills/
!.claude/agents/
!.claude/settings.json
!.claude/cerebro-project.conf
