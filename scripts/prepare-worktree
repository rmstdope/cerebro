#!/usr/bin/env bash
#
# Prepares one worktree of the consumer repository, the one step every role that needs a tree
# of its own was writing out by hand and getting wrong the same way: `git worktree add` does not
# initialise the `.claude/cerebro` submodule, so the tree it produces has no scripts under
# .claude/cerebro until something runs `git submodule update --init --recursive` - five
# implementers hit exactly that (docs/retrospectives/ah-4ao.md and friends, in the consumer repo)
# before anyone gave the step an owner. This script is that owner: implement-bead and
# agents/verifier.md both call it instead of copying the recipe.
#
# usage: prepare-worktree --path <dir> [--branch <name>] [--from <ref>] [--prewarm] [--dry-run]
#
#   --path <dir>    where the worktree goes, relative to the consumer root or an absolute path
#                    under it. Required. Must resolve under <consumer>/.cerebro/worktrees/ - tools
#                    resolve their configuration by walking up from where they are run, so a
#                    worktree outside the repository silently gets its own empty configuration
#                    instead of the project's (`bd`'s bead database and cargo's build directory are
#                    two that have cost time here).
#   --branch <name>  create a fresh worktree on a new branch (an implementer's own tree). <dir>
#                    must not already exist - reusing another bead's tree is how work gets lost.
#   (no --branch)    create, or reuse, the one detached, resettable tree (Psylocke's). Missing:
#                    created detached. Present and detached: fetched, hard-reset and cleaned to
#                    <ref>. Present and on a branch: refused, naming the branch, tree untouched -
#                    a `reset --hard` here would destroy whatever that branch is holding.
#   --from <ref>     what to branch from, or reset to. Defaults to origin/<the consumer's default
#                    branch>, as scripts/default-branch resolves it.
#   --prewarm        also run the project's `prewarm' command inside the tree, after everything
#                    else below - whatever build a project wants warmed before its heavier suites
#                    run. Most beads never need it, so this stays a flag rather than always-on
#                    cost, and with no `prewarm' declared it is a no-op with one line on stderr
#                    rather than an error: a consumer with nothing to prewarm has made no mistake.
#                    `--with-wasm' is the old spelling, kept as a working alias.
#   --dry-run        print the commands that would run, run none of them, and still print the path
#                    and sha. What lets the commands be asserted without owning them, and lets an
#                    agent say what it is about to do in a tree it does not own.
#
# Every check this script owns exits 2 with one line on stderr naming what is wrong. In both
# modes, once the tree exists, it always then:
#   1. git -C <path> submodule update --init --recursive   - the missing line this bead is about.
#   2. whatever the project declared as `install' (a whitespace-tokenized argument vector) or
#      `install_shell' (an explicit Bash fragment), or nothing if it declared neither. Only
#      `install' can be detected: most repositories have nothing to install into a fresh tree, and
#      that must be a no-op rather than a failure.
#   3. --prewarm only: whatever the project declared as `prewarm'. Never inferred.
# and finally prints, on stdout, the tree's path and its current short sha - the sha is what a
# verification is supposed to say out loud, and an implementer wants to know what it branched
# from. This script never `cd`s its caller; the path it prints is for the caller's own `cd`.
set -euo pipefail

path=""
branch=""
from_ref=""            # resolved below, once script_dir is known; an explicit --from still wins
prewarm_wanted=0
dry_run=0

usage() {
  echo "usage: prepare-worktree --path <dir> [--branch <name>] [--from <ref>] [--prewarm] [--dry-run]" >&2
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --path)
      [[ $# -ge 2 ]] || usage
      path="$2"; shift 2 ;;
    --branch)
      [[ $# -ge 2 ]] || usage
      branch="$2"; shift 2 ;;
    --from)
      [[ $# -ge 2 ]] || usage
      from_ref="$2"; shift 2 ;;
    --prewarm|--with-wasm)
      # `--with-wasm' was this flag's first name, back when the only thing anyone prewarmed was
      # one repository's wasm bundle. Kept as an alias so nothing in flight breaks.
      prewarm_wanted=1; shift ;;
    --dry-run)
      dry_run=1; shift ;;
    *)
      usage ;;
  esac
done

if [[ -z "$path" ]]; then
  usage
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
consumer="$("$script_dir/consumer-root")"

# The branch is resolved rather than assumed (ah-qled.3): this script's hardcoded `origin/main` was
# the loud failure of the three - two unguarded fetches under `set -euo pipefail`, so on a consumer
# whose branch is `trunk` worktree creation aborted and no bead could be started at all.
default_branch="$("$script_dir/default-branch" 2>/dev/null)" || default_branch=""
[[ -n "$default_branch" ]] || default_branch="main"
[[ -n "$from_ref" ]] || from_ref="origin/$default_branch"

# Normalise to a path relative to the consumer root, without requiring it to exist yet - a
# fresh --branch tree's parent directory may not either. Accept either form on input.
case "$path" in
  /*)
    case "$path" in
      "$consumer"/.cerebro/worktrees/*) rel_path="${path#"$consumer"/}" ;;
      *) rel_path="" ;;
    esac
    ;;
  .cerebro/worktrees/*) rel_path="$path" ;;
  *) rel_path="" ;;
esac

if [[ -z "$rel_path" ]]; then
  echo "prepare-worktree: $path is not under .cerebro/worktrees/ - worktrees live there, never elsewhere" >&2
  exit 2
fi

abs_path="$consumer/$rel_path"

git -C "$consumer" fetch origin "$default_branch" >&2

# Every mutation below is behind `dry_run', in the same shape the install and prewarm steps already
# use (ah-1rls). The CHECKS are not: they are reads, and reporting what a real run would refuse is
# most of what a dry run is for - one that agrees with everything is worse than one that mutates,
# because it looks fine.
if [[ -n "$branch" ]]; then
  if [[ -e "$abs_path" ]]; then
    echo "prepare-worktree: $rel_path already exists - refusing to reuse it for a new branch (pick a different --path or remove the tree first)" >&2
    exit 2
  fi
  if [[ "$dry_run" -eq 1 ]]; then
    echo "prepare-worktree: would run: git -C $consumer worktree add -b $branch $abs_path $from_ref" >&2
  else
    git -C "$consumer" worktree add -b "$branch" "$abs_path" "$from_ref" >&2
  fi
else
  if [[ ! -e "$abs_path" ]]; then
    if [[ "$dry_run" -eq 1 ]]; then
      echo "prepare-worktree: would run: git -C $consumer worktree add --detach $abs_path $from_ref" >&2
    else
      git -C "$consumer" worktree add --detach "$abs_path" "$from_ref" >&2
    fi
  else
    if git -C "$abs_path" symbolic-ref -q HEAD >/dev/null; then
      held_branch="$(git -C "$abs_path" symbolic-ref --short HEAD)"
      echo "prepare-worktree: $rel_path is on branch '$held_branch', not detached - refusing to reset a tree that may hold work" >&2
      exit 2
    fi
    if [[ "$dry_run" -eq 1 ]]; then
      echo "prepare-worktree: would run: git -C $abs_path fetch origin $default_branch" >&2
      echo "prepare-worktree: would run: git -C $abs_path reset --hard $from_ref" >&2
      echo "prepare-worktree: would run: git -C $abs_path clean -fd" >&2
    else
      git -C "$abs_path" fetch origin "$default_branch" >&2
      git -C "$abs_path" reset --hard "$from_ref" >&2
      git -C "$abs_path" clean -fd >&2
    fi
  fi
fi

if [[ "$dry_run" -eq 1 ]]; then
  echo "prepare-worktree: would run: git -C $abs_path submodule update --init --recursive" >&2
else
  git -C "$abs_path" submodule update --init --recursive >&2
fi

# What runs inside the tree is what the project declared, never what this script assumes. Absent
# is a NO-OP, not a failure: most repositories have nothing to install into a fresh worktree, and
# under `set -euo pipefail' an assumed `pnpm install' took the whole script down before it could
# print the path its caller was waiting for. `prewarm' is never detected - project-conf says why.
install_cmd="$("$script_dir/project-conf" install 2>/dev/null)"
install_shell_cmd="$("$script_dir/project-conf" install_shell 2>/dev/null)"
prewarm_cmd="$("$script_dir/project-conf" prewarm 2>/dev/null)"

# `project-conf install' may infer a package-manager command. A declared `install_shell' replaces
# that inference, but not an explicitly declared `install', which remains a configuration error.
install_is_declared=0
conf="$consumer/.cerebro/project.conf"
if [[ -f "$conf" && -r "$conf" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    line="${line%%#*}"
    read -r key value <<<"$line"
    if [[ "$key" == "install" && -n "$value" ]]; then
      install_is_declared=1
      break
    fi
  done < "$conf"
fi

# `install' is deliberately limited to normal whitespace tokenization. Its values are command
# vectors, not shell source: embedded quotes remain unsupported, but glob expansion, operators,
# redirects, and other shell syntax cannot change what runs. `install_shell' is the explicit,
# mutually exclusive opt-in for a command fragment that needs Bash syntax.
if [[ "$install_is_declared" -eq 1 && -n "$install_shell_cmd" ]]; then
  echo "prepare-worktree: install and install_shell cannot both be declared; choose one execution contract" >&2
  exit 2
elif [[ -n "$install_shell_cmd" ]]; then
  if [[ "$dry_run" -eq 1 ]]; then
    echo "prepare-worktree: would install with shell: $install_shell_cmd" >&2
  else
    (cd "$abs_path" && bash -euo pipefail -c "$install_shell_cmd" >&2)
  fi
elif [[ -n "$install_cmd" ]]; then
  read -r -a install_argv <<<"$install_cmd"
  if [[ "$dry_run" -eq 1 ]]; then
    echo "prepare-worktree: would install with: $install_cmd" >&2
  else
    (cd "$abs_path" && "${install_argv[@]}" >&2)
  fi
else
  echo "prepare-worktree: no install declared or detected - installing nothing" >&2
fi

if [[ "$prewarm_wanted" -eq 1 ]]; then
  if [[ -n "$prewarm_cmd" ]]; then
    if [[ "$dry_run" -eq 1 ]]; then
      echo "prepare-worktree: would prewarm with: $prewarm_cmd" >&2
    else
      (cd "$abs_path" && $prewarm_cmd >&2)
    fi
  else
    echo "prepare-worktree: no prewarm declared - prewarming nothing" >&2
  fi
fi

# The path-and-sha line is the contract every caller parses, so it survives a dry run - but under
# --dry-run there may be no tree to read a HEAD from, so the sha comes from the ref instead. It is
# the sha the tree WOULD be at: for a fresh tree what it would be created at, and for the reuse path
# what the reset it was just told about would leave it holding.
if [[ "$dry_run" -eq 1 ]]; then
  sha="$(git -C "$consumer" rev-parse --short "$from_ref")"
else
  sha="$(git -C "$abs_path" rev-parse --short HEAD)"
fi
printf '%s %s\n' "$abs_path" "$sha"
