#!/usr/bin/env bash
#
# The one place the harness answers: "which beads may a producer be given?" - UX-agreed, or filed
# as touching nothing a person sees. Prints a JSON array
# of {id, priority} on stdout, sorted by priority ascending then by id.
#
#     .cerebro/cerebro/scripts/assignable-beads
#
# Its two callers are `scripts/assign-bead`,
# which refuses a bead that is not on this list, and the fleet view's work reader
# (`readers::read_assignable`), which picks the bead a standby producer is started on - so the
# view and the claim cannot disagree about what a producer may take.
#
# Why `bd ready` and not `bd list`: it is exactly the producer pickup, and it hides
# a bead with an open blocker, which the view's own `bd list --brief` read cannot tell. `-n 0` is
# unlimited; the default is 100.
#
# `--unassigned` because `bd ready` does not filter on assignee: a planning agent that crashed
# between filing its plan and clearing its assignee would otherwise leave a planned bead assigned to
# a session that has ended, and a builder handed it would build what a planner still holds
# (cb-10d.2.2).
#
# It fails LOUDLY - non-zero, a message on stderr, nothing on stdout - when `bd` fails or prints
# something this script cannot read. An empty array that meant "the query broke" would tell the view
# there is nothing to build.

set -euo pipefail

if [[ $# -ne 0 ]]; then
  echo "usage: assignable-beads" >&2
  exit 2
fi

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$("$script_dir/consumer-root" --shared)"

# Captured before the pipe, so a failure leaves stdout empty (see `scripts/plan-candidates`).
#
# `planned` is NOT excluded at `bd`. A producer adds it to its own bead while it holds the claim, so
# an unclaimed planned bead is one of two things: a bead `reopen-failed --fault build` gave back -
# the design was fine, the build was not, and it keeps `planned` with `verification:failed` beside
# it - or a plan nobody is building. The first is rework a producer takes; the second is not
# offered (cb-gc45). The `jq` below tells them apart, which `bd ready`'s label flags cannot.
#
# Nor is the stage label asked of `bd`: EITHER `ux:agreed` (a designer agreed the experience) OR
# `ux:none` (the navigator said at filing that nothing a person sees changes, cb-uump) admits a
# bead, and `bd ready --label` takes one. `scripts/stage-candidates --print-stage-label` and
# `--print-skip-label` are where the two words are declared; this script repeats them because it
# runs on every fleet-view tick and a second process per tick is not affordable.
if ! raw="$(bd --readonly -C "$root" ready --exclude-label human \
        --exclude-label verdict:stale --exclude-label bugfix \
        --exclude-type epic --unassigned --json --brief -n 0)"; then
  echo "assignable-beads: bd ready failed - cannot list the assignable beads" >&2
  exit 1
fi

if ! out="$(printf '%s' "$raw" | jq '[ .[]
      | select(((.labels // []) | index("ux:agreed")) or ((.labels // []) | index("ux:none")))
      | select(((.labels // []) | index("planned") | not)
               or ((.labels // []) | index("verification:failed")))
      | {id, priority} ] | sort_by(.priority, .id)' 2>/dev/null)"; then
  echo "assignable-beads: bd ready did not print JSON this script can read" >&2
  exit 1
fi

printf '%s\n' "$out"
