{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "\"$CEREBRO_SCRIPTS/agent-asking\" begin", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "\"$CEREBRO_SCRIPTS/agent-asking\" end", "timeout": 10 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          { "type": "command", "command": "\"$CEREBRO_SCRIPTS/agent-asking\" end", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CEREBRO_SCRIPTS/agent-turn\" ended", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CEREBRO_SCRIPTS/agent-turn\" resumed", "timeout": 10 }
        ]
      }
    ]
  }
}
