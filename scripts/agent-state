#!/usr/bin/env bash
#
# Writes an agent's state file: .cerebro/state/<name>.state.json. Written by every agent in
# the fleet - the thirteen implementers and, since ah-2n3.2, the five interactive roles (Xavier,
# Cerebro, Moira, Psylocke, Bishop) - so cerebro.el derives a row the same way for all of them; it
# exists so the two timestamps below are handled by code rather than remembered by an agent an hour
# into a bead.
#
#     .claude/cerebro/scripts/agent-state <name> <state> [--bead <id>] [--phase <phase>] --pid <pid>
#
# <state> is one of: idle working asking done - the only field cerebro--supervise-action reads.
# `done` is an implementer's state alone: an interactive agent has no bead to finish and is never
# replaced between beads, so this script refuses `done` from one of the five interactive names.
# <phase>, only meaningful with `working` or `asking`, is one of:
#   build gate review ci rebase merge          (an implementer)
#   triage plan                                (Xavier)
#   prepare verify                             (Psylocke)
#   sweep                                      (Moira)
#   sweep release                              (Cerebro)
#   daily weekly                               (Bishop)
# The vocabulary is not checked per-role - any of the words above is accepted from any name, the
# same trade cerebro.el's `cerebro--phases` makes: a wrong word in the State column is not worth a
# per-role table in bash.
# --pid is required and is never defaulted from this script's own parentage: pass the caller's
# $PPID (the claude process), not $$ (this script's own shell) - a guessed pid shows an agent
# as dead and starts a second session over it.
#
# `since` is the time of the last change of state or bead (unchanged meaning from before this
# script existed) - preserved across a phase-only change, reset when state or bead changes.
# `phase_since` is the time of the last change of phase; null when no --phase is given.
#
# Writes atomically (write to a .tmp file, then mv) so cerebro.el never reads a torn file.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The five interactive agents, mirroring `cerebro-interactive-agents` in emacs/cerebro.el and the
# `--name` each of their launchers (scripts/run-planner, run-orchestrator, run-user-feedback,
# run-psylocke, run-bishop) passes - three copies of the same list, and all three must agree, since
# a bash script cannot read the Elisp one at runtime.
INTERACTIVE=(Xavier Cerebro Moira Psylocke Bishop)

usage() {
  echo "usage: agent-state <name> <idle|working|asking|done> [--bead <id>] [--phase <build|gate|review|ci|rebase|merge|triage|plan|prepare|verify|sweep|release|daily|weekly>] --pid <pid>" >&2
  exit 2
}

name="${1:-}"
state="${2:-}"
[[ -n "$name" && -n "$state" ]] || usage
shift 2

bead=""
phase=""
pid=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bead)
      bead="${2:-}"; shift 2 ;;
    --phase)
      phase="${2:-}"; shift 2 ;;
    --pid)
      pid="${2:-}"; shift 2 ;;
    *)
      echo "agent-state: unknown argument '$1'" >&2
      exit 2 ;;
  esac
done

# The name is either on the roster or one of the five interactive agents - an off-roster,
# non-interactive name is a file the fleet view never reads. Captured to a variable first, not
# piped straight into `grep -q`: `-q` closes its stdin the moment it sees a match, and a match on
# Cyclops (the roster's first line) would SIGPIPE run-implementer's still-writing printf, which
# `pipefail` then reports as a failure.
roster="$("$script_dir/run-implementer" --roster)"
is_interactive=""
for candidate in "${INTERACTIVE[@]}"; do
  if [[ "$candidate" == "$name" ]]; then
    is_interactive=1
    break
  fi
done
# Fixed-string, whole-line match: `grep -qx` alone treats NAME as a regex, so a crafted name like
# ".*" could match any roster line rather than being rejected. `-F` disables that, and `--` stops a
# name that starts with `-` being read as an option.
if [[ -z "$is_interactive" ]] && ! grep -qFx -- "$name" <<<"$roster"; then
  echo "agent-state: $name is neither on the roster nor an interactive agent" >&2
  exit 2
fi

case "$state" in
  idle|working|asking) ;;
  done)
    if [[ -n "$is_interactive" ]]; then
      echo "agent-state: done is an implementer's state; an interactive agent writes idle when it has nothing to do" >&2
      exit 2
    fi
    ;;
  *)
    echo "agent-state: unknown state '$state' (idle|working|asking|done)" >&2
    exit 2 ;;
esac

if [[ -n "$phase" ]]; then
  case "$phase" in
    build|gate|review|ci|rebase|merge|triage|plan|prepare|verify|sweep|release|daily|weekly) ;;
    *)
      echo "agent-state: unknown phase '$phase' (build|gate|review|ci|rebase|merge|triage|plan|prepare|verify|sweep|release|daily|weekly)" >&2
      exit 2 ;;
  esac
  # A phase is only meaningful with a bead in flight - writing one into an idle or done file would
  # leave the state file internally inconsistent (a phase with no bead being worked).
  case "$state" in
    working|asking) ;;
    *)
      echo "agent-state: --phase is only valid with working or asking, not '$state'" >&2
      exit 2 ;;
  esac
fi

if [[ -z "$pid" ]]; then
  echo "agent-state: --pid is required (pass \$PPID)" >&2
  exit 2
fi
if ! [[ "$pid" =~ ^[0-9]+$ ]]; then
  echo "agent-state: --pid is required (pass \$PPID)" >&2
  exit 2
fi

# The shared checkout every worktree of the repository has in common - never the enclosing tree,
# which from a bead worktree's own submodule copy is the worktree itself, not the main checkout
# the fleet view reads (ah-e0w). See scripts/consumer-root for the two roots and why they differ.
repo_root="$("$script_dir/consumer-root" --shared)"
out_dir="$repo_root/.cerebro/state"
mkdir -p "$out_dir"
out_file="$out_dir/$name.state.json"
tmp_file="$out_file.tmp"

now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

prev="$(jq -c '.' "$out_file" 2>/dev/null || true)"

prev_state="$(jq -r '.state // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_bead="$(jq -r '.bead // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_phase="$(jq -r '.phase // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_since="$(jq -r '.since // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_phase_since="$(jq -r '.phase_since // empty' <<<"${prev:-{}}" 2>/dev/null || true)"

if [[ -n "$prev_since" && "$prev_state" == "$state" && "$prev_bead" == "$bead" ]]; then
  since="$prev_since"
else
  since="$now"
fi

if [[ -z "$phase" ]]; then
  phase_since=""
elif [[ -n "$prev_phase_since" && "$prev_phase" == "$phase" ]]; then
  phase_since="$prev_phase_since"
else
  phase_since="$now"
fi

jq -n \
  --arg state "$state" \
  --arg phase "$phase" \
  --arg bead "$bead" \
  --arg since "$since" \
  --arg phase_since "$phase_since" \
  --arg pid "$pid" \
  '{
    state: $state,
    phase: (if $phase == "" then null else $phase end),
    bead: (if $bead == "" then null else $bead end),
    since: $since,
    phase_since: (if $phase_since == "" then null else $phase_since end),
    pid: ($pid | tonumber)
  }' > "$tmp_file"

mv -f "$tmp_file" "$out_file"
