#!/usr/bin/env bash
#
# The one place "can these changed paths affect the gate" is answered (cb-ypx).
#
#     git diff --name-only --no-renames HEAD^1 HEAD | scripts/ci-needed >> "$GITHUB_OUTPUT"
#
#   stdout   exactly one line, `run=true' or `run=false' - the shape $GITHUB_OUTPUT takes, so the
#            caller appends stdout to it and reads nothing else. Never anything but that line.
#   stderr   why: `ci-needed: <path>' for the first path that reaches the gate, or the count of
#            paths that reached none of them, or that no paths were given at all.
#   exit 0   an answer was given, either way. An empty diff is a BROKEN diff, not a docs change,
#            and answers `run=true'. Fail-safe.
#   exit 2   any argument at all: a usage error, and NO answer on stdout - the caller's -e makes
#            that a failed step, and a failed `changes' job skips nothing.
#
# The answer is on stdout and not in the exit status on purpose: an answer by exit status made the
# caller defuse `bash -e' before reading it, and a crash that happened to exit 1 - an unbound
# variable under `set -u' does - read as "skip". Now the only way to skip is to print `run=false',
# and a crash is a red step.
#
# The skip list is a decision, and the reason lives beside each entry below. It is deliberately
# small: a wider list buys nothing, and each entry is one more thing a future suite can silently
# start reading. `scripts/lint' check 12 advises when one does.
#
# NOT under `tests/': the gate's suite loop is `tests/*.sh', and nothing under tests/ may be a
# script whose stdout is an answer - the loop would run it as a suite. Its suite is
# `tests/ci-needed.sh'.

set -uo pipefail

if [[ $# -gt 0 ]]; then
  echo "usage: ci-needed < paths" >&2
  exit 2
fi

count=0
while IFS= read -r path; do
  [[ -n "$path" ]] || continue
  count=$((count + 1))
  case "$path" in
    # A specific file before the directory it lives in: the first matching arm wins.
    docs/agent-workflow.md)
      # tests/launch-targets.sh greps this one file, so it reaches the gate.
      echo "ci-needed: $path" >&2
      echo run=true
      exit 0
      ;;
    docs/*)
      # Nothing in tests/, tests/gate or emacs/*.el opens anything else under docs/.
      ;;
    README.md)
      # Read only by scripts/lint, which is advisory and never blocks a merge.
      ;;
    LICENSE)
      # Read by nothing.
      ;;
    models.conf.example)
      # Read by nothing; the live copy is .cerebro/models.conf, which IS read.
      ;;
    *)
      # Everything else: agents/, skills/, templates/, CLAUDE.md, emacs/, scripts/, hooks/,
      # githooks/, tests/, .github/, .cerebro/, .claude/.
      echo "ci-needed: $path" >&2
      echo run=true
      exit 0
      ;;
  esac
done

if [[ $count -eq 0 ]]; then
  echo "ci-needed: no paths given, running everything" >&2
  echo run=true
  exit 0
fi

echo "ci-needed: none of $count paths reaches the gate" >&2
echo run=false
exit 0
