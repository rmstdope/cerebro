#!/usr/bin/env bash
#
# `agent-cli` - the one place a tool's executable, arguments and discovery paths are answered.
#
# The defect it ends: the answer was spelt `claude` in argv, in two scripts - `exec claude` with
# nine flag spellings after it in `scripts/launch`, and `command -v claude` in
# `scripts/launch-preflight` - declared nowhere and askable of nothing. Adding a second provider
# meant rewriting both launchers; now it is a second arm in this file.
#
#     agent-cli --default-tool        the tool a fleet that declares nothing runs on -> claude
#     agent-cli --binary --tool <t>   the executable to exec and to find
#     agent-cli --argv --tool <t> --role <role> --name <Name> [--model <m>] [--effort <e>]
#                                     [--settings <path>]
#                                     every argv token between the binary and the caller's own
#                                     extra arguments, NUL-separated
#     agent-cli --prompt-argv --tool <t> <text>
#                                     the tokens that carry a seed prompt, NUL-separated
#     agent-cli --check --tool <t> <Name>
#                                     exit 0 if a session on <t> can start; otherwise refuse through
#                                     launch-refused and exit 3
#
#     agent-cli --known               the providers this cerebro can run, one per line
#     agent-cli --hooks               where each provider whose hooks are discovered FROM THE
#                                     REPOSITORY keeps them, one tab-separated row per provider:
#                                     provider, the source directory relative to this checkout's
#                                     root, the destination directory relative to the consumer
#                                     root. `claude' has no row, so an empty answer is legal.
#     agent-cli --layouts             where each provider discovers agents and skills, one
#                                     tab-separated row per provider: provider, agents directory,
#                                     skills directory (both relative to the consumer root), and
#                                     the agent-file suffix. A skill keeps its directory name in
#                                     both, so there is no skill suffix column.
#
# The four launch verbs are TOLD which tool they are answering about (cb-94y.2). `.cerebro/agents.conf'
# decides that, per agent, and `scripts/agents-conf' is where it
# is read. `--tool' is REQUIRED on each of them, and a value outside KNOWN is a USAGE error rather
# than a refusal - by the time `launch' calls these the word has already come out of `agents-conf',
# which validated it against `--known' itself, so a bad value here is a caller's bug and not a
# navigator's. `--default-tool' exists so that `scripts/launch' still spells no provider's name.
#
# NUL and not one token per line, because `launch`'s trailing prompt contains a newline: a
# line-delimited protocol would split it into two argv entries. Read it back with
#
#     while IFS= read -r -d '' tok; do argv+=("$tok"); done < <(agent-cli --argv ...)
#
# a process substitution rather than a pipe, or the array is built in a subshell and lost.
#
# The prompt carries cerebro's marker sentence (cb-d59.3), and `--prompt-argv` knows nothing about
# it: composing the prompt is provider-neutral work and belongs in `launch`, while this file stays a
# table of one provider's spellings. A second arm emits `-i <text>` for the same verb and inherits
# the marker for free.
#
# `--argv` deliberately stops short of the prompt: `launch` puts the caller's own extra arguments
# between the flags and the prompt, which is what makes a `--model` typed on the command line beat
# the one agents.conf named. Two verbs preserve that ordering exactly:
#
#     exec "$binary" "${argv[@]}" "$@" "${prompt_argv[@]}"
#
# `--check` takes a name because a refusal has to REACH the fleet view, and the only way it does is
# `launch-refused <Name> <message>` - one line on stderr and one line in
# .cerebro/state/errors.jsonl. So `--check` is the launcher's front door: it owns both
# launch-blocking conditions, says them once, and records them. The plain verbs still exit 3 on an
# unrunnable declaration, with `agent-cli: ` in front of the same sentence, but that is a backstop.
#
# BASH ONLY, NO EXTERNAL COMMANDS on the launch path: `tests/launchers.sh` runs a launcher on a PATH
# containing nothing but `dirname` and `bash`, and this script now runs inside that. So no `grep`,
# `sed`, `tr`, `awk` or `cut` anywhere in it - parameter expansion and `[[` are the whole toolbox,
# the same constraint `scripts/roster` records for the same reason. `project-conf` is safe to call
# (its `grep` lives only in branches no longer reached) and `launch-refused` is on the
# refusal path only.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# The provider table, and nothing else provider-shaped anywhere in the repository. Adding an arm is:
# add its word to KNOWN and add its branch to --binary, --argv, --prompt-argv and
# the PATH check. That is the seam. A provider whose hooks come from the repository emits no
# `--settings' token from --argv, and gets a `--hooks' row instead: `scripts/launch' passes
# `--settings' unconditionally and keeps doing so; it is the provider arm that decides whether to
# spell it.
KNOWN="claude copilot"
DEFAULT_TOOL="claude"

# The third table: where a provider LOOKS for agents and skills, which is a different question from
# whether this fleet can start a session on it - so `copilot' has a row here while it is still in
# PLANNED. `sync-symlinks.sh' writes every layout in every consumer whatever `agents.conf' says
# (cb-d59.4).
# The FIRST row is the canonical layout, and the sync's mirror pass reads it as such.
# The fourth table: where a provider whose hooks are DISCOVERED FROM THE REPOSITORY keeps them, and
# where they must be installed for it to find them. `claude' has no row - its hook settings file is
# passed with `--settings' and is installed nowhere - so an empty output is a legal answer and a
# caller looping over the rows must survive one.
HOOKS="copilot	hooks/copilot	.github/hooks"

# The fifth table: the providers whose model and effort ids the agent files' frontmatter is written
# in. Claude Code's, and nobody else's - cb-d59 rejected growing a `model_copilot:' key in every
# agent file (decision 5), so on any other provider the frontmatter is ignored and
# .cerebro/agents.conf is the only place any tool's models are chosen (cb-94y.2).
LAYOUTS="claude	.claude/agents	.claude/skills	.md
copilot	.github/agents	.github/skills	.agent.md"

known_list() {
  local out="" p
  for p in $KNOWN; do
    if [[ -z "$out" ]]; then out="$p"; else out="$out, $p"; fi
  done
  printf '%s' "$out"
}

in_list() {
  local needle="$1" list="$2" p
  for p in $list; do
    [[ "$p" == "$needle" ]] && return 0
  done
  return 1
}

usage() {
  echo "usage: agent-cli [--known | --layouts | --hooks | --default-tool | --binary --tool <t> | --check --tool <t> <Name> | --argv --tool <t> ... | --prompt-argv --tool <t> <text>]" >&2
  exit 2
}

verb="${1:-}"

case "$verb" in
  --known)
    [[ $# -eq 1 ]] || usage
    for p in $KNOWN; do printf '%s\n' "$p"; done
    exit 0
    ;;
  --hooks)
    # Answered BEFORE resolve, for the same reasons --layouts is: the sync runs from
    # launch-preflight before every single session, so one stderr line here is one line above
    # every agent's first prompt for ever - and a consumer declaring a provider this cerebro
    # cannot run yet is exactly the one needing the row.
    [[ $# -eq 1 ]] || usage
    printf '%b\n' "$HOOKS"
    exit 0
    ;;
  --default-tool)
    # Answered BEFORE `resolve', like --known: the consumer this matters to is the one that
    # declares nothing at all, where `resolve' would print its fallback line above every session.
    [[ $# -eq 1 ]] || usage
    printf '%s\n' "$DEFAULT_TOOL"
    exit 0
    ;;
  --layouts)
    # Answered BEFORE resolve, and deliberately: a sync must get every provider's layout in a
    # consumer that declares nothing (where resolve would print its fallback line in front of every
    # sync) and in one declaring a provider this cerebro cannot run yet (where resolve would exit 3
    # - and that is exactly the consumer needing the row).
    [[ $# -eq 1 ]] || usage
    printf '%b\n' "$LAYOUTS"
    exit 0
    ;;
  --binary|--check|--argv|--prompt-argv) ;;
  *) usage ;;
esac

# The told verbs: `--tool <t>' comes first and is consumed here, so each arm below sees exactly the
# arguments it saw before. `--argv' reads its own `--tool' inside its flag loop, having no fixed
# argument order at all.
provider=""
told=""
case "$verb" in
  --binary|--check|--prompt-argv)
    [[ "${2:-}" == "--tool" && -n "${3:-}" ]] || usage
    in_list "$3" "$KNOWN" || usage
    provider="$3"
    told=1
    shift 3
    set -- "$verb" "$@"
    ;;
  --argv) told=1 ;;
esac

case "$verb" in
  --binary)
    [[ $# -eq 1 ]] || usage
    case "$provider" in
      claude)  printf '%s\n' "claude" ;;
      copilot) printf '%s\n' "copilot" ;;
    esac
    ;;
  --check)
    name="${2:-}"
    [[ -n "$name" && $# -eq 2 ]] || usage
    case "$provider" in
      claude)
        if ! command -v claude >/dev/null 2>&1; then
          "$here/launch-refused" "$name" "claude is not on PATH - install Claude Code or fix PATH before starting $name"
          exit 3
        fi
        ;;
      copilot)
        if ! command -v copilot >/dev/null 2>&1; then
          "$here/launch-refused" "$name" "copilot is not on PATH - install GitHub Copilot CLI or fix PATH before starting $name"
          exit 3
        fi
        ;;
    esac
    ;;
  --prompt-argv)
    [[ $# -eq 2 ]] || usage
    case "$provider" in
      claude) printf '%s\0' "$2" ;;
      # `-i' and not `-p': `-p' exits when the prompt is finished, `-i' stays up in a terminal,
      # which is the shape the fleet view needs. And not a bare trailing argument either - copilot
      # refuses one outright (docs/providers/copilot.md, M3/M11).
      copilot) printf '%s\0' -i "$2" ;;
    esac
    ;;
  --argv)
    shift
    role="" name="" model="" effort="" settings=""
    have_settings=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --tool)     provider="${2:-}"; shift 2 ;;
        --role)     role="${2:-}"; shift 2 ;;
        --name)     name="${2:-}"; shift 2 ;;
        --model)    model="${2:-}"; shift 2 ;;
        --effort)   effort="${2:-}"; shift 2 ;;
        --settings) settings="${2:-}"; have_settings=1; shift 2 ;;
        *) usage ;;
      esac
    done
    [[ -n "$role" && -n "$name" ]] || usage
    # Required and validated here rather than before the loop, `--argv' having no fixed order.
    [[ -n "$provider" ]] || usage
    in_list "$provider" "$KNOWN" || usage
    case "$provider" in
      claude)
        printf '%s\0' --agent "$role" --name "$name" --remote-control "$name"
        [[ -n "$model" ]] && printf '%s\0' --model "$model"
        [[ -n "$effort" ]] && printf '%s\0' --effort "$effort"
        [[ -n "$have_settings" ]] && printf '%s\0' --settings "$settings"
        printf '%s\0' --permission-mode auto
        ;;
      copilot)
        # Three absences, each as load-bearing as the presences. No `--remote-control': copilot has
        # none, and cb-d59 accepted the loss. No `--settings': copilot discovers its hooks from the
        # consumer's .github/hooks/ (cb-d59.5), so the argument is accepted here and ignored. And
        # `--allow-all' rather than `--permission-mode auto', there being no such flag: copilot
        # splits that ground into --allow-all-tools, --allow-all-paths and --allow-all-urls, and
        # `--allow-all' is the union, which is what `--permission-mode auto' covers on the other
        # arm. The narrower `--allow-all-tools' was tried first and prompted on every path outside
        # the repository, which stalls an unattended session with no `asking' state to show for it.
        # It goes last, where the claude arm puts its own.
        printf '%s\0' --agent "$role" --name "$name"
        [[ -n "$model" ]] && printf '%s\0' --model "$model"
        [[ -n "$effort" ]] && printf '%s\0' --effort "$effort"
        printf '%s\0' --allow-all
        ;;
    esac
    ;;
esac
exit 0
