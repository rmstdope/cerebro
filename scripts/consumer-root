#!/usr/bin/env bash
# The consumer repository root this copy of cerebro serves. Two answers, on purpose:
#
#   consumer-root            the enclosing working tree - the main checkout, or a bead worktree
#                            when this copy is the worktree's own submodule. Right for anything
#                            that acts on THIS tree: its symlinks, its agent files, its hooks.
#   consumer-root --shared   the main working tree every worktree of the repository shares -
#                            where the fleet view reads state files and stop flags and where the
#                            sweeps look. Right for anything the fleet reads or that reasons about
#                            the whole repository. From the main checkout both answers are equal.
#
# And two about the mount itself - how this checkout sits in that root, which is the same question
# asked from the other side, so it is answered here and nowhere else (cb-akc):
#
#   consumer-root --self-mounted   exit 0 when `.claude/cerebro' resolves back to this very
#                                  checkout - cerebro serving its own fleet (cb-i3l.1) - and 1 for
#                                  every real consumer. Prints nothing.
#   consumer-root --mount          the path of this checkout relative to the consumer root, the way
#                                  a link from the consumer should spell it: `.claude/cerebro' at
#                                  the standard mount and for the self-mount, the physical relative
#                                  path (`vendor/cerebro') for a submodule vendored elsewhere.
#   consumer-root --hints          all three of the above, one per line - enclosing, shared (which
#                                  may be empty), mount - for `launch' to export down its process
#                                  tree in ONE fork rather than three (cb-ue0). See
#                                  scripts/root-hints.sh for what reads them and why they are
#                                  validated rather than trusted.
#
# The mount may be <consumer>/.claude/cerebro or, for a consumer that vendors cerebro as a SUBMODULE
# somewhere else entirely (vendor/cerebro, tools/cerebro, ...), wherever it put it - see the three
# resolution steps below. It may also be cerebro's own checkout, which mounts itself by symlink to
# run its fleet on its own source. A vendored *copy* that is not a submodule is only found at the
# standard mount, and is otherwise unsupported.
#
# Exit 1 with a message when neither answers (a standalone clone of cerebro has no consumer), or
# when --shared is asked outside a git tree.
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# The mount round trip - `cerebro_mount_resolves_to' - lives in scripts/root-hints.sh, which is
# also where the launch path's root hints are validated by it (cb-ue0). Stated once there rather
# than twice here: five copies by three mechanisms is how the janitor walked one list twice and
# roster fell back to the built-in fleet in silence. Sourcing costs no fork and no external
# command, so the narrowed-PATH guarantee tests/launchers.sh asserts survives it.
source "$script_dir/root-hints.sh"

# Three ways of answering, tried in order (ah-ohc2, cb-i3l.1).
#
# 1. The path arithmetic, which needs no git: this script lives at
#    <consumer>/.claude/cerebro/scripts, and the round trip back through `.claude/cerebro' is what
#    rejects a standalone clone of cerebro - whatever changes here must keep rejecting one, or this
#    would start answering with somebody's home directory.
#
#    It goes FIRST for two reasons. The bare form of this script uses no external command today, and
#    tests/launchers.sh runs a launcher with a PATH of `dirname' and `bash' alone: asking git first
#    would put git on the standard mount's path for no gain. And the probe below answers about
#    whatever repository this checkout belongs to - for a plain (non-submodule) COPY at the standard
#    mount that is the consumer's own repo, so a consumer that is itself a submodule of something
#    else would resolve to its grandparent. The validated arithmetic cannot make that mistake.
#    `scripts/roster' asks this script for its root rather than resolving one of its own (cb-akc).
#
# 2. Ask git which working tree contains this checkout as a submodule.
#    `--show-superproject-working-tree' is purpose-built for exactly that question and answers
#    however deep the mount is and whatever it is called, so a consumer that vendors cerebro at
#    `vendor/cerebro' or `tools/cerebro' gets a fleet like any other. Its failure is SWALLOWED: git
#    may not be on PATH at all, and that must leave the standard mount working rather than failing.
#
#    It answers for a real SUBMODULE and nothing else. A vendored *copy* outside the standard mount
#    is still unsupported: nothing here can find it, and inventing a marker-file search for a case
#    nobody has is not the answer.
#
# 3. Cerebro serving ITSELF, mounted at `.claude/cerebro` as a symlink back to its own checkout
#    (cb-i3l.1). This repository develops itself with its own fleet, and neither step above can see
#    that mount: `pwd -P` resolves the symlink, so the script appears to live at <cerebro>/scripts
#    and three levels up is nobody's consumer, while the superproject probe answers for submodules
#    and this is not one. (A submodule of the repository inside itself WOULD satisfy step 1, and is
#    the wrong answer for a different reason: `git submodule update --init --recursive`, which
#    `launch-preflight` runs, has no fixed point on a repository that contains itself.)
#
#    A standalone clone still has no consumer, and is still refused: what is checked is the round
#    trip through the mount, which only a checkout that has deliberately mounted itself can make.
candidate="$(cd "$script_dir/../../.." 2>/dev/null && pwd -P)" || candidate=""
if [[ -n "$candidate" ]] && cerebro_mount_resolves_to "$candidate" "$script_dir/.."; then
  enclosing="$candidate"
else
  enclosing="$(git -C "$script_dir" rev-parse --show-superproject-working-tree 2>/dev/null)" || enclosing=""
  if [[ -n "$enclosing" ]]; then
    enclosing="$(cd "$enclosing" 2>/dev/null && pwd -P)" || enclosing=""
  fi
fi
if [[ -z "$enclosing" ]]; then
  # 3. This checkout mounted as its own consumer - `.claude/cerebro' resolving back to the very
  #    tree this script lives in. No git, so the narrowed PATH in tests/launchers.sh still works.
  own_root="$(cd "$script_dir/.." && pwd -P)"
  if cerebro_mount_resolves_to "$own_root" "$own_root"; then
    enclosing="$own_root"
  fi
fi
if [[ -z "$enclosing" ]]; then
  echo "consumer-root: $script_dir is not <consumer>/.claude/cerebro/scripts" >&2
  exit 1
fi
case "${1:-}" in
  "") printf '%s\n' "$enclosing" ;;
  --shared)
    # Asked from the consumer tree, never from inside the submodule: from here --git-common-dir
    # would name the submodule's own git directory. From a linked worktree it names the main
    # repository's .git, whose parent is the shared working tree.
    common="$(git -C "$enclosing" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
      || { echo "consumer-root: $enclosing is not inside a git working tree" >&2; exit 1; }
    printf '%s\n' "$(cd "$(dirname "$common")" && pwd -P)" ;;
  --self-mounted)
    # Exit 0 when this checkout IS its consumer - `.claude/cerebro' is a symlink back to the tree
    # it lives in (cb-i3l.1) - and 1 for every real consumer. Nothing printed: the exit status is
    # the whole answer. No caller in this repository needs it today - it is here because it is the
    # question `--mount' and both resolution steps above are already asking, stated once.
    cerebro_mount_resolves_to "$enclosing" "$enclosing" ;;
  --mount)
    # The path of this checkout relative to the consumer root, the way a link from the consumer
    # should spell it: `.claude/cerebro' whenever the standard mount resolves to this checkout
    # (a submodule there, the self-mount symlink, or a symlink at the standard mount to a
    # submodule elsewhere), and the physical relative path otherwise (`vendor/cerebro').
    # sync-symlinks.sh builds every relative link from this.
    checkout="$(cd "$script_dir/.." && pwd -P)"
    if cerebro_mount_resolves_to "$enclosing" "$checkout"; then
      printf '.claude/cerebro\n'
    else
      rel="${checkout#"$enclosing/"}"
      [[ "$rel" != "$checkout" ]] \
        || { echo "consumer-root: $checkout is not under $enclosing" >&2; exit 1; }
      printf '%s\n' "$rel"
    fi ;;
  --hints)
    # All three answers in one call, for `launch' to export down its process tree (cb-ue0):
    #
    #     <enclosing root>
    #     <shared root, or empty when this is not a git working tree>
    #     <mount>
    #
    # One fork instead of three, which is the whole point of the exercise - the hints exist to stop
    # the launch path re-deriving this, so paying three forks to publish them would be absurd. The
    # shared line is allowed to be empty because `--shared' needs git and the other two do not; a
    # consumer script given an empty shared hint falls back exactly as it does with no hint at all.
    shared="$(git -C "$enclosing" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
      && shared="$(cd "$(dirname "$shared")" && pwd -P)" || shared=""
    checkout="$(cd "$script_dir/.." && pwd -P)"
    if cerebro_mount_resolves_to "$enclosing" "$checkout"; then
      mount=".claude/cerebro"
    else
      mount="${checkout#"$enclosing/"}"
      [[ "$mount" != "$checkout" ]] \
        || { echo "consumer-root: $checkout is not under $enclosing" >&2; exit 1; }
    fi
    printf '%s\n%s\n%s\n' "$enclosing" "$shared" "$mount" ;;
  *) echo "usage: consumer-root [--shared|--self-mounted|--mount|--hints]" >&2; exit 2 ;;
esac
