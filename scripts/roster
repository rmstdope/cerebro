#!/usr/bin/env bash
#
# The one place the fleet is declared: name, role, and (derived) kind, one agent per line. Every
# other reader — `scripts/launch`, `scripts/agent-state`, `emacs/cerebro.el`, and the tests — reads
# this file rather than keeping its own copy, which is what let those copies drift from each other
# and from the launchers before this script existed.
#
# Order matters: interactive agents first, then implementers, in the order the fleet view shows them
# and the order Cerebro picks the next unused implementer name from. Keep new entries in that shape.
#
# KIND is derived, not written: `implementer` when ROLE is `implementer`, `interactive` otherwise.
# That rule lives here and nowhere else — every reader takes the KIND column rather than
# re-deriving it.
#
# Adding a role: one line here and one `agents/<role>.md`; the fleet view, `agent-state`, `launch`
# and the tests read this file.
#
# Adding a *second agent to an existing role* (as `planner` has, Xavier and Beast): one line here,
# and nothing else structural — every reader is name-driven. What it does need is a look at whatever
# that role does exactly once per fleet rather than once per session: `plan-bead` gives the P4
# triage pass to the first planner listed here, so file order is load-bearing for more than display.
#
#     roster                    every row, NAME<TAB>ROLE<TAB>KIND, in file order
#     roster --implementers     the implementer names only, one per line, in file order
#     roster --entry <Name>     that one row (NAME<TAB>ROLE<TAB>KIND); exit 2 if absent
#     roster --role <role>      the names holding that ROLE, one per line, in file order; nothing
#                               (exit 0) if nobody holds it
#     roster --autostart        the names whose row carries `autostart', one per line, in file
#                               order; nothing (exit 0) when no row does
#
# A row is NAME ROLE and, optionally, a third word: `autostart', which says the fleet view starts
# that agent as it comes up (cb-0r6). Omitting it means no, so every roster written before that
# bead - and the TABLE below - behaves exactly as it did. Any OTHER third word, or a fourth word,
# is refused with exit 2 naming the file, the line and the word: a typo of `autostart' that read as
# "no" would be a fleet that quietly does not start, which is the failure this refusal exists to
# prevent. The word is exposed through `--autostart' ALONE - the default output stays three columns,
# because `launch', `agent-state' and `cerebro--parse-fleet' all take the last field as the KIND.
#
# Exact-match only, case-sensitive — the "it is spelt Storm" courtesy belongs to `launch`, where a
# human types the name.
#
# Bash 3.2, builtins only (plus `dirname`, already required by callers): no `awk`, `grep`, `cut`,
# `tr`, and no `declare -A` — this runs on macOS's stock bash, and on the PATH the
# claude-missing test in tests/launchers.sh deliberately narrows to `dirname` and `bash` alone.

set -euo pipefail

# NAME        ROLE            (role = the agents/<role>.md file it runs, and the --agent value)
TABLE="
Xavier        planner
Beast         planner
Cerebro       orchestrator
Moira         user-feedback
Psylocke      verifier
Cypher        reviewer
Forge         architect
Cyclops       implementer
Storm         implementer
Wolverine     implementer
Rogue         implementer
Gambit        implementer
Nightcrawler  implementer
Colossus      implementer
Iceman        implementer
Jubilee       implementer
Phoenix       implementer
Mystique      implementer
Magneto       implementer
"

kind_of() {
  # $1 = role
  if [[ "$1" == "implementer" ]]; then
    printf 'implementer'
  else
    printf 'interactive'
  fi
}

# Where a consumer declares its own fleet, if it does: <consumer>/.cerebro/roster.conf. Found by
# path arithmetic - this script lives at <consumer>/.claude/cerebro/scripts/roster - and
# DELIBERATELY NOT by calling `consumer-root', which shells out to `git': `roster' needs no external
# command beyond `dirname', and tests/launchers.sh runs a launcher with a PATH of `dirname' and
# `bash' alone to keep it that way. Tidying this into that seam would break that guarantee with
# nothing to say so.
#
# The file is TRACKED (beside .cerebro/project.conf, by a `.gitignore' negation inside the
# otherwise-ignored .cerebro/ - cb-epr): which agents exist is a fact every clone needs, and an
# ignored one would vanish on a fresh clone and silently revert the fleet to the names below.
#
# It REPLACES this table rather than merging with it. File order is load-bearing - `plan-bead' gives
# the P4 triage pass to the first planner listed, and Cerebro takes the next unused implementer name
# in file order - and a merged order is nobody's decision.
#
# Three candidate ROOTS, first hit wins (ah-ohc2). The arithmetic comes FIRST and needs no git, so
# the standard mount keeps working under the narrowed PATH above. The last is for a consumer that
# vendors cerebro as a submodule somewhere else - `vendor/cerebro', a sibling checkout - and is
# tried only when `git' is actually there, skipped in silence when it is not. Under the narrowed
# PATH that candidate simply does not resolve and roster falls back to the built-in table, which is
# exactly what tests/launchers.sh asserts: DO NOT "simplify" this into a hard git dependency or a
# call to `consumer-root', or that guarantee goes with it.
#
# The file lived at <consumer>/.claude/cerebro-roster until cb-epr. At every candidate root, a file
# still sitting there with none at the new path is a MIGRATION ERROR and exits 2: absence is the
# documented "run the built-in fleet" signal, and a stale path silently borrowing it is how a
# consumer would end up running nineteen names it never declared.
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

CONSUMER_ROSTER=""
OLD_ROSTER=""

# $1 = a candidate consumer root. Sets CONSUMER_ROSTER when the declaration is there, OLD_ROSTER
# when only the retired path is. Builtins only, like everything else here.
consider_root() {
  local candidate="$1"
  [[ -n "$candidate" ]] || return 0
  if [[ -f "$candidate/.cerebro/roster.conf" ]]; then
    CONSUMER_ROSTER="$candidate/.cerebro/roster.conf"
  elif [[ -z "$OLD_ROSTER" && -f "$candidate/.claude/cerebro-roster" ]]; then
    OLD_ROSTER="$candidate/.claude/cerebro-roster"
  fi
}

consider_root "$here/../../.."

# Second candidate: cerebro serving ITSELF (cb-i3l.3). The mount is a symlink `.claude/cerebro -> ..',
# so the arithmetic above walks THROUGH it - the kernel resolves `.claude/cerebro/scripts/../..' to
# the directory above the repository - and roster went looking for a file beside somebody's clone.
# The consumer file was then ignored in silence and the table below used instead, which looks exactly
# like a working fleet until a name that is not on it fails to launch.
#
# The check is the same round trip `consumer-root' makes, and like everything else above it uses no
# external command, so the narrowed-PATH guarantee survives. It runs BEFORE git for the same reason
# the arithmetic does.
if [[ -z "$CONSUMER_ROSTER" ]]; then
  own_root="$(cd "$here/.." 2>/dev/null && pwd -P)" || own_root=""
  if [[ -n "$own_root" && "$(cd "$own_root/.claude/cerebro" 2>/dev/null && pwd -P)" == "$own_root" ]]; then
    consider_root "$own_root"
  fi
fi

if [[ -z "$CONSUMER_ROSTER" ]] && command -v git >/dev/null 2>&1; then
  superproject="$(git -C "$here" rev-parse --show-superproject-working-tree 2>/dev/null)" || superproject=""
  consider_root "$superproject"
fi

if [[ -z "$CONSUMER_ROSTER" && -n "$OLD_ROSTER" ]]; then
  echo "roster: the fleet declaration has moved - run: mv .claude/cerebro-roster .cerebro/roster.conf" >&2
  exit 2
fi

# $1 = what to call the source in a refusal: the consumer file's path, or `built-in table'.
#
# Emits FOUR tab-separated fields - NAME, ROLE, KIND, FLAG (`autostart' or empty). Only
# `--autostart' looks at the fourth; every other mode drops it, so the public output is the three
# columns every other reader assumes.
parse_rows() {
  local source="$1" lineno=0 name role third rest
  while IFS= read -r line; do
    lineno=$((lineno + 1))
    [[ -z "$line" ]] && continue
    case "$line" in
      \#*) continue ;;
    esac
    read -r name role third rest <<<"$line"
    [[ -z "$name" ]] && continue
    case "$third" in
      "" | autostart) ;;
      *)
        echo "roster: $source line $lineno: '$third' is not a word roster knows - the third column is autostart or nothing" >&2
        exit 2
        ;;
    esac
    if [[ -n "$rest" ]]; then
      echo "roster: $source line $lineno: '$rest' is one word too many - a row is NAME ROLE and optionally autostart" >&2
      exit 2
    fi
    printf '%s\t%s\t%s\t%s\n' "$name" "$role" "$(kind_of "$role")" "$third"
  done
}

print_all() {
  # One parser for both sources: the consumer file has the same NAME ROLE shape, so a second reader
  # would only be a second thing to drift.
  #
  # A consumer file that yields no rows falls back, not only an empty one: a file of nothing but
  # comments has as much to say about the fleet as an absent one, and taking it at its word would
  # leave `roster' silent, every `launch <Name>' answering "not on the roster", and the fleet view
  # empty - with the file that caused it looking, to its author, like a fleet.
  # `exit 2' inside a `$( )' ends the SUBSHELL alone, so a refusal has to be propagated by hand or
  # a typo prints an empty fleet and exits 0 - the silent failure the refusal exists to prevent.
  # `set -e' would abort here too; the `|| exit $?' is written out so the intent is visible and the
  # status is 2 rather than whatever `set -e' would report.
  local rows=""
  if [[ -f "$CONSUMER_ROSTER" ]]; then
    rows="$(parse_rows "$CONSUMER_ROSTER" < "$CONSUMER_ROSTER")" || exit $?
  fi
  if [[ -n "$rows" ]]; then
    printf '%s\n' "$rows"
  else
    parse_rows "built-in table" <<<"$TABLE" || exit $?
  fi
}

# Every mode reads the rows through this ONE capture rather than `< <(print_all)': a process
# substitution runs in a subshell, so `parse_rows' refusing there would exit that subshell and leave
# the mode looping over nothing with status 0 - exactly the silent fleet the refusal exists to
# prevent. Captured here, `|| exit $?' propagates it to the caller.
ROWS="$(print_all)" || exit $?

# $1 = the mode's `while IFS=$'\t' read ...' loop body is the caller's; this just feeds it. A guard
# on emptiness, because `<<<""' is one empty line, not none.
each_row() {
  [[ -n "$ROWS" ]] && printf '%s\n' "$ROWS"
}

case "${1:-}" in
  "")
    while IFS=$'\t' read -r name role kind _; do
      printf '%s\t%s\t%s\n' "$name" "$role" "$kind"
    done < <(each_row)
    ;;
  --implementers)
    while IFS=$'\t' read -r name role kind _; do
      [[ "$kind" == "implementer" ]] && printf '%s\n' "$name"
    done < <(each_row)
    ;;
  --autostart)
    while IFS=$'\t' read -r name role kind flag; do
      if [[ "$flag" == "autostart" ]]; then
        printf '%s\n' "$name"
      fi
    done < <(each_row)
    ;;
  --role)
    # A role can be held by more than one agent (two planners, ah-2p), so "who is the first of
    # them" is a question with an answer rather than a tautology: file order is the answer, and
    # `plan-bead' uses it to give the triage pass to exactly one planner.
    role="${2:-}"
    if [[ -z "$role" ]]; then
      echo "usage: roster [--implementers | --role <role> | --entry <Name> | --autostart]" >&2
      exit 2
    fi
    # `if' rather than `[[ ... ]] &&': the latter leaves the loop - and so this script - exiting
    # non-zero whenever the *last* roster row is not a match, which for any interactive role is
    # every time. `--implementers' gets away with it only because the roster ends in implementers.
    while IFS=$'\t' read -r name row_role _ _; do
      if [[ "$row_role" == "$role" ]]; then
        printf '%s\n' "$name"
      fi
    done < <(each_row)
    ;;
  --entry)
    name="${2:-}"
    if [[ -z "$name" ]]; then
      echo "usage: roster [--implementers | --role <role> | --entry <Name> | --autostart]" >&2
      exit 2
    fi
    found=""
    while IFS=$'\t' read -r row_name row_role row_kind _; do
      if [[ "$row_name" == "$name" ]]; then
        printf '%s\t%s\t%s\n' "$row_name" "$row_role" "$row_kind"
        found=1
        break
      fi
    done < <(each_row)
    if [[ -z "$found" ]]; then
      echo "roster: $name is not on the roster" >&2
      exit 2
    fi
    ;;
  *)
    echo "usage: roster [--implementers | --role <role> | --entry <Name> | --autostart]" >&2
    exit 2
    ;;
esac
