#!/usr/bin/env bash
# Where this checkout's supervision lease lives (cb-kcs.1, cb-abs.2):
#
#     fleet-supervisor --endpoint         -> "127.0.0.1:<port>"
#     fleet-supervisor --identity         -> the canonical absolute shared root
#     fleet-supervisor --record           -> <shared root>/.cerebro/state/supervisor.json
#     fleet-supervisor --endpoint-for <r> -> the endpoint any given root would take
#
#   exit 0  answered
#   exit 2  a usage error, an unresolvable root, or a root that cannot be written into the
#           diagnostic record
#
# THE ONE PLACE the lease's address is computed. `fleet-view/' calls this script rather than
# hashing a root itself, so a port or an identity computed twice cannot disagree once - and a
# disagreement here is two supervisors on one fleet, each starting the sessions the other cannot
# see.
#
# THERE IS NOTHING TO DECLARE (cb-abs.2). With one window, `fleet_supervisor' is gone: this script
# no longer reads the declaration, no longer exits 3, and a bare invocation is a usage error rather
# than a default answer to "which one did you mean". A project.conf that still carries the key is
# not read at all and nothing is said about it.
#
# THE SHARED ROOT, NOT THE ENCLOSING ONE. Every worktree of one checkout supervises the same
# sessions, so all four answers come from `consumer-root --shared', the same rule `project-conf'
# and `agent-state' already follow. A bead worktree therefore computes the same port as the main
# checkout and contends for the same lease, which is what makes the lease meaningful at all.
#
# THE ENDPOINT IS DERIVED, NOT REGISTERED. There is no port registry and no reservation: the port
# is a pure function of the shared root, so two processes that mean the same checkout always meet
# on the same address and two different checkouts almost never do. TWO checksums are XOR-ed rather
# than one taken, because a single `cksum' over two roots that share a long prefix - which is
# exactly what `~/repos/x' and `~/repos/x-hud' are - moves in step and folds onto neighbouring
# ports. A collision is not silently wrong, either: the diagnostic record names the identity, so
# two checkouts that did collide both report a lock error and neither acts. Fail-closed twice over.
#
# THE RANGE STOPS BELOW 32768, which is where Linux's default `ip_local_port_range' begins. A port
# above it can be taken transiently by somebody's outbound connection, and the fleet would read
# that as a lock error and go read-only until the next tick - self-healing, but a puzzle worth not
# handing anybody. 20000-32767 is entirely below the ephemeral ranges of both platforms the fleet
# runs on (macOS starts at 49152).
#
# IT WRITES NOTHING. Not the state directory, not the record, not a declaration it failed to find.
# The record is written by whichever implementation actually binds the listener, and only after it
# binds; this script only says where it goes.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

usage() {
  echo "usage: fleet-supervisor (--endpoint | --identity | --record | --endpoint-for <root>)" >&2
  exit 2
}

# The shared root, hint first and validated - see scripts/root-hints.sh for why an inherited answer
# can only ever skip work rather than answer wrongly.
#
# It RETURNS non-zero rather than exiting, and every caller is `root="$(shared_root)" || exit 2'.
# That is not a style choice: this function is only ever called from a command substitution, and an
# `exit' inside one leaves the SUBSHELL, not the script. Written the obvious way it exited 0 with an
# empty stdout on an unresolvable root - and an empty string is exactly what a caller would then
# bind a listener to, or compare an identity against. Fail-closed means the status has to leave the
# subshell with the value.
shared_root() {
  local root
  source "$here/root-hints.sh"
  root="$(cerebro_hinted_root "$here/.." shared)" \
    || root="$("$here/consumer-root" --shared 2>/dev/null)" \
    || root=""
  if [[ -z "$root" ]]; then
    echo "fleet-supervisor: no consumer root above this checkout - cannot locate the supervision lease" >&2
    return 1
  fi
  (cd "$root" && pwd -P)
}

# One POSIX `cksum' field, without `awk' or `cut': `set --' on the unquoted output splits it, and
# the sum is the first word. `printf %s' rather than `echo', so the byte string hashed is exactly
# the one named here and carries no trailing newline.
cksum_of() {
  local out
  out="$(printf '%s' "$1" | cksum)"
  # shellcheck disable=SC2086
  set -- $out
  printf '%s' "$1"
}

# 20000 + ((cksum("A:<root>") ^ cksum("B:<root>")) % 12768): 20000-32767, two sums so that a
# shared prefix cannot walk two checkouts onto adjacent ports, and a ceiling below Linux's
# ephemeral range (see above).
endpoint_for() {
  local root="$1" a b
  a="$(cksum_of "A:$root")"
  b="$(cksum_of "B:$root")"
  printf '127.0.0.1:%s\n' "$(( 20000 + ((a ^ b) % 12768) ))"
}

# The identity has to survive a round trip through the JSON record and back out to a comparison, so
# a root carrying a tab or a newline is refused rather than written. An identity that comes back
# ambiguous is what would turn a port collision into a silent takeover.
identity_of() {
  local root="$1"
  case "$root" in
    *$'\t'*|*$'\n'*)
      echo "fleet-supervisor: a root containing a tab or a newline cannot be used as a supervision identity: $root" >&2
      exit 2 ;;
  esac
  printf '%s\n' "$root"
}

case "${1-}" in
  --endpoint-for)
    [[ $# -eq 2 && -n "$2" ]] || usage
    endpoint_for "$2"
    ;;
  --endpoint)
    [[ $# -eq 1 ]] || usage
    root="$(shared_root)" || exit 2
    endpoint_for "$root"
    ;;
  --identity)
    [[ $# -eq 1 ]] || usage
    root="$(shared_root)" || exit 2
    identity_of "$root"
    ;;
  --record)
    [[ $# -eq 1 ]] || usage
    root="$(shared_root)" || exit 2
    printf '%s/.cerebro/state/supervisor.json\n' "$root"
    ;;
  *)
    usage
    ;;
esac
