#!/usr/bin/env bash
# Checked, then synced, before every launch: the agent CLI this fleet runs on (scripts/agent-cli,
# cb-d59.2) is one this cerebro knows and its binary is on PATH, the consumer's checkout
# is current with the fleet's default branch on origin (scripts/default-branch) so the session
# reads today's instructions rather than a
# days-old copy of them (ah-puoj), this checkout is a
# consumer's .claude/cerebro (sync and the submodule check are skipped otherwise - a
# standalone clone has nothing to link into and no agent files of its own to check),
# the submodule bump actually brought in this role's agent file, and the link it
# produces resolves. Every launcher runs this immediately before it execs the agent CLI
# (ah-cuc), so a session that cannot start says why instead of exiting silently
# (ah-bri) - a launcher used to go `up` for half a second and then `dead` with
# nothing to read anywhere when `agents/architect.md` was missing.
#
# usage: launch-preflight <role> <name>
#   <role>  the role the launcher is about to start (architect, planner, ...)
#   <name>  the display name for messages (Bishop, Cyclops, ...)
#
# Every check this script owns - the agent CLI, asked of `agent-cli`, and the submodule carrying
# the role's agent file - exits 2 with one line on stderr naming what is wrong and the command that fixes
# it, the same exit code `launch` already uses for a usage error. Each of those lines is said by
# `launch-refused`, which also appends it to the consumer's .cerebro/state/errors.jsonl (cb-ccl):
# stderr alone goes to a vterm buffer that may die before it is drawn, and then a fleet that cannot
# start says so nowhere the navigator is told to look. The usage refusal above has no name to
# attribute and keeps its own line. The sync it runs
# afterwards is not one of those checks: a sync failure is sync-symlinks.sh's own to
# report, so its exit status and stderr come through unchanged, whatever they are.
set -euo pipefail

role="${1:-}"
name="${2:-}"
if [[ -z "$role" || -z "$name" ]]; then
  echo "usage: launch-preflight <role> <name>" >&2
  exit 2
fi

# Resolved before the first refusal rather than after the agent-cli check: every refusal this script
# owns is said and recorded by `launch-refused` (cb-ccl), which lives beside it.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

# Which agent CLI this fleet runs on, and whether it can be launched at all, is `agent-cli`'s
# answer and no longer spelt here (cb-d59.2): it refuses an undeclarable provider and a missing
# binary, saying and recording both through `launch-refused` itself, and exits 3. This turns that
# into the 2 every other refusal in this file uses - `launch-refused` always exits 0, so the code
# does not propagate on its own.
#
# It keeps its position, FIRST, before `consumer-root`: outside a consumer `project-conf` resolves
# no root, `agent-cli` answers `claude`, and the PATH check behaves exactly as it did.
"$script_dir/agent-cli" --check "$name" || exit 2

# The launch path's hint first (cb-ue0): `launch' has already resolved this and exported it, and
# every fork of `consumer-root' below this line was a re-derivation of the same answer. It is
# validated against this checkout before it is believed - see scripts/root-hints.sh - so a hint
# left over from a shell that was last inside another worktree is ignored rather than followed.
source "$script_dir/root-hints.sh"
consumer="$(cerebro_hinted_root "$script_dir/.." plain)" \
  || consumer="$("$script_dir/consumer-root" 2>/dev/null)" || exit 0
parent="$consumer/.claude"                                    # .claude, in a consumer
# consumer-root alone would accept a standalone clone sitting at e.g. ~/.claude/cerebro (the
# layout it checks for is satisfied by construction) - require that $consumer is also a git
# working tree's own toplevel, which a mere ~/.claude is not.
[[ "$(git -C "$consumer" rev-parse --show-toplevel 2>/dev/null)" == "$consumer" ]] || exit 0

# The declarations moved from .claude/ to .cerebro/ (cb-epr). A consumer that bumps the submodule
# past that move and leaves one behind is stopped here, first and friendliest - and this is the ONLY
# place a stray `cerebro-traps.md' can be caught at all, since no script reads it: a planner and an
# implementer read it as prose, so a file left behind would simply go unread, in silence, for ever.
#
# It refuses even when the new file exists too: two copies of one declaration is exactly the
# ambiguity worth one `rm' before anything starts.
for pair in "cerebro-project.conf:project.conf" "cerebro-roster:roster.conf" "cerebro-traps.md:traps.md"; do
  old_name="${pair%%:*}"
  new_name="${pair#*:}"
  if [[ -f "$parent/$old_name" ]]; then
    "$script_dir/launch-refused" "$name" "the declarations moved to .cerebro/ - run: mv .claude/$old_name .cerebro/$new_name before starting $name"
    exit 2
  fi
done

# The tree these instructions are read from - CLAUDE.md, and the skills, which are symlinks into
# whatever the submodule is pinned to here - is never refreshed by anything (ah-puoj). A session
# started on a stale one describes a repository that no longer exists and cannot find that out. So
# bring the checkout current when that can be done without writing over anybody's work, and refuse
# when it cannot. This runs *before* the agent-file check below on purpose: a stale submodule is why
# that check fires today, and its own message says so, so refreshing first turns that failure into a
# success rather than a second error.
#
# Untracked files never block this: the consumer routinely carries some, and refusing on them would
# refuse every launch.
# The branch is resolved, never assumed: on a consumer whose branch is `trunk` the old
# `fetch origin main` failed, `|| true` swallowed it, $target stayed empty and this entire block was
# skipped - so launches kept working while ah-puoj's guarantee had silently stopped holding.
branch_name="$("$script_dir/default-branch" 2>/dev/null)" || branch_name=""
[[ -n "$branch_name" ]] || branch_name="main"

# OFFLINE IS NOT STALENESS, but "origin has no such branch" is not offline either, and telling them
# apart is the other half of the fix: renaming alone would leave a misconfigured consumer unguarded
# in exactly the same silence, one layer further in. So a failed fetch asks whether origin was
# reachable at all - if it was, the branch is the problem and it is said out loud.
target=""
if git -C "$consumer" fetch --quiet origin "$branch_name" 2>/dev/null; then
  target="$(git -C "$consumer" rev-parse --verify --quiet FETCH_HEAD 2>/dev/null || echo "")"
fi
if [[ -z "$target" ]] && git -C "$consumer" ls-remote --quiet origin >/dev/null 2>&1; then
  "$script_dir/launch-refused" "$name" "origin has no branch $branch_name, so the checkout could not be checked for staleness - set default_branch in .cerebro/project.conf before starting $name"
fi
# Both sides are expanded before the test is evaluated, so `rev-parse HEAD` runs even when $target
# is empty - hence the separate guard rather than one && condition, for a consumer with no commits.
head=""
[[ -n "$target" ]] && head="$(git -C "$consumer" rev-parse --verify --quiet HEAD 2>/dev/null || echo "")"
if [[ -n "$target" && -n "$head" && "$head" != "$target" ]]; then
  branch="$(git -C "$consumer" rev-parse --abbrev-ref HEAD)"
  ahead="$(git -C "$consumer" rev-list --count "$target..HEAD" 2>/dev/null || echo 0)"
  behind="$(git -C "$consumer" rev-list --count "HEAD..$target" 2>/dev/null || echo 0)"
  if [[ "$branch" != "$branch_name" ]]; then
    "$script_dir/launch-refused" "$name" "the checkout is on branch $branch, not $branch_name - the fleet's instructions are read from $branch_name; switch back before starting $name"
    exit 2
  fi
  if [[ -n "$(git -C "$consumer" status --porcelain --untracked-files=no)" ]]; then
    "$script_dir/launch-refused" "$name" "the checkout is $behind commits behind origin/$branch_name and has uncommitted changes - commit or stash them, then git merge --ff-only origin/$branch_name, before starting $name"
    exit 2
  fi
  if [[ "$ahead" != "0" ]]; then
    "$script_dir/launch-refused" "$name" "$branch_name has $ahead commits origin/$branch_name does not - push or reset them before starting $name"
    exit 2
  fi
  # The submodule is the file the skills are actually read through, so it moves with the branch - but
  # somebody editing cerebro in place (which is how this check was built) must never be clobbered.
  if [[ -d "$parent/cerebro/.git" || -f "$parent/cerebro/.git" ]] \
     && [[ -n "$(git -C "$parent/cerebro" status --porcelain --untracked-files=no)" ]]; then
    "$script_dir/launch-refused" "$name" ".claude/cerebro has uncommitted changes - commit or stash them before starting $name"
    exit 2
  fi
  git -C "$consumer" merge --ff-only "$target" --quiet
  git -C "$consumer" submodule update --init --recursive --quiet
fi

# A role cerebro does not ship is not the same failure as a submodule that is behind, and saying
# the second when the first happened sends the navigator to a command that cannot help (ah-qled.5.1).
# Three cases:
#   the consumer supplies .claude/agents/<role>.md   - a consumer-only role; nothing is wrong
#   the consumer's own roster declares the role      - it owes an agent file, and is told so
#   neither                                          - the submodule really is behind
if [[ ! -f "$parent/cerebro/agents/$role.md" && ! -f "$parent/agents/$role.md" ]]; then
  declared_by_consumer=""
  if [[ -s "$consumer/.cerebro/roster.conf" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      case "$line" in \#*) continue ;; esac
      read -r _ row_role _ <<<"$line"
      [[ "$row_role" == "$role" ]] && { declared_by_consumer=1; break; }
    done < "$consumer/.cerebro/roster.conf"
  fi
  if [[ -n "$declared_by_consumer" ]]; then
    "$script_dir/launch-refused" "$name" ".cerebro/roster.conf declares the role $role, but cerebro does not ship agents/$role.md and there is no .claude/agents/$role.md either - write that file before starting $name"
  else
    "$script_dir/launch-refused" "$name" ".claude/cerebro/agents/$role.md is missing - the submodule is behind; run git submodule update --init --recursive and try again"
  fi
  exit 2
fi

# An implementer with no gate has nothing to run before it opens a PR (ah-qled.7.1). `implement-bead'
# names no tool any more - it says "run the fast gate", which is `gate_fast' in the consumer's own
# tracked .cerebro/project.conf - so a project that declares none, and in which none can be
# detected, would have its implementers improvising a gate and reporting green off it. Refuse at
# launch instead, loudly and immediately, naming the gate rather than the submodule (ah-qled.5.1).
#
# ONLY an implementer. A planner, a verifier or the orchestrator has no gate to run, and refusing
# them would take the whole fleet down over a key that does not concern them. The role IS the kind
# here: `roster' derives `implementer' from exactly this value and nothing else, so asking it again
# would only add a second place for the two to disagree.
if [[ "$role" == "implementer" ]]; then
  gate_fast="$("$script_dir/project-conf" gate_fast 2>/dev/null)" || gate_fast=""
  if [[ -z "$gate_fast" ]]; then
    "$script_dir/launch-refused" "$name" "this project declares no fast gate, and none could be detected - an implementer has nothing to run before it opens a PR. Add a line like 'gate_fast <command>' (and 'gate_full <command>') to .cerebro/project.conf before starting $name"
    exit 2
  fi
fi

"$script_dir/sync-symlinks.sh" >/dev/null

# Defensive only: after a successful sync above, the link this checks for cannot be
# missing unless the sync itself is broken - there is no test for this branch.
#
# Where to look is the DECLARED provider's business (cb-d59.4): the sync writes every layout, but
# only one of them is where the CLI about to be exec'd will look, and checking the other would pass
# while that CLI found nothing. Both facts come from agent-cli - the provider from the bare verb,
# its discovery paths from --layouts - so no path is spelt here.
declared_cli="$("$script_dir/agent-cli" 2>/dev/null)" || declared_cli=""
agents_dir="" agent_suffix=""
while IFS=$'\t' read -r layout_p layout_ad _ layout_sx; do
  [[ "$layout_p" == "$declared_cli" ]] || continue
  agents_dir="$layout_ad"; agent_suffix="$layout_sx"
  break
done < <("$script_dir/agent-cli" --layouts)

if [[ -n "$agents_dir" && ! -f "$consumer/$agents_dir/$role$agent_suffix" ]]; then
  "$script_dir/launch-refused" "$name" "no agent definition at $agents_dir/$role$agent_suffix - run .claude/cerebro/scripts/sync-symlinks.sh and try again"
  exit 2
fi
