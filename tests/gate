#!/usr/bin/env bash
#
# This project's gate: what an implementer runs before it opens a pull request, and what the pull
# request is then judged by. The two are the same command here (`gate_fast' and `gate_full' in
# .cerebro/project.conf both name this file) because the whole thing takes under a minute -
# a separate fast gate would only be worth having if the full one were slow.
#
# It runs exactly what .github/workflows/ci.yml runs - byte-compile, ERT, and every tests/*.sh
# through scripts/suite-runner, which both this file and CI call - and scripts/lint advises when the
# two stop agreeing. A gate that has drifted from CI is worse than no gate: the fleet merges on
# green that nobody else sees.
#
# It ends with scripts/lint, whose status it deliberately ignores: the lint guards decisions -
# prose and configuration - and a decision changing on purpose must not read as a regression
# (cb-194).
#
# NOT `tests/gate.sh'. scripts/suite-runner runs `tests/*.sh', which would pick this file up and run
# the gate from inside the gate, once per suite, forever.
#
#     bash tests/gate
set -uo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

status=0

echo "== byte-compile =="
if ! emacs --batch -L emacs -f batch-byte-compile emacs/cerebro.el; then
  echo "FAILED: byte-compile" >&2
  status=1
fi
# The .elc is removed whether or not it compiled: `-L emacs' prefers it over the source when it is
# newer, so leaving one behind means every later run of the tests - and every interactive `M-x
# cerebro' in this checkout - reads a stale compile of a file somebody is still editing.
rm -f emacs/cerebro.elc

echo "== ERT =="
if ! emacs --batch -L emacs -l cerebro-test -f ert-run-tests-batch-and-exit; then
  echo "FAILED: ERT" >&2
  status=1
fi

echo "== bash suites =="
# scripts/suite-runner is the one suite loop, and CI runs the same script (cb-8cn). It names each
# suite before it starts it - so a stall is "hung in tests/launchers.sh" rather than "the gate is
# hung" - replays a failing suite's output, and runs every suite even after one fails: a gate that
# stopped at the first failure would hide the others and the implementer would fix them one round
# trip at a time.
if ! bash scripts/suite-runner tests; then
  status=1
fi

echo "== lint (advisory) =="
bash scripts/lint || echo "lint: advisories above are not failures - a deliberate change updates scripts/lint in the same PR" >&2

if [[ $status -eq 0 ]]; then
  echo "gate: green"
else
  echo "gate: RED" >&2
fi
exit $status
