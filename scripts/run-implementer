#!/usr/bin/env bash
# `run-implementer <Name>` starts one implementer; `run-implementer --roster` prints the implementer
# names. Both are names for `scripts/launch` and `scripts/roster`, kept because the docs and the
# fleet view's callers know them. The one thing this shim adds is refusing a roster name that is not
# an implementer's, so `run-implementer Forge` does not start the architect by accident.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "--roster" ]]; then
  exec "$here/roster" --implementers
fi

name="${1:-}"
if [[ -z "$name" ]]; then
  echo "usage: run-implementer <name> | --roster" >&2
  "$here/roster" --implementers >&2
  exit 2
fi

if entry="$("$here/roster" --entry "$name" 2>/dev/null)" && [[ "${entry##*$'\t'}" != implementer ]]; then
  echo "run-implementer: $name is not an implementer - start it with .claude/cerebro/scripts/launch $name" >&2
  exit 2
fi

# The architect answered to Bishop until it was renamed (#38), and the old name will be typed for a
# while yet. "Not on the roster" is true and useless to somebody reaching for an agent that still
# exists under another name.
if [[ -z "$entry" ]]; then
  lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
  if [[ "$(lower "$name")" == "bishop" ]]; then
    echo "run-implementer: Bishop is now called Forge, and is the architect rather than an implementer - start it with .claude/cerebro/scripts/launch Forge" >&2
    exit 2
  fi
fi

exec "$here/launch" "$@"
