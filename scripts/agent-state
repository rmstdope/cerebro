#!/usr/bin/env bash
#
# Writes an agent's state file: .cerebro/state/<name>.state.json. Written by every agent on
# `scripts/roster` — implementers and interactive roles alike (the interactive ones since
# ah-2n3.2) - so cerebro.el derives a row the same way for all of them; it exists so the two
# timestamps below are handled by code rather than remembered by an agent an hour into a bead.
#
#     .claude/cerebro/scripts/agent-state <name> <state> [--bead <id>] [--phase <phase>] --pid <pid>
#
# <state> is one of: idle working asking waiting - the only field cerebro--supervise-action
# reads.
#   `waiting` is EVERY agent's end-of-pass state (cb-1or.1): the agent has finished a pass, ENDED
#             ITS TURN, and expects the fleet view to start a fresh session when there is another
#             pass to make. An implementer writes it when its bead is merged and closed, when it
#             hands one back, and when there was nothing to claim; the view starts it again when a
#             planned, unclaimed bead exists rather than on a clock.
#   `done`    was an implementer's older spelling of it, retired by cb-1or.2 and now refused like
#             any other unknown word.
#
# `waiting` takes no wake and the state file records none (cb-3tk). Cadence belongs to the fleet
# view alone - `cerebro-wake-interval' / `cerebro-wake-intervals' in emacs/cerebro.el, measured
# from an agent's last start - and has never read this file. Ending a pass is
# `scripts/end-pass <name> --pid <pid>', which calls this script.
# <phase>, only meaningful with `working` or `asking`, is any lower-case word: letters, digits and
# hyphens, starting with a letter. It is NOT a closed set - a consumer that adds a role of its own
# invents a word for it and this script must record it, which is what the old eighteen-way case
# prevented (ah-qled.5.2).
#
# The words THIS fleet uses are listed once, in `cerebro--phases' (emacs/cerebro.el), together with
# which role each belongs to. That list is a reference rather than a gate: the vocabulary is not
# checked per role - any word is accepted from any name - so a wrong word in the State column is
# still not worth a per-role table in bash.
# --pid is required and is never defaulted from this script's own parentage: pass the caller's
# $PPID (the claude process), not $$ (this script's own shell) - a guessed pid shows an agent
# as dead and starts a second session over it.
#
# `since` is the time of the last change of state or bead (unchanged meaning from before this
# script existed) - preserved across a phase-only change, reset when state or bead changes.
# `phase_since` is the time of the last change of phase; null when no --phase is given.
#
# Writes atomically (write to a .tmp file, then mv) so cerebro.el never reads a torn file.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The one place bash appends to an append-only JSONL log - see its header for why the append below
# cannot be a bare `printf'. Sourced at the top level, never inside the `|| true' group at the foot
# of this file: a missing or broken library must be a loud failure, not a swallowed one.
source "$script_dir/jsonl-log.sh"

usage() {
  echo "usage: agent-state <name> <idle|working|asking|waiting> [--bead <id>] [--phase <word>] --pid <pid>" >&2
  exit 2
}

name="${1:-}"
state="${2:-}"
[[ -n "$name" && -n "$state" ]] || usage
shift 2

bead=""
phase=""
phase_given=0
pid=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bead)
      bead="${2:-}"; shift 2 ;;
    --phase)
      phase="${2:-}"; phase_given=1; shift 2 ;;
    --pid)
      pid="${2:-}"; shift 2 ;;
    *)
      echo "agent-state: unknown argument '$1'" >&2
      exit 2 ;;
  esac
done

# The name must be on scripts/roster - the one list of the fleet.
if ! "$script_dir/roster" --entry "$name" >/dev/null 2>&1; then
  echo "agent-state: $name is not on the roster" >&2
  exit 2
fi

case "$state" in
  idle|working|asking) ;;
  waiting) ;;   # every agent's end-of-pass state since cb-1or.1 - see the header
  *)
    echo "agent-state: unknown state '$state' (idle|working|asking|waiting)" >&2
    exit 2 ;;
esac

if [[ $phase_given -eq 1 ]]; then
  # A shape, not a closed list (ah-qled.5.2): the words this fleet uses live in `cerebro--phases'
  # (emacs/cerebro.el), and a consumer's own role is free to invent one. What is still refused is a
  # malformed word, which is a typo rather than a vocabulary anyone chose.
  if [[ ! "$phase" =~ ^[a-z][a-z0-9-]*$ || "$phase" == *- ]]; then
    echo "agent-state: phase '$phase' is not a phase word (lower-case letters, digits and hyphens; see cerebro--phases in emacs/cerebro.el for the ones this fleet uses)" >&2
    exit 2
  fi
  # A phase is only meaningful with a bead in flight - writing one into an idle or waiting file would
  # leave the state file internally inconsistent (a phase with no bead being worked).
  case "$state" in
    working|asking) ;;
    *)
      echo "agent-state: --phase is only valid with working or asking, not '$state'" >&2
      exit 2 ;;
  esac
fi

if [[ -z "$pid" ]]; then
  echo "agent-state: --pid is required (pass \$PPID)" >&2
  exit 2
fi
if ! [[ "$pid" =~ ^[0-9]+$ ]]; then
  echo "agent-state: --pid is required (pass \$PPID)" >&2
  exit 2
fi

# The shared checkout every worktree of the repository has in common - never the enclosing tree,
# which from a bead worktree's own submodule copy is the worktree itself, not the main checkout
# the fleet view reads (ah-e0w). See scripts/consumer-root for the two roots and why they differ.
repo_root="$("$script_dir/consumer-root" --shared)"
out_dir="$repo_root/.cerebro/state"
mkdir -p "$out_dir"
out_file="$out_dir/$name.state.json"
tmp_file="$out_file.tmp"

# One reading of the clock, from which both timestamps below are derived. Two `date` calls would
# straddle a second boundary now and then, and `since` and `phase_since` are compared with one
# another - a skew there is a phase that reads as older than the state it belongs to.
now_epoch="$(date -u +%s)"

# `date -r <epoch>` is BSD/macOS and `date -d @<epoch>` is GNU; each rejects the other's form, so
# try both rather than assuming which fleet machine this is.
iso_at() {
  date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ
}

now="$(iso_at "$now_epoch")"

prev="$(jq -c '.' "$out_file" 2>/dev/null || true)"

prev_state="$(jq -r '.state // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_bead="$(jq -r '.bead // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_phase="$(jq -r '.phase // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_since="$(jq -r '.since // empty' <<<"${prev:-{}}" 2>/dev/null || true)"
prev_phase_since="$(jq -r '.phase_since // empty' <<<"${prev:-{}}" 2>/dev/null || true)"

if [[ -n "$prev_since" && "$prev_state" == "$state" && "$prev_bead" == "$bead" ]]; then
  since="$prev_since"
else
  since="$now"
fi

if [[ -z "$phase" ]]; then
  phase_since=""
elif [[ -n "$prev_phase_since" && "$prev_phase" == "$phase" ]]; then
  phase_since="$prev_phase_since"
else
  phase_since="$now"
fi

jq -n \
  --arg state "$state" \
  --arg phase "$phase" \
  --arg bead "$bead" \
  --arg since "$since" \
  --arg phase_since "$phase_since" \
  --arg pid "$pid" \
  '{
    state: $state,
    phase: (if $phase == "" then null else $phase end),
    bead: (if $bead == "" then null else $bead end),
    since: $since,
    phase_since: (if $phase_since == "" then null else $phase_since end),
    pid: ($pid | tonumber)
  }' > "$tmp_file"

mv -f "$tmp_file" "$out_file"

# --- The transition log (ah-hiib.1) -------------------------------------------------------------
# Every invocation appends one line to the shared, append-only .cerebro/state/transitions.jsonl,
# so the fleet keeps a record of what it did rather than only what it is doing. `changed` is true
# when state or bead differs from the previous file, which is what lets a reader tell "still
# working" (a run of changed:false lines) from "no longer reporting" (no lines at all). `from` is
# null on an agent's very first write: a fresh session is not a transition.
#
# The log is under .cerebro/, which is git-ignored, so it is LOCAL TO THIS MACHINE and does not
# survive a fresh clone. It is an operational record, not project history.
#
# Atomicity: `>>` opens with O_APPEND, so the kernel positions every write at the current end of
# file and two agents appending at once cannot overwrite one another; the line is built by a single
# `jq -c -n` and emitted by a single `printf`, so one line is one write(2) and cannot be split by
# another writer. That holds for the local disk the fleet runs on; it is not a promise about NFS.
#
# Deliberately last, and deliberately unable to fail: the state file above is what the fleet view
# reads, and an agent must never be brought down by a full disk or an unwritable log. The `|| true`
# under `set -e` is the point, not an oversight.
#
# It has a second effect, which is why the append is not a bare `printf`: `|| true` on a group makes
# that group the left side of an AND-OR list, and errexit is SUSPENDED FOR EVERY COMMAND INSIDE IT.
# So the `line="$(jq ...)"` below does not abort the block when `jq` fails - it would leave `line`
# empty and append a blank line. Hence the explicit `|| line=""` and `cerebro_jsonl_append`, which
# refuses a line that is not a JSON object; the rule itself lives in `scripts/jsonl-log.sh`.
log_file="$out_dir/transitions.jsonl"
log_max_bytes=5242880          # 5 MB, then one generation is kept as transitions.1.jsonl

# The whole block is skipped when the log lies in the protected directory (cb-xhu.1). The append
# below would be refused by the library anyway, but the rotation `mv` is OUTSIDE it: a suite that
# reached the real shared root and found transitions.jsonl over 5 MB would rotate the navigator's
# live log. The predicate sits in the `if` condition, where errexit is suspended - as a bare
# statement it would become this script's exit status whenever it is false.
if ! cerebro_jsonl_protected_path "$log_file"; then
{
  log_size="$(wc -c < "$log_file" 2>/dev/null | tr -d ' ' || true)"
  if [[ -n "${log_size:-}" && "$log_size" -gt "$log_max_bytes" ]]; then
    mv -f "$log_file" "$out_dir/transitions.1.jsonl"
  fi

  changed=false
  if [[ "$prev_state" != "$state" || "$prev_bead" != "$bead" ]]; then
    changed=true
  fi

  line="$(jq -c -n \
    --arg ts "$now" \
    --arg agent "$name" \
    --arg from "$prev_state" \
    --arg to "$state" \
    --arg phase "$phase" \
    --arg bead "$bead" \
    --arg pid "$pid" \
    --argjson changed "$changed" \
    '{
      ts: $ts,
      agent: $agent,
      from: (if $from == "" then null else $from end),
      to: $to,
      phase: (if $phase == "" then null else $phase end),
      bead: (if $bead == "" then null else $bead end),
      pid: ($pid | tonumber),
      changed: $changed
    }')" || line=""

  cerebro_jsonl_append "$log_file" "$line"
} 2>/dev/null || true
fi
