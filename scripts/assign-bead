#!/usr/bin/env bash
#
# Hand a bead to an implementer or a planning role before its session starts (cb-10d.1, cb-10d.2.1):
#
#     .claude/cerebro/scripts/assign-bead <Name> <id>
#
#   exit 0  the bead is claimed for / assigned to NAME (newly, or it already was)
#   exit 1  `bd` failed (its stderr passed through)
#   exit 2  usage, NAME not on the roster, or NAME's role is none of the four below
#   exit 3  the bead is not available to NAME: not in the role's queue and not already NAME's, or
#           a planning role lost the assignment race (`bd update --if-assignee ""` exited 13)
#   exit 4  an implementer's worktree could not be made: `disk-preflight` refused, the path holds
#           something that is not a worktree, or `prepare-worktree` failed (cb-10d.3)
#
# THE WORKTREE (cb-10d.3). For an implementer only, this script makes the tree the session works in:
# `.cerebro/worktrees/<id>` on branch `<id>` (or the first free `<id>-N`), by `prepare-worktree`,
# after `disk-preflight` passed with the plan's workload (`non-rust` only when the plan says
# `disk-preflight --workload non-rust`). A registered tree already at that path - an earlier
# attempt's, kept because it held work - is adopted. The tree is recorded, owner's name inside, in
# `.cerebro/state/worktrees/<id>`, and `release-bead --worktree` is what removes it. The preflight
# runs before the claim, so a refusal claims nothing; the tree is made after the claim and the
# handover file, so a view that dies during a long install still gives the bead back.
#
# Which queue, and how the bead is taken, is decided by ROLE:
#
#   implementer   `assignable-beads`               claimed (`--claim`); NAME's when in_progress
#   planner       `plan-candidates`                assigned; NAME's when open with assignee NAME
#   ux            `stage-candidates ux`            assigned, likewise
#   build-design  `stage-candidates build-design`  assigned, likewise
#
# A planning role's bead is NEVER claimed: `in_progress` means "being built" to Moira, Psylocke and
# `work-beads`, and a bead being designed is not being built. `scripts/release-bead` clears that
# assignee again.
#
# `scripts/launch <Name> --bead <id>` is its caller, after `launch-preflight` and before the agent
# CLI is exec'd; so the fleet view and a hand-typed launch take the same path. The claim is made
# with `--actor NAME`, because `--claim` sets the assignee to the actor, and without it the bead
# would belong to whoever ran the view.
#
# THE HANDOVER FILE. `.cerebro/state/<Name>.handover` holds the id, and means "handed, not yet
# reported". This script writes it (before the push, so a view that restarts during a slow push
# still finds it); `scripts/agent-state` removes it on the agent's first write; and
# `scripts/release-bead` removes it when the bead is given back.
#
# The push is advisory and never decides the exit status (.cerebro/traps.md, first entry).
#
# --GIVEN (cb-10d.5). `assign-bead --given <Name> <id>` is the fleet view's Work-pane `a` key, and
# that key is its only caller. It writes the handover with a second line, `given`, which tells the
# supervising view to START the named agent on that bead rather than treat the handover as an orphan,
# and on exit 0 it prints exactly one word on stdout: `pushed` (pushed, or nothing to push) or
# `unpushed` (`bd dolt push` failed). Without the flag stdout stays empty, because `launch` runs this
# script inside the session's pty; and `launch --bead` calls it without the flag, so the start
# rewrites a given handover as the bare id. Exit codes and stderr are the same either way.

set -euo pipefail

usage() {
  echo "usage: assign-bead [--given] <Name> <id>" >&2
  exit 2
}

given=""
if [[ "${1:-}" == "--given" ]]; then
  given=1
  shift
fi
[[ $# -eq 2 && -n "$1" && -n "$2" ]] || usage
name="$1"
id="$2"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/state-write.sh"

if ! entry="$("$script_dir/roster" --entry "$name" 2>/dev/null)"; then
  echo "assign-bead: $name is not on the roster" >&2
  exit 2
fi
IFS=$'\t' read -r _ role kind <<<"$entry"
# By ROLE, not kind: `planner', `ux', `build-design' and `orchestrator' all share the kind
# `interactive'. `candidates' is the role's own queue; `mode' is how the bead is taken.
case "$role" in
  implementer)  candidates=("$script_dir/assignable-beads");              mode=claim ;;
  planner)      candidates=("$script_dir/plan-candidates");               mode=assign ;;
  ux)           candidates=("$script_dir/stage-candidates" ux);           mode=assign ;;
  build-design) candidates=("$script_dir/stage-candidates" build-design); mode=assign ;;
  *)
    echo "assign-bead: $name is a $role; only implementers and the planning roles are handed a bead" >&2
    exit 2 ;;
esac
if [[ "$mode" == claim ]]; then
  mine_status=in_progress; verb="claimed for"
else
  mine_status=open; verb="assigned to"
fi

root="$("$script_dir/consumer-root" --shared)"
state="$root/.cerebro/state"
mkdir -p "$state"

write_handover() {
  if [[ -n "$given" ]]; then
    cerebro_state_write_atomic "$state/$name.handover" printf '%s\ngiven\n' "$id"
  else
    cerebro_state_write_atomic "$state/$name.handover" printf '%s\n' "$id"
  fi
}

if ! shown="$(bd -C "$root" show "$id" --json)"; then
  exit 1
fi
if ! fields="$(printf '%s' "$shown" \
      | jq -r '(if type=="array" then .[0] else . end) | "\(.status // "")\t\(.assignee // "")"')"; then
  echo "assign-bead: bd show $id did not print JSON this script can read" >&2
  exit 1
fi
IFS=$'\t' read -r status assignee <<<"$fields"

if [[ "$mode" == claim ]]; then
  # `worktree list` prints physical paths, so the root is compared physically.
  root_p="$(cd "$root" && pwd -P)"
  tree="$root_p/.cerebro/worktrees/$id"
  records="$state/worktrees"
  mkdir -p "$records"
  if ! list="$(git -C "$root" worktree list --porcelain)"; then
    exit 1
  fi
  registered=false
  if printf '%s\n' "$list" | grep -Fxq "worktree $tree"; then
    registered=true
  fi
  if [[ -e "$tree" ]] && ! $registered; then
    echo "assign-bead: $tree exists and is not a worktree - it needs a person" >&2
    exit 4
  fi
fi

# Make or adopt NAME's tree for ID and record it. Exit 4 on failure, having removed any tree this
# call created.
ensure_tree() {
  local branch n prep_status
  if [[ -e "$tree" ]]; then
    # An earlier attempt's tree, kept because it held work. Adopt it; the touch makes the watcher's
    # stale-minutes rule hold it while the agent starts.
    touch "$tree"
  else
    branch="$id"; n=2
    while git -C "$root" show-ref --verify --quiet "refs/heads/$branch" \
       || git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$branch"; do
      branch="$id-$n"; n=$((n + 1))
    done
    prep_status=0
    "$script_dir/prepare-worktree" --path "$tree" --branch "$branch" >&2 || prep_status=$?
    if [[ $prep_status -ne 0 ]]; then
      # Forced, unlike everywhere else in this family, and safe: this call made the tree seconds ago
      # and no agent has run in it.
      git -C "$root" worktree remove --force "$tree" >/dev/null 2>&1 || rm -rf "$tree"
      git -C "$root" worktree prune >/dev/null 2>&1 || true
      git -C "$root" branch -D "$branch" >/dev/null 2>&1 || true
      echo "assign-bead: prepare-worktree failed for $id (exit $prep_status)" >&2
      exit 4
    fi
  fi
  cerebro_state_write_atomic "$records/$id" printf '%s\n' "$name" || exit 1
}

if [[ "$status" == "$mine_status" && "$assignee" == "$name" ]]; then
  # Already NAME's. An agent that has already reported this bead must not acquire a handover a later
  # give-back would act on.
  reported=""
  if [[ -f "$state/$name.state.json" ]]; then
    reported="$(jq -r '.bead // empty' "$state/$name.state.json" 2>/dev/null || true)"
  fi
  if [[ "$reported" != "$id" ]]; then
    write_handover || exit 1
  fi
  if [[ "$mode" == claim ]]; then
    ensure_tree
  fi
  echo "assign-bead: $id is already $verb $name" >&2
  if [[ -n "$given" ]]; then echo pushed; fi
  exit 0
fi

if ! assignable="$("${candidates[@]}")"; then
  exit 1
fi
if ! printf '%s' "$assignable" | jq -e --arg id "$id" 'any(.[]; .id == $id)' >/dev/null; then
  echo "assign-bead: $id is not available to $name ($status, assignee ${assignee:-none})" >&2
  exit 3
fi

if [[ "$mode" == claim ]] && ! $registered; then
  workload=rust
  if printf '%s' "$shown" \
       | jq -r '(if type=="array" then .[0] else . end) | .design // ""' \
       | grep -Fq 'disk-preflight --workload non-rust'; then
    workload=non-rust
  fi
  if ! "$script_dir/disk-preflight" --workload "$workload"; then
    echo "assign-bead: disk-preflight refused - $name was not handed $id" >&2
    exit 4
  fi
fi

if [[ "$mode" == claim ]]; then
  if ! bd --actor "$name" -C "$root" update "$id" --claim; then
    exit 1
  fi
else
  # `--if-assignee' cannot be combined with `--claim', which is why the implementer keeps its own
  # write. Captured, not bare: under `set -e' a bare call would end the script with 1 before 13
  # could be mapped to 3 (.cerebro/traps.md, first entry).
  update_status=0
  bd --actor "$name" -C "$root" update "$id" --assignee "$name" --if-assignee "" || update_status=$?
  if [[ $update_status -eq 13 ]]; then
    echo "assign-bead: $id was taken by somebody else before $name could have it" >&2
    exit 3
  elif [[ $update_status -ne 0 ]]; then
    exit 1
  fi
fi

write_handover || exit 1

pushed=pushed
if [[ "$mode" == claim ]]; then
  ensure_tree
fi

bd -C "$root" dolt push \
  || { echo "assign-bead: $id is $verb $name, but bd dolt push failed - other machines will not see it yet" >&2; pushed=unpushed; }

echo "assign-bead: $id is $verb $name" >&2
if [[ -n "$given" ]]; then echo "$pushed"; fi
exit 0
