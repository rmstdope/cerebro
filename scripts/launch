#!/usr/bin/env bash
#
# `launch <Name> [claude args...]` is the only place a session is started and the only place
# `BEADS_ACTOR`, `launch-preflight` and the model/effort come together. It is also the only *way*:
# the seven `run-*` shims that used to name it are gone (ah-qled.5.3). They were kept "because the
# docs and the navigator's fingers know them", and both halves of that had stopped being true — the
# fleet view calls this script by name for every agent, and the documentation had drifted onto
# a shim named for the architect's retired name, which had not existed since that rename.
#
# So an agent is named, never a role, and who exists is `scripts/roster` and nothing else. A name
# that is not on it is refused here, with the roster's own names printed — including a name this
# fleet has retired, which gets no courtesy redirect: the roster is the answer to who exists.
#
# The prompt below deliberately restates nothing about the role: the agent definition
# (`agents/<role>.md`) is the instruction, and a second copy here is exactly what went stale before.
#
# **This starts one interactive session and nothing else.** It does not loop, it reads no flags, and
# it writes no files — the one exception is the skill and agent symlinks under .claude/, which
# `launch-preflight` re-syncs right before exec (ah-cuc), refusing with one line rather than exiting
# silently if the agent CLI is not on PATH or the submodule never brought the role's agent file in
# (ah-bri).
#
# Since cb-d59.2 this file spells no provider flag at all: which CLI a session runs on, and every
# argv token between the binary and the caller's own arguments, is `scripts/agent-cli`'s answer.
# What each arm does with a name, a model, a marker sentence and a settings path - Remote Control
# included (ah-qym) - lives there, in one place, so a second provider is an arm rather than a
# rewrite of this file and `launch-preflight`.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The consumer roots, resolved ONCE and handed to everything below (cb-ue0).
#
# This is the top of the launch path, and everything under it - `roster', `launch-preflight', and
# through that `default-branch', `project-conf', `agent-cli' and `sync-symlinks.sh' - used to fork
# `consumer-root' again for itself: sixteen resolutions of one unchanging answer before a session
# ever started, a third of a second on every launch and most of tests/launchers.sh's own runtime.
# One `--hints' call answers all three, and the exports carry them down the whole process tree,
# including into the session itself. Every reader validates them against its own checkout before
# believing them - see scripts/root-hints.sh - so they can only ever save work.
#
# Guarded, and left unset when there is none: this launcher runs from outside a consumer in the
# tests, and everything below that needs a root checks first.
if hints="$("$here/consumer-root" --hints 2>/dev/null)"; then
  # `read', not `sed -n 1p' three times: tests/launchers.sh runs a launcher with a PATH holding
  # `dirname' and `bash' alone, so nothing on this path may reach for an external command.
  { IFS= read -r CEREBRO_CONSUMER_ROOT
    IFS= read -r CEREBRO_CONSUMER_SHARED_ROOT
    IFS= read -r CEREBRO_CONSUMER_MOUNT; } <<<"$hints"
  export CEREBRO_CONSUMER_ROOT CEREBRO_CONSUMER_SHARED_ROOT CEREBRO_CONSUMER_MOUNT
fi

# The environment cargo left behind, cleared before anything else runs (cb-6fu).
#
# `scripts/cerebro-tui' execs `cargo run', so the Ratatui fleet view is a CHILD OF CARGO and hands
# its own environment to every session it spawns - cargo's eighteen injected variables, plus every
# key of the `[env]' table in whatever .cargo/config.toml cargo discovered from the CONSUMER's root.
# In atlantis-hud that meant TS_RS_EXPORT_DIR pointing at the navigator's shared checkout, so every
# agent's `cargo test' wrote its generated bindings there (ah-79ca, ah-16pb). An agent's own cargo
# re-applies every one of those the moment it runs, from the config in ITS worktree, which is where
# the values were always supposed to come from.
#
# HERE, and not lower down, so everything this launcher itself spawns - `roster', `launch-preflight'
# and through it `project-conf', `agent-cli', `agents-conf' and `sync-symlinks.sh' - is already running
# in the cleaned environment, not only the agent CLI. `scripts/cargo-env.sh' is the whole of the rule
# (which names, and which are protected); this is its only caller.
source "$here/cargo-env.sh"
# NOT `$(...)' and NOT `while read ... < <(...)': `unset' takes effect in the shell that runs it, so
# consuming this function's stdout would run the whole strip in a subshell and clear nothing, while
# printing a convincing list of what it had not done. The arrays are how a caller in this shell
# learns what went; see the library's header.
cerebro_strip_cargo_env "${CEREBRO_CONSUMER_SHARED_ROOT:-}" >/dev/null

# One line on stderr, only when something went - this file's own habit, for the reason it gives
# about agents.conf: a session behaving oddly three days later is otherwise a mystery. The CARGO_*
# family is counted rather than spelled out (eighteen lines of noise on every launch); the config
# names are listed, because that is the half a navigator cannot guess.
_cleared_cargo=${#cerebro_cargo_stripped_injected[@]}
_cleared_names=""
for _name in ${cerebro_cargo_stripped_config+"${cerebro_cargo_stripped_config[@]}"}; do
  _cleared_names="${_cleared_names:+$_cleared_names, }$_name"
done
unset _name
if [[ $_cleared_cargo -gt 0 || -n $_cleared_names ]]; then
  _clause=""
  if [[ $_cleared_cargo -eq 1 ]]; then
    _clause="1 CARGO_* variable"
  elif [[ $_cleared_cargo -gt 1 ]]; then
    _clause="$_cleared_cargo CARGO_* variables"
  fi
  if [[ -n $_cleared_names ]]; then
    _clause="${_clause:+$_clause and }$_cleared_names"
  fi
  echo "launch: cleared $_clause from the environment cargo left behind." >&2
  unset _clause
fi
unset _cleared_cargo _cleared_names

# The listing is a courtesy; the exit status is the contract. Under `set -euo pipefail' a failing
# `roster' here would end the script AT the listing and the `exit 2' below would never run, leaving
# a refusal with status 1 where it documents 2 - a difference no output shows, which is why it read
# as flakiness for a whole gate run. Every ADVISORY use is therefore guarded; the misspelling scan
# below reads it through a process substitution, which never tripped errexit.
names() { "$here/roster" | while IFS=$'\t' read -r n _ _; do printf '%s\n' "$n"; done; }

# The listing is a courtesy; the exit status is the contract (see above). When the courtesy fails,
# say the status - roster's own reason, if it had one, is already on stderr immediately above this
# line, because nothing here redirects it. A parenthesis telling a human to re-run the script by
# hand is what the second sighting of this left behind (docs/retrospectives/cb-azi.md), and off the
# loaded run it answers fine.
#
# `names >&2 || status=$?' is exempt from errexit (left operand of `||'), and the `if' is this
# function's last statement so its status is 0 either way - both deliberate; see .cerebro/traps.md,
# "An advisory step can eat the exit status that follows it".
list_names() {
  local status=0
  names >&2 || status=$?
  if [[ $status -ne 0 ]]; then
    echo "launch: the roster listing failed with status $status - roster's own reason, if it gave one, is above." >&2
  fi
}

usage() {
  echo "usage: launch <Name> [agent CLI args...]" >&2
  list_names
  exit 2
}

name="${1:-}"
[[ -n "$name" ]] || usage
shift

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# Status 2 is roster's documented "this name is not on the roster" and is handled below; ANY other
# non-zero status means roster could not answer at all, which is a different thing and used to be
# indistinguishable here - the name simply read as absent. `2>&1' is safe because roster prints
# nothing on stderr when it succeeds, an invariant tests/launchers.sh asserts.
entry=""
entry_status=0
entry="$("$here/roster" --entry "$name" 2>&1)" || entry_status=$?

if [[ $entry_status -ne 0 && $entry_status -ne 2 ]]; then
  if [[ -n "$entry" ]]; then
    printf '%s\n' "$entry" >&2
  fi
  echo "launch: could not read the roster (status $entry_status) - refusing to start $name." >&2
  exit 2
fi

if [[ $entry_status -eq 2 ]]; then
  # On 2 the capture holds roster's own refusal line rather than a row, and it is discarded: launch
  # says its own refusal, as it always has.
  misspelt=""
  while IFS= read -r row_name; do
    if [[ "$(lower "$row_name")" == "$(lower "$name")" ]]; then
      misspelt="$row_name"
      break
    fi
  done < <(names)
  if [[ -n "$misspelt" ]]; then
    echo "launch: it is spelt $misspelt, not $name" >&2
  else
    echo "launch: $name is not on the roster" >&2
    list_names
  fi
  exit 2
fi

IFS=$'\t' read -r _ role kind <<<"$entry"

# Every bd call in this session acts as this agent, not as the machine's git identity. Distinct
# actors are what make a second claim on a held bead fail instead of aliasing into the first (bd's
# --actor default chain: $BEADS_ACTOR, git user.name, $USER).
export BEADS_ACTOR="$name"

# Where this fleet lives - the shared root resolved at the top of this file. Empty when there is
# none, or when the consumer is not a git working tree (`--hints' leaves that line blank), which is
# exactly what `consumer-root --shared' used to answer by failing.
consumer_root="${CEREBRO_CONSUMER_SHARED_ROOT:-}"

# A name whose session is already alive in this fleet is refused: two sessions of one name is the
# one thing the fleet view cannot see - the newer overwrites the state file with its own pid and
# the older disappears from every reading - and the terminal was the way it happened. `agent-alive`
# applies the same rule `cerebro--session-alive-p` does, pid and name and this consumer's root, so
# the view's own restart, which deletes the state file before it launches, is never refused here.
if [[ -n "$consumer_root" ]] && "$here/agent-alive" "$name" 2>/dev/null; then
  pid="$(jq -r '.pid // "?"' "$consumer_root/.cerebro/state/$name.state.json" 2>/dev/null || echo '?')"
  # Said and recorded by `launch-refused` (cb-ccl): this is the one refusal of this script's the
  # fleet view can hit, so it is the one whose line must survive a vterm buffer that died before it
  # was drawn. The usage / not-on-the-roster / misspelt refusals above are terminal typos and keep
  # their own `launch:` lines.
  "$here/launch-refused" "$name" "$name is already running in this fleet (pid $pid); end it first"
  exit 2
fi

# The question-state hooks: this session's state file says `asking' for exactly as long as a
# question is in front of the navigator, and goes back to the state, bead and phase it had when the
# answer lands. See hooks/README.md - the agents are told to write both themselves, three ways over,
# and still asked under `working' and still left `asking' behind afterwards. One wiring for the
# whole fleet, here, for the same reason everything else in this file is here once.
. "$here/agent-hooks-env" "$name"

# The marker sentence's one bash spelling (cb-9su): this file writes it, `scripts/agent-alive' cuts
# its needles from it, and neither carries the text any more. See scripts/session-marker.sh.
source "$here/session-marker.sh"

# Which tool this agent runs on, and on which model at which effort, is `.cerebro/agents.conf's
# answer alone since cb-94y.2 - `scripts/agents-conf' is the one place that file is parsed and its
# precedence decided, and its header is where the shape and the four answer lines are written down.
# The agent definitions' frontmatter and `.cerebro/agents.conf' are both gone from this path: the
# first had carried no `model:' for some time, and the second is retired with `scripts/model-for'.
#
# `|| conf_status=$?' and not a bare capture: a refusal is exit 3, and `x="$(cmd)"' under `set -e'
# takes the substitution's status, so an unguarded capture would end this launcher BEFORE the
# refusal could be said (.cerebro/traps.md, "an advisory step can eat the exit status that follows
# it").
conf_out=""
conf_status=0
conf_out="$("$here/agents-conf" --name "$name" --role "$role")" || conf_status=$?

# Split on TAB by hand, and not with `IFS=$'\t' read -r a b c d e'. Tab is IFS *whitespace*, so a
# `read' folds a run of them into one delimiter: a hit whose model is empty and whose effort is not
# - `hit<TAB>key<TAB>tool<TAB><TAB>high' - arrives with the effort sitting in the model's variable,
# and the session then starts on a model called `high'. Five fields, every one of them possibly
# empty, is what this loop guarantees; builtins only, for the narrowed PATH.
conf_kind="" conf_a="" conf_b="" conf_c="" conf_d=""
_conf_rest="$conf_out"
for _conf_i in 1 2 3 4 5; do
  if [[ "$_conf_rest" == *$'\t'* ]]; then
    _conf_field="${_conf_rest%%$'\t'*}"
    _conf_rest="${_conf_rest#*$'\t'}"
  else
    _conf_field="$_conf_rest"
    _conf_rest=""
  fi
  case "$_conf_i" in
    1) conf_kind="$_conf_field" ;;
    2) conf_a="$_conf_field" ;;
    3) conf_b="$_conf_field" ;;
    4) conf_c="$_conf_field" ;;
    5) conf_d="$_conf_field" ;;
  esac
done

# An answer that is neither a hit, a miss nor a refusal is a REFUSAL of its own, never a miss: a
# fork that failed, a crash inside `agents-conf', a usage error a future caller introduces. Read as
# a miss, the session would start on the default tool with no model at all while saying the file
# names no line for this agent - a sentence about a file nobody managed to read, and a session
# running on settings nobody wrote, which is the one thing the agreed record forbids outright.
case "$conf_kind" in
  hit|miss|refused) ;;
  *)
    "$here/launch-refused" "$name" "agents.conf could not be read (agents-conf exited $conf_status) - fix it, or run .claude/cerebro/scripts/agents-conf --name $name --role $role to see why"
    exit 2
    ;;
esac

# Read BEFORE `launch-preflight', reversing the order `model-for' had: nothing downstream can be
# checked without the tool - `--check' has no binary to look for and the layouts match has no row to
# pick. The cost is that the `git merge --ff-only' inside the preflight can bring in an agents.conf
# newer than the one just read, and this session then runs on the previous line; the next start
# reads the new one.
tool="" model="" effort=""
if [[ "$conf_kind" == "hit" ]]; then
  tool="$conf_b" model="$conf_c" effort="$conf_d"
  # Said out loud on every start, without exception: a session on an unexpected model is otherwise a
  # mystery three days later, and this is the file nobody remembers editing. Plain double-quoted
  # strings and an `if' chain rather than `${x:+...}': the apostrophe in "$tool's own model and
  # effort" is a syntax error inside a ${x:-word} expansion under bash 3.2.
  if [[ -z "$model" && -n "$effort" ]]; then
    # The line named an effort and no model, so the effort IS passed - honouring what somebody wrote
    # is the rule - and the sentence says both halves. Saying "its own model and effort" here while
    # handing `--effort' to the CLI would be a sentence contradicting the argv, which is exactly the
    # mystery three days later this line exists to prevent.
    echo "launch: agents.conf (\"$conf_a\") -> $tool, $tool's own model at $effort effort" >&2
  elif [[ -z "$model" ]]; then
    echo "launch: agents.conf (\"$conf_a\") -> $tool, $tool's own model and effort" >&2
  elif [[ -n "$effort" ]]; then
    echo "launch: agents.conf (\"$conf_a\") -> $tool, $model at $effort effort" >&2
  else
    echo "launch: agents.conf (\"$conf_a\") -> $tool, $model" >&2
  fi
elif [[ "$conf_kind" == "refused" ]]; then
  # Said and recorded by `launch-refused' (cb-ccl), so the sentence reaches the fleet row even when
  # the vterm buffer died before it was drawn. Nothing between it and the `exit 2': an advisory
  # there could eat this status.
  "$here/launch-refused" "$name" "$conf_a"
  exit 2
else
  # A miss: no model and no effort at all, and the session runs on the tool's own defaults. Said out
  # loud, or a fleet nobody has configured looks exactly like one deliberately on defaults. Which of
  # the two sentences depends on whether there was a file to look in.
  tool="$("$here/agent-cli" --default-tool)"
  if [[ "$conf_a" == "no-file" ]]; then
    echo "launch: no agents.conf - $tool picks its own model and effort" >&2
  else
    echo "launch: agents.conf names no line for $name - $tool picks its own model and effort" >&2
  fi
fi

# ah-cuc: link whatever a submodule bump brought in, so the agent CLI finds the role by name.
# ah-bri: refuse with one line if it cannot, instead of exiting silently. The tool is passed: what
# it checks for is the CLI this session is about to start on, not a fleet-wide declaration.
"$here/launch-preflight" "$role" "$name" "$tool"

# Cerebro's own marker sentence: the WHOLE of the liveness rule since cb-d59.3, and the reason
# neither `cerebro--session-args-p' nor `scripts/agent-alive' contains a provider's spelling any
# more. It used to ride on `--settings' and then on `--append-system-prompt' (ah-ybsr, cmux having
# rewritten `--settings' into inline JSON); it now opens the PROMPT, which is the one argument
# every agent CLI accepts - Copilot has no `--append-system-prompt' and refuses a bare trailing
# prompt (docs/providers/copilot.md, M3/M12). Nothing goes dead on merge day: the sentence is
# byte-identical, so a session started by the previous launcher still carries it, and the rule
# reads the whole command line rather than one named flag's value. Guarded rather than
# unconditional because `consumer_root' is deliberately allowed to be empty - this launcher runs
# from outside a consumer in the tests.
#
# The trailing slash on the root is required: `cerebro--root-in-args-p' builds its needle as the
# root with one `/' appended, so that `/repos/atlantis-hud' does not match a sibling
# `/repos/atlantis-hud-hud'. Since cb-9su the normalisation and the text both live in
# `scripts/session-marker.sh', which is also where the no-apostrophe rule is recorded - this file
# and `scripts/agent-alive' can no longer disagree about the sentence, because neither spells it.
marker=""
if [[ -n "$consumer_root" ]]; then
  marker="$(cerebro_marker_sentence "$name" "$consumer_root")"
fi

# The marker leads the prompt, then exactly one blank line, then the instruction (cb-d59.3, Q1):
# the identity sits as early in the command line as it can, which is what the liveness rule reads.
# An `if' rather than `${marker:+...}' for this file's own bash-3.2 reason, and because the value
# carries newlines and a full stop.
instruction="You are $name. Your agent definition ($role) is the whole of your instructions: follow it from
the top, and start now rather than waiting to be spoken to."

prompt="$instruction"
if [[ -n "$marker" ]]; then
  prompt="$marker

$instruction"
fi

# Which agent CLI this session runs on, and every argv token it takes, is `scripts/agent-cli`'s
# answer and no longer spelt here (cb-d59.2). After this the only argv strings in this file are
# agent-cli's own interface - `--role', `--name', `--model', `--effort', `--settings',
# `--argv', `--prompt-argv', `--binary' - and not one of them is any provider's.
#
# NUL-separated and read through a PROCESS SUBSTITUTION, not a pipe: the prompt below carries an
# embedded newline, so a line-delimited protocol would split it into two argv entries, and
# `x | while read' would build the array in a subshell that is gone by the next line.
binary="$("$here/agent-cli" --binary --tool "$tool")"

argv=()
while IFS= read -r -d '' tok; do argv+=("$tok"); done < <(
  "$here/agent-cli" --argv --tool "$tool" --role "$role" --name "$name" \
    ${model:+--model "$model"} \
    ${effort:+--effort "$effort"} \
    --settings "$CEREBRO_HOOK_SETTINGS")

prompt_argv=()
while IFS= read -r -d '' tok; do prompt_argv+=("$tok"); done < <(
  "$here/agent-cli" --prompt-argv --tool "$tool" "$prompt")

# The caller's own arguments sit between the flags and the prompt, exactly where they used to: that
# is what makes a `--model' typed on the command line beat the one resolved above.
exec "$binary" "${argv[@]}" "$@" "${prompt_argv[@]}"
