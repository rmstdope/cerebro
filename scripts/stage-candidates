#!/usr/bin/env bash
#
# The one place the harness answers: "which beads may a UX agent take at all?" Prints a JSON array
# on stdout, sorted by priority ascending then by id, for a caller to pipe into `jq`.
#
#     .cerebro/cerebro/scripts/stage-candidates ux
#     .cerebro/cerebro/scripts/stage-candidates --print-stage-label
#     .cerebro/cerebro/scripts/stage-candidates --print-skip-label
#
# It grew out of the retired planner's `plan-candidates` (cb-lz5) and keeps its rules: the assignee
# hold, the assigned-parent hold and the blocker rule (cb-10d.2.1). The UX agent takes what is not
# yet `ux:agreed` and not filed `ux:none`; a blocker whose experience is `ux:agreed`, `ux:none` or
# `planned` is satisfied, since that is all a designer needs of it.
#
# It deliberately does NOT filter by priority: which candidate, and in what order, is policy the
# agent's own skill explains, and the call sites keep their one-line `jq` priority filter.
#
# `work-beads --status open` is where the whole EPIC question is answered, and routing through it is
# the entire point: it has owned that rule since cb-hzl - a childless epic is real work, one with a
# direct child is bookkeeping - and this script must add NO epic rule of its own. A second copy of
# that rule is what this script exists to end.
#
# Four jq traps, each of which fails silently if it is got wrong:
#
#   1. `index(...)` returns the POSITION, null when absent; in jq only null and false are falsy, so
#      a label at position 0 yields 0, which is TRUTHY. `index(x)` and `index(x) | not` are the
#      correct tests; a `has`/`contains` spelling gets exactly that case wrong.
#   2. A hold is an assignee and nothing else (cb-10d.2.2): a bead with a non-empty assignee has
#      been handed to an agent and is not a candidate. `bd`'s `--unassigned` is not used because
#      the list comes from `work-beads`, and an assignee of "" is read as none.
#   3. A blocker is unsatisfied when it is in the list and not satisfied, OR when any bead in the
#      list names it as `parent` and is not satisfied: `work-beads` drops a split bead that has
#      children, so without the second arm everything it blocks looks free while its children are
#      still unfinished. A blocker absent from the list otherwise counts as satisfied (closed and
#      in-progress rightly; `blocked` or `deferred` status as an accepted rare miss), and a parent
#      absent from the list holds nothing.
#   4. `bd list` calls the edge `type`; `bd show` calls it `dependency_type`. A filter copied from a
#      skill's `bd show` query matches nothing here, and every bead looks unblocked.
#
# It fails LOUDLY - non-zero, a message on stderr, nothing on stdout - when `work-beads` fails or
# prints something this script cannot filter. An empty array that really means "the query broke"
# would tell an agent its queue is empty, and an agent that believes it ends its pass.

set -euo pipefail

# The label that says a bead's experience is agreed (`stage_label`), and the one that says there is
# no experience to agree (`skip_label`, cb-uump), are spelled in `candidate-label-policy.sh` with
# every other routing label (cb-q6yb). A caller in another language asks for them through
# `--print-stage-label` and `--print-skip-label` rather than repeating them.
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/candidate-label-policy.sh"

usage() {
  echo "usage: stage-candidates ux | stage-candidates --print-stage-label | stage-candidates --print-skip-label" >&2
  exit 2
}

mode=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    # Answered before any root is resolved, so this works with no repository at all - exactly as
    # a contract test in
    # another language runs it where `consumer-root --shared` would refuse.
    --print-stage-label)
      # The whole call or nothing: a stage word beside it would be silently ignored, and a caller
      # that meant to ask for candidates would get the label and exit 0.
      [[ -z "$mode" && $# -eq 1 ]] || usage
      printf '%s\n' "$stage_label"; exit 0 ;;
    --print-skip-label)
      [[ -z "$mode" && $# -eq 1 ]] || usage
      printf '%s\n' "$skip_label"; exit 0 ;;
    ux)
      [[ -z "$mode" ]] || usage
      mode="$1"; shift ;;
    *)
      echo "stage-candidates: unknown argument '$1'" >&2
      usage ;;
  esac
done

[[ -n "$mode" ]] || usage

# Captured before the pipe rather than piped straight into `jq`, for this reason about the same
# call: under `pipefail` a `work-beads` failure inside a pipeline is this
# script's failure too, but this script must leave stdout EMPTY on a failure, and a pipeline that
# has already started writing cannot promise that.
if ! raw="$("$script_dir/work-beads" --status open)"; then
  echo "stage-candidates: work-beads failed - cannot list the candidates" >&2
  exit 1
fi

if ! out="$(printf '%s' "$raw" | jq -L "$script_dir" --arg mode "$mode" \
    --arg human "$human_label" \
    --arg stale "$stale_verdict_label" --arg verifier_only_label "$verifier_only_label" \
    --arg bugfix "$bugfix_label" --arg ui_question "$ui_question_label" \
    --arg plan_revise "$plan_revise_label" '
    include "candidate-label-policy";
    $ARGS.positional as $past
    | . as $all
    | (reduce $all[] as $b ({}; .[$b.id] = $b)) as $by_id
    | def held: ((.assignee // "") != "");
      def satisfied: past_ux($past);
      def unsatisfied_blocker($id):
        (($by_id[$id] // null) as $b | $b != null and ($b | satisfied | not))
        or any($all[]; .parent == $id and (satisfied | not));
      [ $all[]
        | select(past_ux($past)                  | not)
        | select((.labels // []) | index($human)  | not)
        | select((.labels // []) | index($stale)  | not)
        | without_verifier_only_label($verifier_only_label)
        | select((.labels // []) | index($bugfix) | not)
        | select(held | not)
        | select(((.labels // []) | index("verification:failed") | not)
                 or ((.labels // []) | index($plan_revise))
                 or ((.labels // []) | index($ui_question)))
        | select((($by_id[.parent // ""] // {}).assignee // "") == "")
        | select([ (.dependencies // [])[]
                   | select(.type == "blocks")
                   | select(unsatisfied_blocker(.depends_on_id)) ] | length == 0)
      ] | sort_by(.priority, .id)' --args "${past_ux_labels[@]}" 2>/dev/null)"; then
  echo "stage-candidates: the bead list is not JSON this script can filter" >&2
  exit 1
fi

printf '%s\n' "$out"
