#!/usr/bin/env bash
#
# Give back a bead the fleet view handed an implementer that never ran on it (cb-10d.1):
#
#     .cerebro/cerebro/scripts/release-bead <Name> <id>
#
# Prints EXACTLY ONE WORD on stdout and exits 0 for each of the four:
#
#   running    `agent-alive <Name>` succeeds - the session is up. Nothing is touched, not even the
#              handover file, so a session a navigator launched by hand is never unclaimed under it.
#   released   the bead was in_progress and NAME's, and `bd unclaim --if-assignee NAME` took it back;
#              or it was open and assigned to NAME - a planning role's assignment (cb-10d.2.1) - and
#              `bd update --assignee "" --if-assignee NAME` cleared the assignee without touching status
#   free       the bead is open with no assignee: nothing to unclaim, it is with the planned work
#   elsewhere  anything else - another agent holds it, it is closed, or the unclaim's or unassign's
#              compare-and-swap lost to somebody who took it meanwhile
#
#   exit 1  `bd` failed (including an unclaim that failed with the bead still NAME's)
#   exit 2  usage
#
# All four words exit 0 because the fleet view's command runner (`readers::RealCommands::run`)
# turns any non-zero exit into an error and throws stdout away.
#
# For released, free and elsewhere it removes `.cerebro/state/<Name>.handover` when that file names
# THIS bead, and leaves a handover for a different bead alone. `scripts/assign-bead` writes that
# file; `scripts/agent-state` removes it too.
#
# THE PUSH IS NOT ADVISORY (cb-10d.4), in any branch that wrote: a board write that is not pushed is
# a failed release, so a failed `bd dolt push` is one line on stderr and exit 1. A retry then finds
# the bead already given back or closed, and answers accordingly.
#
# THE ENDED MODE (cb-10d.4):
#
#     .cerebro/cerebro/scripts/release-bead --ended <Name> <id>
#
# Takes back what a session that is gone still holds. One line on stdout, exit 0 for each:
#
#   running        NAME is alive on this bead (the worktree mode's test). Nothing is touched.
#   released       the bead is open and assigned to NAME: the assignee is cleared, as above.
#   elsewhere      closed, somebody else's, open and unassigned, or a compare-and-swap lost.
#   kept it was reopened by a failed verification
#                  in_progress, NAME's, `verification:failed`: its old commits prove nothing.
#   retry          `git fetch` failed. Nothing is touched. Fetched only when a close is possible.
#   closed         in_progress, NAME's, and `scripts/bead-delivery.sh` finds its work on main:
#                  closed as NAME, with the fleet view named in the reason, and pushed.
#   kept its work is not on main
#                  in_progress, NAME's, not delivered. Nothing is written; it is Cerebro's.
#
#   exit 1  `bd show` or the close failed, or the push after a write     exit 2  usage
#
# THE WORKTREE MODE (cb-10d.3):
#
#     .cerebro/cerebro/scripts/release-bead --worktree <Name> <id>
#
# Removes `.cerebro/worktrees/<id>` - the tree `scripts/assign-bead` made for an implementer and
# recorded in `.cerebro/state/worktrees/<id>` - ONLY when nothing in it can be lost, by the
# pruner's own test (`scripts/worktree-safety.sh`). One line on stdout, exit 0 for each:
#
#   running        NAME is alive on this bead (its state file names it, or names nothing and its
#                  handover is absent or names it). Nothing is touched.
#   gone           no record, or a record naming somebody else - nothing of NAME's here, nothing
#                  touched; or NAME's record with the tree already absent - the record goes.
#   removed        clean and landed: the tree, its branch and the record are gone.
#   kept <reason>  the tree stays for a person, the record goes; the reason is on stderr too.
#   retry          `git fetch` failed: nothing touched, the record kept for the next attempt.
#
#   exit 1  git could not list the worktrees     exit 2  usage, or an id that is not a plain name
#
# Nothing here backgrounds a child: one holding the pipes open would turn a tidy into the view's
# whole timeout.

set -euo pipefail

usage() {
  echo "usage: release-bead <Name> <id>" >&2
  echo "       release-bead --worktree <Name> <id>" >&2
  echo "       release-bead --ended <Name> <id>" >&2
  exit 2
}

# NAME is alive and on bead ID: its state file names ID, or names nothing while its handover is
# absent or names ID. Reads $name, $id and $state.
alive_on_bead() {
  local current="" handed=""
  if ! "$script_dir/agent-alive" "$name" >/dev/null 2>&1; then
    return 1
  fi
  if [[ -f "$state/$name.state.json" ]]; then
    current="$(jq -r '.bead // empty' "$state/$name.state.json" 2>/dev/null || true)"
  fi
  if [[ -f "$state/$name.handover" ]]; then
    IFS= read -r handed < "$state/$name.handover" || true
  fi
  if [[ "$current" == "$id" ]]; then
    return 0
  fi
  if [[ -z "$current" && ( -z "$handed" || "$handed" == "$id" ) ]]; then
    return 0
  fi
  return 1
}

# Prints "<status>US<assignee>US<labels, comma-joined>" for the bead, or fails. US (0x1f), not a
# tab: tab is IFS whitespace, so an empty assignee would collapse and the labels read as one.
read_bead() {
  local shown
  shown="$(bd -C "$root" show "$id" --json)" || return 1
  printf '%s' "$shown" \
    | jq -r '(if type=="array" then .[0] else . end) | "\(.status // "")\u001f\(.assignee // "")\u001f\((.labels // []) | join(","))"'
}

# Pushes the board after a write, or fails the release: exit 1 with WHAT named on stderr.
push_or_fail() {
  if ! bd -C "$root" dolt push >&2; then
    echo "release-bead: $id was $1 for $name, but bd dolt push failed" >&2
    exit 1
  fi
}

# A planning role's assignment (cb-10d.2.1): clear the assignee and leave the status alone.
# `--if-assignee` on `update` reports a lost compare-and-swap as exit 13, so unlike `unclaim`
# there is nothing to re-read. Captured, not bare, so `set -e` cannot turn 13 into exit 1.
# Sets $word to released on success; exits 1 on a refusal.
clear_assignment() {
  local update_status=0
  bd --actor "$name" -C "$root" update "$id" --assignee "" --if-assignee "$name" >&2 || update_status=$?
  if [[ $update_status -eq 0 ]]; then
    push_or_fail released
    word=released
  elif [[ $update_status -ne 13 ]]; then
    echo "release-bead: could not clear $name as the assignee of $id" >&2
    exit 1
  fi
  return 0
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "--worktree" ]]; then
  [[ $# -eq 3 && -n "$2" && -n "$3" ]] || usage
  name="$2"
  id="$3"
  case "$id" in
    */* | .*) usage ;;
  esac
  source "$script_dir/worktree-safety.sh"

  root="$("$script_dir/consumer-root" --shared)"
  root="$(cd "$root" && pwd -P)"
  state="$root/.cerebro/state"
  record="$state/worktrees/$id"
  tree="$root/.cerebro/worktrees/$id"

  # Re-read before every act, not once: `assign-bead` may adopt this tree for another agent (or a
  # new pass of this one) and rewrite the record while a fetch runs here.
  record_owner() {
    local who=""
    if [[ -f "$record" ]]; then
      IFS= read -r who < "$record" || true
    fi
    printf '%s' "$who"
  }
  drop_record_if_mine() {
    if [[ "$(record_owner)" == "$name" ]]; then
      rm -f "$record"
    fi
    return 0
  }
  if [[ "$(record_owner)" != "$name" ]]; then
    echo gone
    exit 0
  fi

  if alive_on_bead; then
    echo running
    exit 0
  fi

  if ! [[ -e "$tree" ]]; then
    git -C "$root" worktree prune >/dev/null 2>&1 || true
    drop_record_if_mine
    echo gone
    exit 0
  fi

  default_branch="$("$script_dir/default-branch" 2>/dev/null)" || default_branch=""
  [[ -n "$default_branch" ]] || default_branch="main"
  merged_check="$("$script_dir/project-conf" merged_check gh 2>/dev/null || echo gh)"
  [[ -n "$merged_check" ]] || merged_check="gh"

  if ! git -C "$root" fetch --quiet origin "$default_branch" 2>/dev/null; then
    echo retry
    exit 0
  fi

  reason="$(cerebro_worktree_keep_reason "$tree" "$default_branch" "$merged_check" "${COLD_TARGET_MINUTES:-1440}")"
  if [[ "$(record_owner)" != "$name" ]]; then
    echo gone
    exit 0
  fi
  if [[ -z "$reason" ]]; then
    if cerebro_worktree_remove "$root" "$tree"; then
      drop_record_if_mine
      echo removed
      exit 0
    fi
    if ! [[ -e "$tree" ]]; then
      # The watcher removed it between the test and the removal.
      drop_record_if_mine
      echo gone
      exit 0
    fi
    reason="git would not remove it"
  fi
  drop_record_if_mine
  echo "release-bead: keeping $id — $reason" >&2
  echo "kept $reason"
  exit 0
fi

if [[ "${1:-}" == "--ended" ]]; then
  [[ $# -eq 3 && -n "$2" && -n "$3" ]] || usage
  name="$2"
  id="$3"
  case "$id" in
    */* | .*) usage ;;
  esac
  source "$script_dir/bead-delivery.sh"
  root="$("$script_dir/consumer-root" --shared)"
  state="$root/.cerebro/state"

  if alive_on_bead; then
    echo running
    exit 0
  fi
  if ! fields="$(read_bead)"; then
    exit 1
  fi
  IFS=$'\x1f' read -r status assignee labels <<<"$fields"

  word=elsewhere
  if [[ "$status" == "open" && "$assignee" == "$name" ]]; then
    clear_assignment
    echo "$word"
    exit 0
  fi
  if [[ "$status" != "in_progress" || "$assignee" != "$name" ]]; then
    echo elsewhere
    exit 0
  fi
  case ",$labels," in
    *,verification:failed,*)
      echo "kept it was reopened by a failed verification"
      exit 0
      ;;
  esac

  default_branch="$("$script_dir/default-branch" 2>/dev/null)" || default_branch=""
  [[ -n "$default_branch" ]] || default_branch="main"
  if ! git -C "$root" fetch --quiet origin "$default_branch" 2>/dev/null; then
    echo retry
    exit 0
  fi
  if ! cerebro_bead_delivered "$root" "$default_branch" "$id"; then
    echo "kept its work is not on main"
    exit 0
  fi
  if ! bd --actor "$name" -C "$root" close "$id" \
       --reason "Delivered; closed by the fleet view, $name did not" >&2; then
    echo "release-bead: could not close $id for $name" >&2
    exit 1
  fi
  push_or_fail closed
  echo closed
  exit 0
fi

[[ $# -eq 2 && -n "$1" && -n "$2" ]] || usage
name="$1"
id="$2"

if "$script_dir/agent-alive" "$name" >/dev/null 2>&1; then
  echo running
  exit 0
fi

root="$("$script_dir/consumer-root" --shared)"
handover="$root/.cerebro/state/$name.handover"


drop_handover() {
  local held=""
  if [[ -f "$handover" ]]; then
    IFS= read -r held < "$handover" || true
  fi
  if [[ "$held" == "$id" ]]; then
    rm -f "$handover"
  fi
  return 0
}

if ! fields="$(read_bead)"; then
  exit 1
fi
IFS=$'\x1f' read -r status assignee _labels <<<"$fields"

word=elsewhere
if [[ "$status" == "in_progress" && "$assignee" == "$name" ]]; then
  if bd --actor "$name" -C "$root" unclaim "$id" --if-assignee "$name" \
       --reason "Given back by the fleet view: $name never ran on it" >&2; then
    push_or_fail released
    word=released
  else
    if ! fields="$(read_bead)"; then
      exit 1
    fi
    IFS=$'\x1f' read -r status assignee _labels <<<"$fields"
    if [[ "$status" == "in_progress" && "$assignee" == "$name" ]]; then
      echo "release-bead: could not unclaim $id from $name" >&2
      exit 1
    fi
  fi
elif [[ "$status" == "open" && "$assignee" == "$name" ]]; then
  clear_assignment
elif [[ "$status" == "open" && -z "$assignee" ]]; then
  word=free
fi

drop_handover
echo "$word"
exit 0
