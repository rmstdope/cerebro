#!/usr/bin/env bash
# A `bd` that records rather than writes, for the cases about `x` - the one command in this crate
# that would otherwise touch the developer's own board.
#
# TRACKED, and deliberately so: a test that writes its own executable and then spawns it races the
# writer on Linux and dies `ETXTBSY`, which is exactly what `readers.rs` says four patches in this
# crate had been working around. What varies per case is DATA, written into the cwd `run_finding`
# already gives the child - `paths.shared_root`, a tempdir of that test's own:
#
#   calls       written here, one line of argv per call
#   exit-code   this status for any call but `dolt push`; absent means 0
#   push-exit   this status for `dolt push`; absent means 0
printf '%s\n' "$*" >> calls
if [[ "$1" == "dolt" ]]; then
  if [[ -f push-exit ]]; then exit "$(cat push-exit)"; fi
  exit 0
fi
if [[ -f exit-code ]]; then exit "$(cat exit-code)"; fi
exit 0
