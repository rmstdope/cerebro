#!/usr/bin/env bash
#
# Answers one question, for the shell, the way cerebro--session-alive-p answers it in elisp:
#
#     .claude/cerebro/scripts/agent-alive <Name>
#
#   exit 0   <Name>'s state file names a pid that is running AND whose command line carries
#            cerebro's own marker sentence - "This session is <Name> of the cerebro fleet rooted at
#            <root>/." - so it is still that session, of this fleet, not a recycled pid or another
#            checkout's agent of the same name
#   exit 1   not alive: no state file, no pid in it, the pid is gone, or the pid is alive but is
#            somebody else's process or belongs to another consumer's fleet
#   exit 2   usage error, or <Name> is not on scripts/roster
#
# WHY THIS EXISTS. A bare `kill -0 "$pid"' asks whether *some* process holds that number. Pids are
# recycled, so a dead agent's state file can name a live pid belonging to an unrelated daemon: in
# elisp that lit a finished session's row green ten hours after it ended, and in the skills it makes
# a dead planner look alive - stranding the very `planning' label the reclaim loop exists to free,
# and inflating the count the planning buffer is sized from. Every session `scripts/launch' starts
# opens its prompt with cerebro's marker sentence, so the name is the identity and the pid alone is
# not. And a name is unique inside one consumer, not on the machine (9420ff2), so the root is the
# third discriminator - both cut from that one sentence (cb-d59.3), so no provider's flag spelling
# is evidence. See cerebro--session-args-p, of which this script is the bash copy. Its cases are
# tests/lib/session-args.cases, which tests/agent-alive.sh and emacs/cerebro-test.el both run - add
# a case there, not in one suite.
#
# A predicate, not a writer, so it is its own script rather than a mode of `scripts/agent-state'
# (which requires --pid and exists to write a file). Nothing is printed in the 0/1 cases: this runs
# once per agent on every planner pass, so output would be noise and the exit status is the whole
# answer.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

name="${1:-}"
if [[ -z "$name" || $# -gt 1 ]]; then
  echo "usage: agent-alive <Name>" >&2
  exit 2
fi

# The name must be on scripts/roster - the one list of the fleet. A typo must not read as "dead":
# that is exit 2, distinct from the 1 a caller treats as "not running".
if ! "$script_dir/roster" --entry "$name" >/dev/null 2>&1; then
  echo "agent-alive: $name is not on the roster" >&2
  exit 2
fi

# The shared checkout every worktree of the repository has in common - never the enclosing tree,
# which from a bead worktree's own submodule copy is the worktree itself, not the main checkout the
# fleet writes state into (ah-e0w). See scripts/consumer-root for the two roots and why they differ.
#
# The launch path's hint first (cb-ue0): `launch' calls this once per session start to refuse a
# duplicate name, and a planner calls it once per label it checks. Validated against this checkout
# before it is believed - see scripts/root-hints.sh - and the fork below is what answers otherwise,
# including its failure, which is still how a standalone clone is refused.
source "$script_dir/root-hints.sh"
# The marker sentence's one bash spelling (cb-9su): the two needles below are cut from it here
# rather than written out again, so this reader and `scripts/launch' cannot disagree about the text.
source "$script_dir/session-marker.sh"
repo_root="$(cerebro_hinted_root "$script_dir/.." shared)" \
  || repo_root="$("$script_dir/consumer-root" --shared)"
state_file="$repo_root/.cerebro/state/$name.state.json"

[[ -f "$state_file" ]] || exit 1

pid="$(jq -r '.pid // empty' "$state_file" 2>/dev/null || true)"
[[ -n "$pid" ]] || exit 1
# A single integer, or nothing. `ps -p' takes a *list*, so a field carrying "1 2" or "1,2" would
# have it print two processes' command lines concatenated and the match below could land on the
# wrong one - the one path by which this could wrongly answer "alive". The elisp side cannot do
# this, since `process-attributes' takes an integer.
[[ "$pid" =~ ^[0-9]+$ ]] || exit 1

# `ps -o args= -p <pid>' is the portable form (BSD and GNU alike); the trailing `=' suppresses the
# header, without which a dead pid still yields a non-empty line and every ended session reads
# alive. Each command is guarded explicitly rather than left to `set -e', so the exit status is by
# design rather than by luck.
args="$(ps -o args= -p "$pid" 2>/dev/null)" || exit 1
[[ -n "$args" ]] || exit 1

# The bash counterpart of cerebro--name-in-args-p. The needle is the opening of cerebro's own
# marker sentence, up to and including the space after "rooted at" - which is what keeps one roster
# name that is a prefix of another (Cyclops / Cyclopsly) from silently reading as alive, the job the
# elisp `\_>' word boundary used to do on `--name'. Quoted inside the pattern, so a `*?[' in a name
# is literal - and quoted the same way now that the text comes from the library, since a `case'
# pattern expands globs in an unquoted expansion just as it does in a literal.
name_needle="$(cerebro_marker_name_needle "$name")"
case "$args" in
  *"$name_needle"*) ;;
  *) exit 1 ;;
esac

# The third discriminator, the same one cerebro--session-args-p asks for in elisp (cb-lzi): the
# session must belong to THIS consumer's fleet. A recycled pid can land on a same-named session of
# another checkout - every consumer on the built-in roster has a Cyclops - and pid plus name alone
# would call that one ours, which here would let a planner free a label somebody holds.
#
# This used to extract the `--settings' value specifically, then any path under the consumer
# (ah-ybsr). Since cb-d59.3 it is the second half of the marker sentence: `scripts/launch' opens
# every session's prompt with it, and the prompt is the one argv slot every agent CLI accepts, so
# neither half of this rule contains a provider's spelling any more. `$repo_root' is already
# `consumer-root --shared', a `pwd -P' result, and `scripts/launch' embeds that identical physical
# string, so no further resolution step is needed. The trailing `/' is what makes it a whole path
# component, so a sibling checkout whose path merely starts with this one's (`{root}-hud') does not
# match - `cerebro_marker_root_needle' is where that slash is appended (cb-9su).
root_needle="$(cerebro_marker_root_needle "$repo_root")"
case "$args" in
  *"$root_needle"*) ;;
  *) exit 1 ;;
esac

exit 0
