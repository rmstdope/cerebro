#!/usr/bin/env bash
#
# Give a producer's claimed bead to whoever must decide what the producer may not:
#
#     .cerebro/cerebro/scripts/producer-park <Name> <id> <ux|scope> <reason>
#
# A producer designs an unplanned `ux:agreed` bead itself, so this is never for a
# missing build plan. `ux` sends the bead straight back to the UX stage (cb-2cj4):
# the agreed experience is missing something only a designer may decide. `scope`
# parks it in the navigator's `human` queue: the work itself is in question.

set -euo pipefail

usage() {
  echo "usage: producer-park <Name> <id> <ux|scope> <reason>" >&2
  exit 2
}

[[ $# -eq 4 && -n "$1" && -n "$2" && -n "$4" ]] || usage
name="$1"
id="$2"
decision="$3"
reason="$4"

case "$decision" in
  ux|scope) ;;
  *) usage ;;
esac

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$("$script_dir/consumer-root" --shared)"

if ! shown="$(bd -C "$root" show "$id" --json)"; then
  exit 1
fi
if ! fields="$(printf '%s' "$shown" \
    | jq -r '(if type == "array" then .[0] else . end) | "\(.status // "")\t\(.assignee // "")"')"; then
  echo "producer-park: bd show $id did not print JSON this script can read" >&2
  exit 1
fi
IFS=$'\t' read -r status assignee <<<"$fields"
if [[ "$status" != "in_progress" || "$assignee" != "$name" ]]; then
  echo "producer-park: $id is not in progress for $name" >&2
  exit 1
fi
if ! printf '%s' "$shown" \
  | jq -e '(if type == "array" then .[0] else . end)
           | ((.labels // [] | index("ux:agreed")) != null) or ((.labels // [] | index("ux:none")) != null)' \
  >/dev/null; then
  echo "producer-park: $id is not producer work (neither ux:agreed nor ux:none)" >&2
  exit 1
fi

if [[ "$decision" == "ux" ]]; then
  # A UX question is the designer's. The agreed label comes off so `stage-candidates ux` offers
  # the bead again and `assignable-beads` stops offering it; the note's heading is what
  # `agree-experience` reads a returned piece of work by; nothing is parked for a person.
  # `ux:none` comes off too: a producer may add the UX stop the navigator skipped at filing, never
  # the other way round (cb-uump).
  bd --actor "$name" -C "$root" update "$id" \
    --remove-label ux:agreed \
    --remove-label ux:none \
    --remove-label planned \
    --add-label needs-ui-decision \
    --append-notes "## Sent back to the UX stage

$reason" \
    --if-assignee "$name" \
    --if-status in_progress
else
  # A scope question is the navigator's: parked in their one queue, with the pause dated.
  paused_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  note="Producer parking for a scope decision: $reason"
  bd --actor "$name" -C "$root" update "$id" \
    --remove-label planned \
    --add-label human \
    --add-label needs-ui-decision \
    --append-notes "$note" \
    --set-metadata "paused_at=$paused_at" \
    --if-assignee "$name" \
    --if-status in_progress
fi
bd --actor "$name" -C "$root" unclaim "$id" --if-assignee "$name"
bd -C "$root" dolt push
